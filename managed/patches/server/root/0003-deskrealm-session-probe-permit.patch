+        message.extend_from_slice(&proof);
+        message.extend_from_slice(&data);
+        let signature = sign::sign_detached(&message, &self.key);
+        let mut reply = Vec::from(data);
+        reply.extend_from_slice(&signature.to_bytes());
+        stream.write_all(&reply).await?;
+        Ok(())
+    }
