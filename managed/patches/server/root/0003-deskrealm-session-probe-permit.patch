+impl RegionalRelay {
+    async fn probe(&self, mut stream: TcpStream) -> ResultType<()> {
+        let mut prefix = [0; PREFIX.len()];
+        stream.read_exact(&mut prefix).await?;
+        let (purpose, proof) = match prefix.as_slice() {
+            PREFIX => {
+                let mut challenge = [0; 32];
+                stream.read_exact(&mut challenge).await?;
+                (PREFIX, challenge.to_vec())
+            }
+            SESSION_PROBE_PREFIX => (SESSION_PROBE_PREFIX, self.authorize_probe(&mut stream).await?),
+            _ => return Ok(()),
+        };
