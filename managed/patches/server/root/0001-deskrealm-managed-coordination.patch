+impl ManagedRelay {
+    async fn pair(
+        &self,
+        mut stream: FramedStream,
+    ) -> ResultType<Option<(FramedStream, FramedStream)>> {
+        let request = managed::read_managed(&mut stream).await?;
+        let Some(route) = request.route.into_option() else {
+            bail!("managed relay route missing")
+        };
+        let offer: [u8; 32] = request.offer_nonce.as_ref().try_into()?;
+        if offer == EMPTY_OFFER {
+            bail!("managed relay offer missing");
+        }
+        let role = match request.operation {
+            Some(Operation::RelayJoin(1)) => PeerRole::Controller,
+            Some(Operation::RelayJoin(2)) => PeerRole::Target,
+            _ => bail!("invalid managed relay role"),
+        };
+        let _ = self
+            .service
+            .authenticate(
+                &mut stream,
+                &route,
+                TransportPurpose::RelayJoin,
+                role,
+                &offer,
+            )
+            .await?;
+        let key = managed::route_key(&route)?;
+        let id = managed::nonce();
+        let (sender, receiver) = oneshot::channel();
+        {
+            let mut waiting = self.waiting.lock().await;
+            if let Some(peer) = waiting.get(&key) {
+                if peer.role == role
+                    || peer.offer != offer
+                    || !managed::same_route(&peer.route, &route)
+                {
+                    bail!("managed relay peer does not match");
+                }
+                let peer = waiting.remove(&key).expect("checked relay peer");
+                if peer.second.send(stream).is_err() {
+                    bail!("managed relay peer disconnected");
+                }
+                return Ok(None);
+            }
+            if waiting.len() >= 64 {
+                bail!("managed relay is busy");
+            }
+            waiting.insert(
+                key,
+                PendingManagedPeer {
+                    route: route.clone(),
+                    offer,
+                    role,
+                    id,
+                    second: sender,
+                },
+            );
+        }
+        let peer = tokio::select! {
+            received = tokio::time::timeout(OFFER_TIMEOUT, receiver) => received.ok().and_then(Result::ok),
+            _ = stream.next() => None,
+        };
+        {
+            let mut waiting = self.waiting.lock().await;
+            if waiting.get(&key).map(|entry| entry.id) == Some(id) {
+                waiting.remove(&key);
+            }
+        }
+        let Some(mut peer) = peer else {
+            bail!("managed relay peer unavailable")
+        };
+        self.service.authorize(&route, ManagedPath::Relay).await?;
+        let ready = managed::signal(route, offer, Operation::RelayReady(true));
+        managed::write(&mut stream, ready.clone()).await?;
+        managed::write(&mut peer, ready).await?;
+        stream.set_raw();
+        peer.set_raw();
+        Ok(Some((stream, peer)))
+    }
+}
