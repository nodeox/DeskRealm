@@ -0,0 +1,349 @@
+use hbb_common::{
+    bail,
+    base64::{engine::general_purpose::URL_SAFE_NO_PAD, Engine as _},
+    bytes::Bytes,
+    deskrealm_protocol::{valid_rustdesk_id, Path, PeerRole, TransportPurpose, VerifiedGrant},
+    protobuf::{Message, MessageField},
+    rendezvous_proto::{
+        desk_realm_signal::Operation, rendezvous_message, DeskRealmRoute, DeskRealmSignal,
+        RendezvousMessage,
+    },
+    tcp::FramedStream,
+    tokio::{sync::Semaphore, time::timeout},
+    ResultType,
+};
+use sodiumoxide::{crypto::sign, randombytes::randombytes_into};
+use std::{
+    env,
+    net::SocketAddr,
+    time::{Duration, SystemTime, UNIX_EPOCH},
+};
+use uuid::Uuid;
+
+const NETWORK_TIMEOUT: Duration = Duration::from_secs(5);
+pub(crate) const OFFER_TIMEOUT: Duration = Duration::from_secs(20);
+const MAX_SIGNAL_BYTES: usize = 4096;
+pub(crate) const EMPTY_OFFER: [u8; 32] = [0; 32];
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Service {
+    Rendezvous,
+    Relay,
+}
+
+pub(crate) struct ManagedTransport {
+    pub(crate) relay_id: String,
+    pub(crate) relay_address: String,
+    pub(crate) slots: Semaphore,
+    center: reqwest::Url,
+    client: reqwest::Client,
+    bearer: String,
+    kid: String,
+    center_key: sign::PublicKey,
+    service: Service,
+}
+
+fn setting(name: &str) -> ResultType<String> {
+    match env::var(name) {
+        Ok(value) => Ok(value),
+        Err(env::VarError::NotPresent) => Ok(String::new()),
+        Err(_) => bail!("invalid managed configuration for {}", name),
+    }
+}
+
+fn identifier(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 32
+        && value.bytes().enumerate().all(|(i, b)| {
+            b.is_ascii_lowercase() || b.is_ascii_digit() || (i > 0 && matches!(b, b'-' | b'_'))
+        })
+}
+
+impl ManagedTransport {
+    pub(crate) fn from_env(service: Service) -> ResultType<Option<Self>> {
+        let mode = setting("DESKREALM_MANAGED_MODE")?;
+        let center = setting("DESKREALM_MANAGED_CENTER")?;
+        let kid = setting("DESKREALM_MANAGED_CENTER_KID")?;
+        let key = setting("DESKREALM_MANAGED_CENTER_PUBLIC_KEY")?;
+        let relay_id = setting("DESKREALM_MANAGED_RELAY_ID")?;
+        let relay_address = setting("DESKREALM_MANAGED_RELAY_ADDRESS")?;
+        let ca_file = setting("DESKREALM_MANAGED_CA_FILE")?;
+        let (token_name, prefix) = match service {
+            Service::Rendezvous => ("DESKREALM_MANAGED_RENDEZVOUS_TOKEN", "drr_"),
+            Service::Relay => ("DESKREALM_MANAGED_RELAY_TOKEN", "drl_"),
+        };
+        let token = setting(token_name)?;
+        if mode.is_empty()
+            && [
+                &center,
+                &kid,
+                &key,
+                &relay_id,
+                &relay_address,
+                &token,
+                &ca_file,
+            ]
+            .iter()
+            .all(|v| v.is_empty())
+        {
+            return Ok(None);
+        }
+        if mode != "1" || !identifier(&kid) || decode_32(&token).is_none() {
+            bail!("invalid or incomplete DeskRealm managed transport configuration");
+        }
+        match service {
+            Service::Rendezvous if relay_id.is_empty() && relay_address.is_empty() => {}
+            Service::Rendezvous if identifier(&relay_id) && socket_authority(&relay_address) => {}
+            Service::Relay if identifier(&relay_id) && relay_address.is_empty() => {}
+            _ => bail!("invalid DeskRealm managed relay configuration"),
+        }
+        let center = reqwest::Url::parse(&center)
+            .map_err(|_| hbb_common::anyhow::anyhow!("invalid managed center origin"))?;
+        if center.scheme() != "https"
+            || center.host().is_none()
+            || center.path() != "/"
+            || !center.username().is_empty()
+            || center.password().is_some()
+            || center.query().is_some()
+            || center.fragment().is_some()
+        {
+            bail!("managed center must be an HTTPS origin");
+        }
+        let Some(center_key) = decode_32(&key).map(sign::PublicKey) else {
+            bail!("invalid DeskRealm managed center public key");
+        };
+        sodiumoxide::init()
+            .map_err(|_| hbb_common::anyhow::anyhow!("cannot initialize managed cryptography"))?;
+        let mut client = reqwest::Client::builder()
+            .no_proxy()
+            .redirect(reqwest::redirect::Policy::none())
+            .timeout(NETWORK_TIMEOUT);
+        if !ca_file.is_empty() {
+            let pem = std::fs::read(ca_file)
+                .map_err(|_| hbb_common::anyhow::anyhow!("cannot read managed center CA"))?;
+            let ca = reqwest::Certificate::from_pem(&pem)
+                .map_err(|_| hbb_common::anyhow::anyhow!("invalid managed center CA"))?;
+            client = client.add_root_certificate(ca);
+        }
+        Ok(Some(Self {
+            relay_id,
+            relay_address,
+            slots: Semaphore::new(128),
+            center,
+            client: client.build()?,
+            bearer: format!("{prefix}{token}"),
+            kid,
+            center_key,
+            service,
+        }))
+    }
+
+    fn verify<'a>(&self, route: &'a DeskRealmRoute) -> ResultType<VerifiedGrant<'a>> {
+        if !valid_rustdesk_id(&route.target_rustdesk_id) || route.connection_uuid.len() != 16 {
+            bail!("invalid managed route");
+        }
+        let now = SystemTime::now().duration_since(UNIX_EPOCH)?.as_millis() as u64;
+        VerifiedGrant::verify(
+            &route.grant_frame,
+            &route.grant_signature,
+            &self.kid,
+            &self.center_key,
+            now,
+        )
+        .ok_or_else(|| hbb_common::anyhow::anyhow!("invalid or expired managed grant"))
+    }
+
+    pub(crate) fn check_target_registration(
+        &self,
+        route: &DeskRealmRoute,
+        public_key: &[u8],
+    ) -> ResultType<()> {
+        let grant = self.verify(route)?;
+        if !sign::PublicKey::from_slice(public_key)
+            .is_some_and(|key| grant.matches_device_key(PeerRole::Target, &key))
+        {
+            bail!("managed target registration does not match the grant");
+        }
+        Ok(())
+    }
+
+    pub(crate) async fn authenticate(
+        &self,
+        stream: &mut FramedStream,
+        route: &DeskRealmRoute,
+        purpose: TransportPurpose,
+        role: PeerRole,
+        offer: &[u8; 32],
+    ) -> ResultType<sign::PublicKey> {
+        let grant = self.verify(route)?;
+        let connection: &[u8; 16] = route.connection_uuid.as_ref().try_into()?;
+        let challenge = nonce();
+        write(
+            stream,
+            DeskRealmSignal {
+                operation: Some(Operation::TransportChallenge(Bytes::copy_from_slice(
+                    &challenge,
+                ))),
+                ..Default::default()
+            },
+        )
+        .await?;
+        let proof = match read_managed(stream).await? {
+            DeskRealmSignal {
+                route,
+                offer_nonce,
+                operation: Some(Operation::TransportProof(proof)),
+                ..
+            } if route.is_none() && offer_nonce.is_empty() => proof,
+            _ => bail!("invalid managed transport proof"),
+        };
+        let (Some(key), Ok(signature)) = (
+            sign::PublicKey::from_slice(&proof.public_key),
+            sign::Signature::from_bytes(&proof.signature),
+        ) else {
+            bail!("invalid managed transport proof");
+        };
+        let frame = grant.transport_proof_frame(
+            purpose,
+            role,
+            connection,
+            &route.target_rustdesk_id,
+            &challenge,
+            offer,
+        );
+        if !grant.matches_device_key(role, &key) || !sign::verify_detached(&signature, &frame, &key)
+        {
+            bail!("invalid managed transport proof");
+        }
+        self.verify(route)?;
+        Ok(key)
+    }
+
+    pub(crate) async fn authorize(&self, route: &DeskRealmRoute, path: Path) -> ResultType<()> {
+        let grant = self.verify(route)?;
+        let endpoint = match self.service {
+            Service::Rendezvous => "/v1/internal/managed/rendezvous/authorize",
+            Service::Relay => "/v1/internal/managed/relay/paired",
+        };
+        let (path, relay_id) = match path {
+            Path::Direct => ("direct", ""),
+            Path::Relay if !self.relay_id.is_empty() => ("relay", &self.relay_id[..]),
+            Path::Relay => bail!("managed relay is not configured"),
+        };
+        let response = self.client.post(self.center.join(endpoint)?)
+            .bearer_auth(&self.bearer)
+            .json(&serde_json::json!({
+                "session_id": Uuid::from_slice(grant.session_id())?.to_string(),
+                "grant_id": Uuid::from_slice(grant.grant_id())?.to_string(),
+                "grant_signature": URL_SAFE_NO_PAD.encode(&route.grant_signature),
+                "controller_device_id": Uuid::from_slice(grant.device_id(PeerRole::Controller))?.to_string(),
+                "target_device_id": Uuid::from_slice(grant.device_id(PeerRole::Target))?.to_string(),
+                "target_rustdesk_id": &route.target_rustdesk_id,
+                "connection_id": Uuid::from_slice(&route.connection_uuid)?.to_string(),
+                "path": path,
+                "relay_id": relay_id,
+            }))
+            .send().await.map_err(|_| hbb_common::anyhow::anyhow!("managed center is unavailable"))?;
+        if response.status() != reqwest::StatusCode::NO_CONTENT {
+            bail!("managed center denied route");
+        }
+        self.verify(route)?;
+        Ok(())
+    }
+}
+
+fn socket_authority(value: &str) -> bool {
+    if let Ok(addr) = value.parse::<SocketAddr>() {
+        return addr.port() != 0 && !addr.ip().is_unspecified();
+    }
+    let Some((name, port)) = value.rsplit_once(':') else {
+        return false;
+    };
+    !name.is_empty()
+        && name.len() <= 253
+        && name.split('.').all(|label| {
+            !label.is_empty()
+                && label.len() <= 63
+                && label
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b == b'-')
+                && !label.starts_with('-')
+                && !label.ends_with('-')
+        })
+        && port.parse::<u16>().map_or(false, |p| p != 0)
+}
+
+fn decode_32(text: &str) -> Option<[u8; 32]> {
+    URL_SAFE_NO_PAD.decode(text).ok()?.try_into().ok()
+}
+
+pub(crate) fn nonce() -> [u8; 32] {
+    let mut value = [0; 32];
+    randombytes_into(&mut value);
+    value
+}
+
+pub(crate) type RouteKey = ([u8; 32], Uuid);
+
+pub(crate) fn route_key(route: &DeskRealmRoute) -> ResultType<RouteKey> {
+    // The full route stored against this key is checked again before use.
+    let connection = Uuid::from_slice(&route.connection_uuid)?;
+    // This stable key does not depend on untrusted protobuf field order.
+    let hash = sodiumoxide::crypto::hash::sha256::hash(&route.grant_signature);
+    Ok((hash.0, connection))
+}
+
+pub(crate) fn same_route(a: &DeskRealmRoute, b: &DeskRealmRoute) -> bool {
+    a.grant_frame == b.grant_frame
+        && a.grant_signature == b.grant_signature
+        && a.connection_uuid == b.connection_uuid
+        && a.target_rustdesk_id == b.target_rustdesk_id
+}
+
+pub(crate) fn signal(
+    route: DeskRealmRoute,
+    offer: [u8; 32],
+    operation: Operation,
+) -> DeskRealmSignal {
+    DeskRealmSignal {
+        route: MessageField::some(route),
+        offer_nonce: if offer == EMPTY_OFFER {
+            Bytes::new()
+        } else {
+            Bytes::copy_from_slice(&offer)
+        },
+        operation: Some(operation),
+        ..Default::default()
+    }
+}
+
+pub(crate) fn wrap(signal: DeskRealmSignal) -> RendezvousMessage {
+    let mut message = RendezvousMessage::new();
+    message.set_deskrealm_signal(signal);
+    message
+}
+
+pub(crate) fn stream(stream: hbb_common::tokio::net::TcpStream, addr: SocketAddr) -> FramedStream {
+    let mut stream = FramedStream::from(stream, addr);
+    stream.codec_mut().set_max_packet_length(MAX_SIGNAL_BYTES);
+    stream
+}
+
+pub(crate) async fn read(stream: &mut FramedStream) -> ResultType<RendezvousMessage> {
+    let Some(bytes) = timeout(NETWORK_TIMEOUT, stream.next()).await? else {
+        bail!("managed connection closed");
+    };
+    Ok(RendezvousMessage::parse_from_bytes(&bytes?)?)
+}
+
+pub(crate) async fn read_managed(stream: &mut FramedStream) -> ResultType<DeskRealmSignal> {
+    match read(stream).await?.union {
+        Some(rendezvous_message::Union::DeskrealmSignal(signal)) => Ok(signal),
+        _ => bail!("managed transport message required"),
+    }
+}
+
+pub(crate) async fn write(stream: &mut FramedStream, signal: DeskRealmSignal) -> ResultType<()> {
+    timeout(NETWORK_TIMEOUT, stream.send(&wrap(signal))).await??;
+    Ok(())
+}
