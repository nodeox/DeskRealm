 }
+
+#[cfg(test)]
+mod managed_tests {
+    use super::*;
+    use tokio::{io::copy_bidirectional, net::TcpListener, time::{timeout, Duration}};
+
+    async fn connected_pair(forwarded: bool) -> (Stream, Stream) {
+        let target = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let destination = target.local_addr().unwrap();
+        let address = if forwarded {
+            let forwarder = TcpListener::bind("127.0.0.1:0").await.unwrap();
+            let forward_address = forwarder.local_addr().unwrap();
+            tokio::spawn(async move {
+                let (mut left, _) = forwarder.accept().await.unwrap();
+                let mut right = TcpStream::connect(destination).await.unwrap();
+                let _ = copy_bidirectional(&mut left, &mut right).await;
+            });
+            forward_address
+        } else {
+            destination
+        };
+        let (left, right) = tokio::join!(TcpStream::connect(address), target.accept());
+        let left = left.unwrap();
+        let (right, _) = right.unwrap();
+        let left_addr = left.local_addr().unwrap();
+        let right_addr = right.local_addr().unwrap();
+        (
+            Stream::Tcp(tcp::FramedStream::from(left, left_addr)),
+            Stream::Tcp(tcp::FramedStream::from(right, right_addr)),
+        )
+    }
+
+    #[tokio::test]
+    async fn managed_channel_binding_direct_and_forwarded() {
+        sodiumoxide::init().unwrap();
+        timeout(Duration::from_secs(5), async {
+            for forwarded in [false, true] {
+                let (mut controller, mut target) = connected_pair(forwarded).await;
+                assert!(controller.managed_channel_binding().is_none());
+                let transcript = tcp::KxTranscript {
+                    initiator_pk: &[1; 32],
+                    responder_pk: &[2; 32],
+                    advertised: 1,
+                    picked: 1,
+                };
+                let key = Key([3; 32]);
+                controller.set_negotiated_key(key.clone(), true, &transcript).unwrap();
+                target.set_negotiated_key(key.clone(), false, &transcript).unwrap();
+                let binding = controller.managed_channel_binding().unwrap();
+                assert!(target.managed_channel_binding() == Some(binding));
+                controller.send_raw(b"controller".to_vec()).await.unwrap();
+                assert_eq!(&target.next().await.unwrap().unwrap()[..], b"controller");
+                target.send_raw(b"target".to_vec()).await.unwrap();
+                assert_eq!(&controller.next().await.unwrap().unwrap()[..], b"target");
+                controller.set_raw();
+                assert!(controller.managed_channel_binding().is_none());
+                target.set_key(key);
+                assert!(target.managed_channel_binding().is_none());
+            }
+        }).await.unwrap();
+    }
+}
