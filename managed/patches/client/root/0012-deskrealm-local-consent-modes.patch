new file mode 100644
index 0000000..57bd7fb
--- /dev/null
+++ b/src/deskrealm_desktop/consent.rs
@@ -0,0 +1,79 @@
+use super::{AUDIO, CLIPBOARD, FILES, INPUT, VIEW};
+
+pub(super) fn select_permissions(
+    requested: u8,
+    required: u8,
+    mut ask: impl FnMut(&str, bool) -> Option<bool>,
+) -> Option<u8> {
+    const OPERATIONS: [(u8, &str); 5] = [
+        (VIEW, "查看画面"),
+        (INPUT, "键鼠控制"),
+        (AUDIO, "音频"),
+        (CLIPBOARD, "剪贴板"),
+        (FILES, "文件传输"),
+    ];
+    if requested == 0
+        || requested & !(VIEW | INPUT | AUDIO | CLIPBOARD | FILES) != 0
+        || required == 0
+        || required & !requested != 0
+    {
+        return None;
+    }
+    let mut selected = 0;
+    for (bit, label) in OPERATIONS {
+        if requested & bit == 0 {
+            continue;
+        }
+        let mandatory = required & bit != 0;
+        if ask(label, mandatory)? {
+            selected |= bit;
+        } else if mandatory {
+            return None;
+        }
+    }
+    Some(selected)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn managed_local_consent_preserves_only_selected_actions() {
+        let mut visits = Vec::new();
+        let selected = select_permissions(VIEW | INPUT | CLIPBOARD, VIEW, |operation, mandatory| {
+            visits.push((operation.to_owned(), mandatory));
+            Some(operation != "键鼠控制")
+        });
+        assert_eq!(selected, Some(VIEW | CLIPBOARD));
+        assert_eq!(
+            visits,
+            [
+                ("查看画面".to_owned(), true),
+                ("键鼠控制".to_owned(), false),
+                ("剪贴板".to_owned(), false),
+            ]
+        );
+    }
+
+    #[test]
+    fn managed_local_consent_cancels_partial_approval() {
+        assert_eq!(
+            select_permissions(VIEW | INPUT, VIEW, |_, mandatory| mandatory.then_some(true)),
+            None
+        );
+        for base in [VIEW, FILES] {
+            assert_eq!(select_permissions(base, base, |_, _| Some(false)), None);
+        }
+    }
+
+    #[test]
+    fn managed_local_consent_rejects_invalid_permission_masks() {
+        for (requested, required) in [(0, VIEW), (VIEW, 0), (INPUT, VIEW), (VIEW | 32, VIEW)] {
+            assert_eq!(
+                select_permissions(requested, required, |_, _| panic!("invalid prompt")),
+                None
+            );
+        }
+    }
+}
