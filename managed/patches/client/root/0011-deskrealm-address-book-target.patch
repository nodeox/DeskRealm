+/// A managed grant resolves a device ID or a specific authorized book entry.
+#[derive(Clone, Copy)]
+pub enum SessionTarget<'a> {
+    RustDeskId(&'a str),
+    AddressBook { book: Uuid, entry: Uuid },
+}
+
+impl<'a> SessionTarget<'a> {
+    pub fn parse(value: &'a str) -> ResultType<Self> {
+        if valid_rustdesk_id(value) {
+            return Ok(Self::RustDeskId(value));
+        }
+        let (book, entry) = value
+            .strip_prefix("drbook-")
+            .and_then(|value| value.split_once('-'))
+            .ok_or_else(|| anyhow!("invalid managed connection target"))?;
+        let parse_uuid = |value: &str| -> ResultType<Uuid> {
+            let id = Uuid::parse_str(value)?;
+            if id.is_nil() || id.simple().to_string() != value {
+                bail!("invalid managed address book reference");
+            }
+            Ok(id)
+        };
+        Ok(Self::AddressBook {
+            book: parse_uuid(book)?,
+            entry: parse_uuid(entry)?,
+        })
+    }
+}
+
