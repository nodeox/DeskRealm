diff --git a/libs/base/src/deskrealm_endpoint/account.rs b/libs/base/src/deskrealm_endpoint/account.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2a33386dd393c691355af18af5717bf4779f366c
--- /dev/null
+++ b/libs/base/src/deskrealm_endpoint/account.rs
@@ -0,0 +1,393 @@
+use super::{
+    check_credential, encode, now_ms, uuid_bytes, Authority, DeviceCredential, DeviceIdentity,
+    URL_SAFE_NO_PAD,
+};
+use hbb_common::{
+    anyhow::{anyhow, bail},
+    base64::Engine as _,
+    chrono::{DateTime, Utc},
+    deskrealm_protocol::USER_BINDING,
+    sodiumoxide::crypto::hash::sha256,
+    uuid::Uuid,
+    ResultType,
+};
+use reqwest::{
+    header::{COOKIE, ORIGIN, SET_COOKIE},
+    Response, StatusCode,
+};
+use serde_derive::Deserialize;
+use serde_json::{json, Value};
+use std::time::Duration;
+use tokio::time::Instant;
+
+const SESSION_COOKIE: &str = "__Host-deskrealm";
+const TOTP_COOKIE: &str = "__Host-deskrealm-totp";
+
+pub struct PendingTOTP(String);
+
+pub enum ControllerLogin {
+    SignedIn(ControllerSession),
+    NeedsTOTP(PendingTOTP),
+}
+
+pub struct ControllerSession {
+    cookie: String,
+    csrf: String,
+    user: Uuid,
+    username: String,
+}
+
+pub struct ControllerCredential {
+    value: String,
+    deadline: Instant,
+}
+
+impl ControllerSession {
+    pub fn username(&self) -> &str {
+        &self.username
+    }
+}
+
+impl ControllerCredential {
+    pub fn bearer(&self) -> &str {
+        &self.value
+    }
+
+    pub fn needs_refresh(&self) -> bool {
+        Instant::now() + Duration::from_secs(60) >= self.deadline
+    }
+}
+
+#[derive(Deserialize)]
+struct Principal {
+    user_id: String,
+    username: String,
+    csrf_token: String,
+}
+
+#[derive(Deserialize)]
+struct BindingChallenge {
+    organization_id: String,
+    device_id: String,
+    user_id: String,
+    challenge_id: String,
+    nonce: String,
+    flow: String,
+    key_epoch: u64,
+    expires_ms: u64,
+    protocol_version: u16,
+}
+
+impl Authority {
+    pub async fn controller_login(
+        &self,
+        username: &str,
+        password: &str,
+    ) -> ResultType<ControllerLogin> {
+        let body = Self::read_response(
+            self.client
+                .get(self.center.join("/v1/managed/signing-key")?),
+            &[200],
+        )
+        .await?;
+        let identity: Value = serde_json::from_slice(&body)?;
+        let key = URL_SAFE_NO_PAD.encode(self.center_key.0);
+        if identity["kid"].as_str() != Some(self.kid.as_str())
+            || identity["public_key"].as_str() != Some(key.as_str())
+        {
+            bail!("中心签名身份与安装配置不符");
+        }
+        let response = self
+            .account_post(
+                "/v1/auth/login",
+                None,
+                None,
+                json!({"username": username, "password": password}),
+            )
+            .await?;
+        match response.status() {
+            StatusCode::NO_CONTENT => Ok(ControllerLogin::SignedIn(
+                self.controller_session(read_cookie(&response, SESSION_COOKIE)?)
+                    .await?,
+            )),
+            StatusCode::ACCEPTED => Ok(ControllerLogin::NeedsTOTP(PendingTOTP(read_cookie(
+                &response,
+                TOTP_COOKIE,
+            )?))),
+            StatusCode::UNAUTHORIZED => bail!("用户名或密码不正确，或账号已停用"),
+            StatusCode::TOO_MANY_REQUESTS => bail!("登录请求过多，请稍后重试"),
+            status => bail!("端域中心登录失败（HTTP {}）", status.as_u16()),
+        }
+    }
+
+    pub async fn controller_totp(
+        &self,
+        pending: &PendingTOTP,
+        code: &str,
+    ) -> ResultType<ControllerSession> {
+        let response = self
+            .account_post(
+                "/v1/auth/totp/verify",
+                Some((TOTP_COOKIE, &pending.0)),
+                None,
+                json!({"code": code}),
+            )
+            .await?;
+        match response.status() {
+            StatusCode::NO_CONTENT => {
+                self.controller_session(read_cookie(&response, SESSION_COOKIE)?)
+                    .await
+            }
+            StatusCode::UNAUTHORIZED => bail!("验证码不正确或已过期，请重试或重新登录"),
+            status => bail!("端域中心验证失败（HTTP {}）", status.as_u16()),
+        }
+    }
+
+    async fn controller_session(&self, cookie: String) -> ResultType<ControllerSession> {
+        let body = Self::read_response(
+            self.client
+                .get(self.center.join("/v1/auth/session")?)
+                .header(COOKIE, format!("{}={}", SESSION_COOKIE, cookie)),
+            &[200],
+        )
+        .await?;
+        let principal: Principal = serde_json::from_slice(&body)?;
+        check_credential(&principal.csrf_token, "")?;
+        Ok(ControllerSession {
+            cookie,
+            csrf: principal.csrf_token,
+            user: uuid_bytes(&principal.user_id)?,
+            username: principal.username,
+        })
+    }
+
+    pub async fn bind_controller(
+        &self,
+        session: &ControllerSession,
+        device: &DeviceIdentity,
+        organization: Uuid,
+        credential: &DeviceCredential,
+    ) -> ResultType<ControllerCredential> {
+        let response = self
+            .account_post(
+                "/v1/managed/users/challenge",
+                Some((SESSION_COOKIE, &session.cookie)),
+                Some(&session.csrf),
+                json!({"device_id": device.id.to_string(), "device_credential": credential.bearer()}),
+            )
+            .await?;
+        if response.status() != StatusCode::OK {
+            bail!("端域中心拒绝设备绑定，请检查账号登录和设备审批状态");
+        }
+        let body = Self::read_response_body(response, super::MAX_HTTP_BODY).await?;
+        let challenge: BindingChallenge = serde_json::from_slice(&body)?;
+        let proof = challenge.proof(session, device, organization, credential.key_epoch)?;
+        let started = Instant::now();
+        let response = self
+            .account_post(
+                "/v1/managed/users/complete",
+                Some((SESSION_COOKIE, &session.cookie)),
+                Some(&session.csrf),
+                json!({
+                    "device_id": device.id.to_string(),
+                    "challenge_id": challenge.challenge_id,
+                    "signature": URL_SAFE_NO_PAD.encode(device.sign(&proof)),
+                }),
+            )
+            .await?;
+        if response.status() != StatusCode::CREATED {
+            bail!("端域中心未签发主控凭据，请重新登录");
+        }
+        let body = Self::read_response_body(response, super::MAX_HTTP_BODY).await?;
+        #[derive(Deserialize)]
+        struct Credential {
+            credential: String,
+            expires_at: String,
+        }
+        let credential: Credential = serde_json::from_slice(&body)?;
+        check_credential(&credential.credential, "dru_")?;
+        let expires = DateTime::parse_from_rfc3339(&credential.expires_at)?;
+        let lifetime = expires.signed_duration_since(Utc::now()).to_std()?;
+        let deadline = started + lifetime.min(Duration::from_secs(15 * 60));
+        if deadline <= Instant::now() {
+            bail!("端域主控凭据已过期");
+        }
+        Ok(ControllerCredential {
+            value: credential.credential,
+            deadline,
+        })
+    }
+
+    pub async fn controller_logout(&self, session: &ControllerSession) -> ResultType<()> {
+        let response = self
+            .account_post(
+                "/v1/auth/logout",
+                Some((SESSION_COOKIE, &session.cookie)),
+                Some(&session.csrf),
+                json!({}),
+            )
+            .await?;
+        if !matches!(
+            response.status(),
+            StatusCode::NO_CONTENT | StatusCode::UNAUTHORIZED
+        ) {
+            bail!("本机已退出登录，中心尚未确认退出");
+        }
+        Ok(())
+    }
+
+    pub async fn controller_session_active(&self, session: &ControllerSession) -> ResultType<bool> {
+        let response = self
+            .client
+            .get(self.center.join("/v1/auth/session")?)
+            .header(COOKIE, format!("{}={}", SESSION_COOKIE, session.cookie))
+            .send()
+            .await
+            .map_err(|_| anyhow!("无法连接端域中心"))?;
+        match response.status() {
+            StatusCode::OK => Ok(true),
+            StatusCode::UNAUTHORIZED => Ok(false),
+            status => bail!("无法确认端域账号状态（HTTP {}）", status.as_u16()),
+        }
+    }
+
+    async fn account_post(
+        &self,
+        path: &str,
+        cookie: Option<(&str, &str)>,
+        csrf: Option<&str>,
+        body: Value,
+    ) -> ResultType<Response> {
+        let mut request = self
+            .client
+            .post(self.center.join(path)?)
+            .header(ORIGIN, self.center.origin().ascii_serialization())
+            .json(&body);
+        if let Some((name, value)) = cookie {
+            request = request.header(COOKIE, format!("{}={}", name, value));
+        }
+        if let Some(value) = csrf {
+            request = request.header("X-CSRF-Token", value);
+        }
+        request
+            .send()
+            .await
+            .map_err(|_| anyhow!("无法连接端域中心"))
+    }
+}
+
+impl BindingChallenge {
+    fn proof(
+        &self,
+        session: &ControllerSession,
+        device: &DeviceIdentity,
+        organization: Uuid,
+        epoch: u64,
+    ) -> ResultType<Vec<u8>> {
+        let expires = self.expires_ms.saturating_sub(now_ms()?);
+        if uuid_bytes(&self.organization_id)? != organization
+            || uuid_bytes(&self.device_id)? != device.id
+            || uuid_bytes(&self.user_id)? != session.user
+            || self.key_epoch != epoch
+            || self.protocol_version != 1
+            || !(1..=60_000).contains(&expires)
+        {
+            bail!("设备绑定挑战与当前账号或设备不符");
+        }
+        let id = uuid_bytes(&self.challenge_id)?;
+        let nonce = URL_SAFE_NO_PAD.decode(&self.nonce)?;
+        check_credential(&self.flow, "")?;
+        let flow = sha256::hash(&URL_SAFE_NO_PAD.decode(&self.flow)?);
+        encode(
+            USER_BINDING,
+            &[
+                organization.as_bytes(),
+                device.id.as_bytes(),
+                session.user.as_bytes(),
+                id.as_bytes(),
+                &nonce,
+                &flow.0,
+                &self.key_epoch.to_be_bytes(),
+                &self.expires_ms.to_be_bytes(),
+            ],
+        )
+        .ok_or_else(|| anyhow!("设备绑定挑战格式无效"))
+    }
+}
+
+fn read_cookie(response: &Response, name: &str) -> ResultType<String> {
+    let mut matches = response
+        .headers()
+        .get_all(SET_COOKIE)
+        .iter()
+        .filter_map(|header| {
+            let first = header.to_str().ok()?.split(';').next()?;
+            let (key, value) = first.split_once('=')?;
+            (key == name).then_some(value)
+        });
+    let value = matches
+        .next()
+        .ok_or_else(|| anyhow!("端域中心未返回登录会话"))?;
+    if matches.next().is_some() {
+        bail!("端域中心返回了重复的登录会话");
+    }
+    check_credential(value, "")?;
+    Ok(value.to_owned())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use hbb_common::sodiumoxide::crypto::sign;
+
+    #[test]
+    fn controller_binding_signs_only_the_active_account_and_device() {
+        let organization = Uuid::from_u128(1);
+        let device = DeviceIdentity::from_seed(Uuid::from_u128(2), &sign::Seed([3; 32])).unwrap();
+        let user = Uuid::from_u128(4);
+        let session = ControllerSession {
+            cookie: String::new(),
+            csrf: String::new(),
+            user,
+            username: "operator".into(),
+        };
+        let id = Uuid::from_u128(5);
+        let nonce = [6; 32];
+        let flow = [7; 32];
+        let flow_hash = sha256::hash(&flow);
+        let expires = now_ms().unwrap() + 30_000;
+        let mut challenge = BindingChallenge {
+            organization_id: organization.to_string(),
+            device_id: device.id.to_string(),
+            user_id: user.to_string(),
+            challenge_id: id.to_string(),
+            nonce: URL_SAFE_NO_PAD.encode(nonce),
+            flow: URL_SAFE_NO_PAD.encode(flow),
+            key_epoch: 8,
+            expires_ms: expires,
+            protocol_version: 1,
+        };
+        let mut expected = b"DR-M2\x00\x01\x02".to_vec();
+        for field in [
+            &organization.as_bytes()[..],
+            device.id.as_bytes(),
+            user.as_bytes(),
+            id.as_bytes(),
+            &nonce,
+            &flow_hash.0,
+            &8_u64.to_be_bytes(),
+            &expires.to_be_bytes(),
+        ] {
+            expected.extend_from_slice(&(field.len() as u16).to_be_bytes());
+            expected.extend_from_slice(field);
+        }
+        assert_eq!(
+            challenge.proof(&session, &device, organization, 8).unwrap(),
+            expected
+        );
+        assert!(challenge.proof(&session, &device, organization, 9).is_err());
+        assert!(challenge.proof(&session, &device, Uuid::nil(), 8).is_err());
+        challenge.user_id = Uuid::from_u128(10).to_string();
+        assert!(challenge.proof(&session, &device, organization, 8).is_err());
+    }
+}
