+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+
+import '../../common.dart';
+import '../../models/platform_model.dart';
+
+bool get hasDeskRealmAccount =>
+    isWindows &&
+    bind.mainGetBuildinOption(key: 'deskrealm-managed-mode') == 'Y';
+
+String get deskRealmCenter =>
+    bind.mainGetBuildinOption(key: 'deskrealm-managed-origin');
+
+class DeskRealmAccount extends StatefulWidget {
+  const DeskRealmAccount({super.key, this.onSignedIn});
+
+  final VoidCallback? onSignedIn;
+
+  @override
+  State<DeskRealmAccount> createState() => _DeskRealmAccountState();
+}
+
+class _DeskRealmAccountState extends State<DeskRealmAccount> {
+  final _username = TextEditingController();
+  final _password = TextEditingController();
+  final _code = TextEditingController();
+  String _state = 'signed_out';
+  String _account = '';
+  String? _error;
+  bool _busy = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _request('status');
+  }
+
+  @override
+  void dispose() {
+    _username.dispose();
+    _password.dispose();
+    _code.dispose();
+    super.dispose();
+  }
+
+  Future<void> _request(String action) async {
+    if (_busy) return;
+    final username = _username.text.trim();
+    final secret = action == 'verify'
+        ? _code.text.trim()
+        : action == 'login'
+        ? _password.text
+        : '';
+    if ((action == 'login' && (username.isEmpty || secret.isEmpty)) ||
+        (action == 'verify' && !RegExp(r'^[0-9]{6}$').hasMatch(secret))) {
+      setState(() => _error = action == 'login' ? '请输入端域账号和密码' : '请输入六位验证码');
+      return;
+    }
+    setState(() {
+      _busy = true;
+      _error = null;
+    });
+    _password.clear();
+    _code.clear();
+    Map<String, dynamic> result;
+    try {
+      final raw = await bind.mainDeskrealmAccount(
+        action: action,
+        username: username,
+        secret: secret,
+      );
+      result = jsonDecode(raw) as Map<String, dynamic>;
+    } catch (_) {
+      result = {'error': '无法读取端域账号状态，请重试'};
+    }
+    if (!mounted) return;
+    setState(() {
+      _busy = false;
+      _error = result['error'] as String?;
+      if (result['state'] is String) {
+        _state = result['state'] as String;
+        _account = result['username'] as String? ?? '';
+      } else if (action == 'logout') {
+        _state = 'signed_out';
+        _account = '';
+      }
+    });
+    if (_state == 'signed_in' && _error == null) widget.onSignedIn?.call();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final origin = deskRealmCenter;
+    final signedIn = _state == 'signed_in';
+    final verifying = _state == 'totp';
+    return Padding(
+      padding: const EdgeInsets.symmetric(vertical: 8),
+      child: Column(
+        mainAxisSize: MainAxisSize.min,
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          SelectableText(origin.isEmpty ? '安装包缺少端域中心地址' : '端域中心 $origin'),
+          const SizedBox(height: 12),
+          if (signedIn)
+            Text('已登录 $_account')
+          else if (verifying)
+            TextField(
+              controller: _code,
+              autofocus: true,
+              enabled: !_busy,
+              decoration: const InputDecoration(labelText: '身份验证码'),
+              keyboardType: TextInputType.number,
+              onSubmitted: (_) => _request('verify'),
+            )
+          else ...[
+            TextField(
+              controller: _username,
+              enabled: !_busy,
+              decoration: const InputDecoration(labelText: '端域账号'),
+            ),
+            TextField(
+              controller: _password,
+              enabled: !_busy,
+              decoration: const InputDecoration(labelText: '密码'),
+              obscureText: true,
+              onSubmitted: (_) => _request('login'),
+            ),
+          ],
+          if (_error != null)
+            Padding(
+              padding: const EdgeInsets.only(top: 8),
+              child: Text(
+                _error!,
+                style: TextStyle(color: Theme.of(context).colorScheme.error),
+              ),
+            ),
+          const SizedBox(height: 12),
+          Wrap(
+            spacing: 8,
+            children: [
+              FilledButton(
+                onPressed: _busy || origin.isEmpty
+                    ? null
+                    : () => _request(
+                        signedIn
+                            ? 'logout'
+                            : verifying
+                            ? 'verify'
+                            : 'login',
+                      ),
+                child: Text(
+                  _busy
+                      ? '正在处理…'
+                      : signedIn
+                      ? '退出登录'
+                      : verifying
+                      ? '验证并登录'
+                      : '登录端域',
+                ),
+              ),
+              if (verifying)
+                TextButton(
+                  onPressed: _busy ? null : () => _request('cancel'),
+                  child: const Text('返回账号登录'),
+                ),
+            ],
+          ),
+        ],
+      ),
+    );
+  }
+}
