diff --git a/src/deskrealm_desktop/account.rs b/src/deskrealm_desktop/account.rs
new file mode 100644
index 0000000000000000000000000000000000000000..097054d6460b4207f3fb212a1875f26327757dcb
--- /dev/null
+++ b/src/deskrealm_desktop/account.rs
@@ -0,0 +1,158 @@
+use super::Desktop;
+use base::deskrealm_endpoint::{
+    Authority, ControllerCredential, ControllerLogin, ControllerSession, DeviceCredential,
+    DeviceIdentity, PendingTOTP,
+};
+use hbb_common::{
+    anyhow::{anyhow, bail},
+    tokio::{self, sync::Mutex},
+    uuid::Uuid,
+    ResultType,
+};
+use serde_json::{json, Value};
+
+struct SignedIn {
+    session: ControllerSession,
+    credential: ControllerCredential,
+}
+
+enum Account {
+    SignedOut,
+    Pending(PendingTOTP),
+    SignedIn(SignedIn),
+}
+
+static ACCOUNT: Mutex<Account> = Mutex::const_new(Account::SignedOut);
+
+pub async fn bearer(desktop: &Desktop, device_credential: &DeviceCredential) -> ResultType<String> {
+    let mut account = ACCOUNT.lock().await;
+    let Account::SignedIn(current) = &mut *account else {
+        bail!("请先在「设置 → 账号」登录端域");
+    };
+    if current.credential.needs_refresh() {
+        current.credential = desktop
+            .authority
+            .bind_controller(
+                &current.session,
+                &desktop.device,
+                desktop.organization,
+                device_credential,
+            )
+            .await?;
+    }
+    Ok(current.credential.bearer().to_owned())
+}
+
+async fn finish_login(
+    authority: &Authority,
+    device: &DeviceIdentity,
+    organization: Uuid,
+    session: ControllerSession,
+) -> ResultType<SignedIn> {
+    let result = async {
+        let credential = authority.authenticate_device(device, organization).await?;
+        authority
+            .bind_controller(&session, device, organization, &credential)
+            .await
+    }
+    .await;
+    match result {
+        Ok(credential) => Ok(SignedIn {
+            session,
+            credential,
+        }),
+        Err(err) => {
+            let _ = authority.controller_logout(&session).await;
+            Err(err)
+        }
+    }
+}
+
+fn snapshot(account: &Account) -> Value {
+    match account {
+        Account::SignedOut => json!({"state": "signed_out"}),
+        Account::Pending(_) => json!({"state": "totp"}),
+        Account::SignedIn(current) => {
+            json!({"state": "signed_in", "username": current.session.username()})
+        }
+    }
+}
+
+async fn update(action: &str, username: &str, secret: &str) -> ResultType<Value> {
+    let mut account = ACCOUNT.lock().await;
+    if action == "cancel" {
+        if matches!(*account, Account::Pending(_)) {
+            *account = Account::SignedOut;
+        }
+        return Ok(snapshot(&account));
+    }
+    if action == "status" && !matches!(*account, Account::SignedIn(_)) {
+        return Ok(snapshot(&account));
+    }
+    if action == "logout" {
+        if let Account::SignedIn(current) = std::mem::replace(&mut *account, Account::SignedOut) {
+            let confirmed = async {
+                let (authority, _, _) = Desktop::identity()?;
+                authority.controller_logout(&current.session).await
+            }
+            .await;
+            confirmed.map_err(|_| anyhow!("本机已退出登录，中心尚未确认退出"))?;
+        }
+        return Ok(snapshot(&account));
+    }
+    let (authority, device, organization) = Desktop::identity()?;
+    match action {
+        "status" => {
+            if let Account::SignedIn(current) = &*account {
+                if !authority
+                    .controller_session_active(&current.session)
+                    .await?
+                {
+                    *account = Account::SignedOut;
+                }
+            }
+        }
+        "login" if !matches!(*account, Account::SignedIn(_)) => {
+            *account = Account::SignedOut;
+            match authority.controller_login(username, secret).await? {
+                ControllerLogin::NeedsTOTP(pending) => *account = Account::Pending(pending),
+                ControllerLogin::SignedIn(session) => {
+                    *account = Account::SignedIn(
+                        finish_login(&authority, &device, organization, session).await?,
+                    );
+                }
+            }
+        }
+        "verify" => {
+            let Account::Pending(pending) = &*account else {
+                bail!("请重新输入端域账号和密码");
+            };
+            let session = authority.controller_totp(pending, secret).await?;
+            *account = Account::SignedOut;
+            *account =
+                Account::SignedIn(finish_login(&authority, &device, organization, session).await?);
+        }
+        _ => bail!("端域账号操作无效"),
+    }
+    Ok(snapshot(&account))
+}
+
+pub fn handle(action: &str, username: &str, secret: &str) -> String {
+    let Ok(runtime) = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+    else {
+        return json!({"error": "无法初始化端域账号连接"}).to_string();
+    };
+    runtime.block_on(async {
+        let response = match update(action, username, secret).await {
+            Ok(response) => response,
+            Err(error) => {
+                let mut response = snapshot(&*ACCOUNT.lock().await);
+                response["error"] = json!(error.to_string());
+                response
+            }
+        };
+        response.to_string()
+    })
+}
