+++ b/libs/base/tests/deskrealm_relay_probes.rs
@@ -0,0 +1,74 @@
+use base::deskrealm_endpoint::{Authority, DeviceIdentity, SessionTarget};
+use hbb_common::{
+    anyhow::{anyhow, ensure},
+    base64::{engine::general_purpose::URL_SAFE_NO_PAD, Engine as _},
+    deskrealm_protocol::PeerRole,
+    sodiumoxide::crypto::sign,
+    uuid::Uuid,
+    ResultType,
+};
+use serde_derive::Deserialize;
+
+#[derive(Deserialize)]
+struct Peer {
+    device: String,
+    seed: String,
+    credential: String,
+}
+
+impl Peer {
+    fn identity(&self) -> ResultType<DeviceIdentity> {
+        let seed = URL_SAFE_NO_PAD.decode(&self.seed)?;
+        let seed = sign::Seed::from_slice(&seed).ok_or_else(|| anyhow!("invalid fixture seed"))?;
+        DeviceIdentity::from_seed(self.device.parse()?, &seed)
+    }
+}
+
+#[derive(Deserialize)]
+struct Fixture {
+    center: String,
+    center_key: String,
+    kid: String,
+    controller: Peer,
+    target: Peer,
+}
+
+#[tokio::test]
+async fn managed_native_endpoints_report_both_regional_relays() -> ResultType<()> {
+    let path = std::env::var("DESKREALM_RELAY_PROBE_FIXTURE")?;
+    let input: Fixture = serde_json::from_slice(&std::fs::read(path)?)?;
+    let ca = std::fs::read(std::env::var("DESKREALM_RELAY_PROBE_CA")?)?;
+    let controller = input.controller.identity()?;
+    let target = input.target.identity()?;
+    let center_key = URL_SAFE_NO_PAD.decode(&input.center_key)?;
+    let center_key = sign::PublicKey::from_slice(&center_key)
+        .ok_or_else(|| anyhow!("invalid fixture center verification key"))?;
+    let authority = Authority::new(&input.center, input.kid, center_key, Some(&ca))?;
+    let route = authority
+        .issue(
+            &controller,
+            &input.controller.credential,
+            SessionTarget::RustDeskId("10700002"),
+            Uuid::new_v4(),
+            "helpdesk",
+            1,
+            true,
+        )
+        .await?;
+    authority
+        .begin_relay_probes(&route, &controller, &input.controller.credential)
+        .await?;
+    let (first, second) = tokio::join!(
+        authority.collect_relay_probes(
+            &route,
+            &controller,
+            &input.controller.credential,
+            PeerRole::Controller,
+        ),
+        authority
+            .collect_relay_probes(&route, &target, &input.target.credential, PeerRole::Target,),
+    );
+    ensure!(first? == 2, "controller missed a regional relay");
+    ensure!(second? == 2, "target missed a regional relay");
+    Ok(())
+}
