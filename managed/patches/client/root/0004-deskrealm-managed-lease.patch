index 0000000..f436245
--- /dev/null
+++ b/libs/base/src/deskrealm_endpoint/lease.rs
@@ -0,0 +1,380 @@
+use super::{check_credential, mask, now_ms, uuid_bytes, Authority, Lease, INITIAL_LEASE};
+use hbb_common::{
+    anyhow::{anyhow, bail},
+    ResultType,
+};
+use serde_derive::Deserialize;
+use std::{convert::TryFrom, time::Duration};
+use tokio::time::Instant;
+
+// Windows' boot clock advances while suspended and has a resolution typically
+// between 10 and 16 ms. Leave a margin on both clocks for the coarse reading.
+const CLOCK_MARGIN: Duration = Duration::from_millis(50);
+
+#[derive(Clone, Copy)]
+pub(super) struct LeaseClock {
+    running: Instant,
+    boot: Duration,
+    wall_ms: u64,
+}
+
+impl LeaseClock {
+    pub(super) fn now() -> ResultType<Self> {
+        Ok(Self {
+            running: Instant::now(),
+            boot: boot_time()?,
+            wall_ms: now_ms()?,
+        })
+    }
+}
+
+#[cfg(windows)]
+fn boot_time() -> ResultType<Duration> {
+    Ok(Duration::from_millis(unsafe {
+        winapi::um::sysinfoapi::GetTickCount64()
+    }))
+}
+
+#[cfg(any(target_os = "linux", target_os = "android", target_vendor = "apple"))]
+fn boot_time() -> ResultType<Duration> {
+    #[cfg(any(target_os = "linux", target_os = "android"))]
+    let clock = libc::CLOCK_BOOTTIME;
+    #[cfg(target_vendor = "apple")]
+    let clock = libc::CLOCK_MONOTONIC_RAW;
+    let mut result = libc::timespec {
+        tv_sec: 0,
+        tv_nsec: 0,
+    };
+    if unsafe { libc::clock_gettime(clock, &mut result) } != 0 {
+        bail!("managed lease boot clock is unavailable");
+    }
+    Ok(Duration::new(
+        u64::try_from(result.tv_sec)?,
+        u32::try_from(result.tv_nsec)?,
+    ))
+}
+
+#[cfg(not(any(
+    windows,
+    target_os = "linux",
+    target_os = "android",
+    target_vendor = "apple"
+)))]
+fn boot_time() -> ResultType<Duration> {
+    bail!("managed lease boot clock is unavailable")
+}
+
+pub(super) struct LeaseWindow {
+    running_until: Instant,
+    boot_until: Duration,
+}
+
+impl LeaseWindow {
+    pub(super) fn new(
+        started: LeaseClock,
+        center_until_ms: u64,
+        now: LeaseClock,
+    ) -> ResultType<Self> {
+        let remaining = Duration::from_millis(center_until_ms.saturating_sub(now.wall_ms));
+        let limit = INITIAL_LEASE - CLOCK_MARGIN;
+        let window = Self {
+            running_until: (started.running + limit).min(now.running + remaining.min(limit)),
+            boot_until: (started.boot + limit).min(now.boot + remaining.min(limit)),
+        };
+        if !window.active_at(now) {
+            bail!("managed lease expired before receipt");
+        }
+        Ok(window)
+    }
+
+    fn active_at(&self, now: LeaseClock) -> bool {
+        now.running < self.running_until && now.boot < self.boot_until
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum ManagedAction {
+    View = 1,
+    Input = 2,
+    Audio = 4,
+    Clipboard = 8,
+    FileTransfer = 16,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum StopReason {
+    LocalEnd,
+    Revoked,
+    LeaseExpired,
+    ConnectionLost,
+}
+
+impl StopReason {
+    fn wire(self) -> &'static str {
+        match self {
+            Self::LocalEnd => "local_end",
+            Self::Revoked => "revoked",
+            Self::LeaseExpired => "lease_expired",
+            Self::ConnectionLost => "connection_lost",
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum SessionStatus {
+    Active,
+    RevocationRequested,
+    Revoked,
+    LeaseExpired,
+    Stopped,
+}
+
+#[derive(Deserialize)]
+struct StatusResponse {
+    connection_id: String,
+    lease_sequence: u64,
+    state: SessionStatus,
+}
+
+#[derive(Deserialize)]
+struct Renewal {
+    session_id: String,
+    connection_id: String,
+    lease_sequence: u64,
+    lease_until_ms: u64,
+    allowed_actions: Vec<String>,
+}
+
+impl Lease {
+    pub fn is_active(&self) -> bool {
+        LeaseClock::now().is_ok_and(|now| self.window.active_at(now))
+    }
+
+    pub fn permits(&self, action: ManagedAction) -> bool {
+        LeaseClock::now().is_ok_and(|now| self.permits_at(action, now))
+    }
+
+    fn permits_at(&self, action: ManagedAction, now: LeaseClock) -> bool {
+        self.allowed_mask & action as u8 != 0 && self.window.active_at(now)
+    }
+
+    pub fn deadline(&self) -> Instant {
+        self.window.running_until
+    }
+
+    fn start_renewal(&mut self, now: LeaseClock) -> ResultType<LeaseClock> {
+        if !self.window.active_at(now) {
+            bail!("managed lease is no longer active");
+        }
+        // The center makes retries for the previous sequence idempotent.
+        // Preserve the first request time even when it was cancelled or timed out.
+        Ok(*self.renewal_started.get_or_insert(now))
+    }
+
+    fn apply_renewal(
+        &mut self,
+        result: Renewal,
+        started: LeaseClock,
+        now: LeaseClock,
+    ) -> ResultType<()> {
+        if !self.window.active_at(now)
+            || uuid_bytes(&result.session_id)? != self.session_id
+            || uuid_bytes(&result.connection_id)? != self.connection_id
+            || Some(result.lease_sequence) != self.sequence.checked_add(1)
+            || result.lease_until_ms <= self.until_ms
+            || mask(&result.allowed_actions)? != self.allowed_mask
+        {
+            bail!("managed renewal does not match the active lease");
+        }
+        let window = LeaseWindow::new(started, result.lease_until_ms, now)?;
+        if window.running_until <= self.window.running_until
+            || window.boot_until <= self.window.boot_until
+        {
+            bail!("managed renewal did not extend the local deadline");
+        }
+        self.window = window;
+        self.sequence = result.lease_sequence;
+        self.until_ms = result.lease_until_ms;
+        self.renewal_started = None;
+        Ok(())
+    }
+}
+
+impl Authority {
+    pub async fn renew(&self, lease: &mut Lease, device_bearer: &str) -> ResultType<()> {
+        check_credential(device_bearer, "drd_")?;
+        let started = lease.start_renewal(LeaseClock::now()?)?;
+        let data = self
+            .post(
+                &format!("/v1/sessions/{}/renew", lease.session_id),
+                device_bearer,
+                serde_json::json!({
+                    "connection_id": lease.connection_id.to_string(),
+                    "session_credential": lease.credential(),
+                    "lease_sequence": lease.sequence,
+                }),
+                &[200],
+            )
+            .await?;
+        let result =
+            serde_json::from_slice(&data).map_err(|_| anyhow!("invalid managed renewal"))?;
+        lease.apply_renewal(result, started, LeaseClock::now()?)
+    }
+
+    /// A status response has no authority to extend the local deadline.
+    pub async fn session_status(&self, lease: &Lease) -> ResultType<SessionStatus> {
+        let endpoint = format!("/v1/sessions/{}/status", lease.session_id);
+        let request = self
+            .client
+            .get(self.center.join(&endpoint)?)
+            .query(&[("connection_id", lease.connection_id.to_string())])
+            .bearer_auth(lease.credential());
+        let data = Self::read_response(request, &[200]).await?;
+        let reply: StatusResponse =
+            serde_json::from_slice(&data).map_err(|_| anyhow!("invalid managed session status"))?;
+        if uuid_bytes(&reply.connection_id)? != lease.connection_id
+            || reply.lease_sequence < lease.sequence
+        {
+            bail!("managed session status does not match the connection");
+        }
+        Ok(reply.state)
+    }
+
+    /// Call only after the connection and its associated operations have stopped.
+    pub async fn report_stop(&self, lease: &Lease, reason: StopReason) -> ResultType<()> {
+        let endpoint = format!("/v1/sessions/{}/stopped", lease.session_id);
+        self.post(
+            &endpoint,
+            lease.credential(),
+            serde_json::json!({
+                "connection_id": lease.connection_id.to_string(),
+                "lease_sequence": lease.sequence,
+                "reason": reason.wire(),
+            }),
+            &[204],
+        )
+        .await?;
+        Ok(())
+    }
+
+    pub async fn report_local_end(&self, lease: &Lease) -> ResultType<()> {
+        self.report_stop(lease, StopReason::LocalEnd).await
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use hbb_common::{deskrealm_protocol::Path, uuid::Uuid};
+
+    fn sample(base: Instant, running: u64, boot: u64, wall_ms: u64) -> LeaseClock {
+        LeaseClock {
+            running: base + Duration::from_millis(running),
+            boot: Duration::from_millis(boot),
+            wall_ms,
+        }
+    }
+
+    fn initial(clock: LeaseClock) -> Lease {
+        Lease {
+            session_id: Uuid::new_v4(),
+            connection_id: Uuid::new_v4(),
+            path: Path::Direct,
+            allowed_mask: ManagedAction::View as u8,
+            sequence: 1,
+            until_ms: 31_000,
+            window: LeaseWindow::new(clock, 31_000, clock).unwrap(),
+            renewal_started: None,
+            credential: String::new(),
+        }
+    }
+
+    fn reply(lease: &Lease) -> Renewal {
+        Renewal {
+            session_id: lease.session_id.to_string(),
+            connection_id: lease.connection_id.to_string(),
+            lease_sequence: 2,
+            lease_until_ms: 41_000,
+            allowed_actions: vec!["view".into()],
+        }
+    }
+
+    #[test]
+    fn managed_lease_checks_each_action_and_denies_all_at_expiry() {
+        use ManagedAction::*;
+        let base = Instant::now();
+        let start = sample(base, 0, 100, 1_000);
+        let mut lease = initial(start);
+        let actions = [View, Input, Audio, Clipboard, FileTransfer];
+        for permitted in actions {
+            lease.allowed_mask = permitted as u8;
+            for requested in actions {
+                assert_eq!(lease.permits_at(requested, start), requested == permitted);
+                assert!(!lease.permits_at(requested, sample(base, 0, 30_050, 1_001)));
+            }
+        }
+    }
+
+    #[test]
+    fn managed_lease_window_expires_during_suspend_and_ignores_clock_rollback() {
+        let base = Instant::now();
+        let lease = initial(sample(base, 0, 100, 1_000));
+        assert!(lease.window.active_at(sample(base, 29_949, 30_049, 1)));
+        assert!(!lease.window.active_at(sample(base, 29_950, 30_049, 1)));
+        assert!(!lease.window.active_at(sample(base, 10, 30_050, 1)));
+    }
+
+    #[test]
+    fn managed_lease_renewal_preserves_first_attempt_bound_and_rejects_late_reply() {
+        let base = Instant::now();
+        let mut lease = initial(sample(base, 0, 100, 1_000));
+        let first = lease
+            .start_renewal(sample(base, 10_000, 10_100, 11_000))
+            .unwrap();
+        let retry = lease
+            .start_renewal(sample(base, 20_000, 20_100, 21_000))
+            .unwrap();
+        assert_eq!(retry.running, first.running);
+
+        let expired = sample(base, 22_000, 30_050, 22_900);
+        assert!(lease.apply_renewal(reply(&lease), retry, expired).is_err());
+        assert_eq!(lease.sequence, 1);
+
+        let received = sample(base, 22_000, 22_100, 23_000);
+        lease.apply_renewal(reply(&lease), retry, received).unwrap();
+        assert_eq!(lease.sequence, 2);
+        assert_eq!(lease.deadline(), base + Duration::from_millis(39_950));
+        assert!(lease.renewal_started.is_none());
+    }
+
+    #[test]
+    fn managed_lease_renewal_requires_exact_identity_sequence_and_scope() {
+        let base = Instant::now();
+        let mut lease = initial(sample(base, 0, 100, 1_000));
+        let started = lease
+            .start_renewal(sample(base, 10_000, 10_100, 11_000))
+            .unwrap();
+        let received = sample(base, 12_000, 12_100, 13_000);
+        let mut wrong_connection = reply(&lease);
+        wrong_connection.connection_id = Uuid::new_v4().to_string();
+        let mut wrong_session = reply(&lease);
+        wrong_session.session_id = Uuid::new_v4().to_string();
+        let mut wrong_sequence = reply(&lease);
+        wrong_sequence.lease_sequence = 3;
+        let mut wrong_scope = reply(&lease);
+        wrong_scope.allowed_actions.push("input".into());
+        let mut same_deadline = reply(&lease);
+        same_deadline.lease_until_ms = lease.until_ms;
+        for result in [
+            wrong_connection,
+            wrong_session,
+            wrong_sequence,
+            wrong_scope,
+            same_deadline,
+        ] {
+            assert!(lease.apply_renewal(result, started, received).is_err());
+            assert_eq!(lease.sequence, 1);
+        }
+    }
+}
