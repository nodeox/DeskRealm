diff --git a/src/client/io_loop/managed_files.rs b/src/client/io_loop/managed_files.rs
new file mode 100644
index 0000000..0f8c20c
--- /dev/null
+++ b/src/client/io_loop/managed_files.rs
@@ -0,0 +1,443 @@
+use super::*;
+use crate::server::managed_files as files;
+use base::{deskrealm_endpoint::FileResult, message_proto::desk_realm_file::Union};
+use hbb_common::{anyhow::anyhow, bail, ResultType};
+use std::{collections::VecDeque, sync::atomic::AtomicBool};
+
+const MAX_QUEUED: usize = 32;
+
+struct Request {
+    id: i32,
+    local: PathBuf,
+    name: String,
+    upload: bool,
+}
+
+struct Job {
+    request: Request,
+    size: u64,
+    phase: Phase,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Phase {
+    Opening,
+    Sending,
+    Receiving,
+    AwaitingResult,
+    Cancelling,
+}
+
+struct ControllerFiles {
+    disk: files::Disk,
+    permission: Arc<AtomicBool>,
+    permit: files::Permit,
+    active: Option<Job>,
+    queued: VecDeque<Request>,
+    listing_pending: bool,
+}
+
+impl Default for ControllerFiles {
+    fn default() -> Self {
+        let permission = Arc::new(AtomicBool::new(false));
+        let permit = permission.clone();
+        Self {
+            disk: files::Disk::default(),
+            permission,
+            permit: Arc::new(move || permit.load(Ordering::Acquire)),
+            active: None,
+            queued: VecDeque::new(),
+            listing_pending: false,
+        }
+    }
+}
+
+impl Drop for ControllerFiles {
+    fn drop(&mut self) {
+        self.permission.store(false, Ordering::Release);
+    }
+}
+
+impl<T: InvokeUiSession> Remote<T> {
+    pub(super) async fn managed_file_loop(&mut self, peer: &mut Stream) {
+        let mut state = ControllerFiles::default();
+        if let Err(error) = self.run_managed_files(peer, &mut state).await {
+            log::debug!("managed file connection ended: {error}");
+            self.handler
+                .on_establish_connection_error("受管文件连接已断开".to_owned());
+        }
+        state.permission.store(false, Ordering::Release);
+        self.handler.set_permission("file", false);
+        if let Err(error) = state.disk.end(FileResult::Cancelled).await {
+            log::error!("managed file cleanup failed: {error}");
+        }
+        if let Some(job) = state.active.take() {
+            self.handle_job_status(job.request.id, 0, Some("文件传输已中止".into()));
+        }
+        for job in state.queued.drain(..) {
+            self.handle_job_status(job.id, 0, Some("文件传输已中止".into()));
+        }
+    }
+
+    async fn run_managed_files(
+        &mut self,
+        peer: &mut Stream,
+        state: &mut ControllerFiles,
+    ) -> ResultType<()> {
+        let mut deadline = Instant::now() + SEC30;
+        let mut tick = time::interval(files::PUMP);
+        tick.set_missed_tick_behavior(time::MissedTickBehavior::Skip);
+        let mut windows = false;
+        loop {
+            if state.active.is_none() {
+                if let Some(request) = state.queued.pop_front() {
+                    state.open(peer, request, self).await?;
+                }
+            }
+            tokio::select! {
+                _ = time::sleep_until(deadline) => bail!("managed file session timed out"),
+                _ = tick.tick(), if state.active.as_ref().is_some_and(|job| job.phase == Phase::Sending) => {
+                    state.send_block(peer, self).await?;
+                }
+                frame = peer.next() => {
+                    let Some(Ok(bytes)) = frame else { bail!("managed file transport closed") };
+                    deadline = Instant::now() + SEC30;
+                    if !self.is_connected {
+                        self.handler.update_received(true);
+                    }
+                    let message = Message::parse_from_bytes(&bytes)?;
+                    if message.misc().has_close_reason() {
+                        return Ok(());
+                    }
+                    match message.union {
+                        Some(message::Union::LoginResponse(mut response)) if !self.is_connected => {
+                            let info = response.take_peer_info();
+                            if !info.displays.is_empty() || info.username != "DeskRealm"
+                                || info.sas_enabled || info.windows_sessions.is_some()
+                                || info.features.is_some() || !info.platform_additions.is_empty()
+                            {
+                                bail!("invalid managed file login response");
+                            }
+                            windows = info.platform == "Windows";
+                            self.is_connected = true;
+                            state.permission.store(true, Ordering::Release);
+                            self.handler.set_permission("file", true);
+                            self.handler.handle_peer_info(info);
+                        }
+                        Some(message::Union::DeskrealmFile(frame)) if self.is_connected => {
+                            state.receive(peer, frame, windows, self).await?;
+                        }
+                        _ => {}
+                    }
+                }
+                command = self.receiver.recv() => match command {
+                    None | Some(Data::Close) => {
+                        state.permission.store(false, Ordering::Release);
+                        base::deskrealm_endpoint::send_controller_end(peer).await;
+                        return Ok(());
+                    }
+                    Some(command) if self.is_connected => {
+                        state.command(peer, command, windows, self).await?;
+                    }
+                    _ => {}
+                }
+            }
+        }
+    }
+}
+
+impl ControllerFiles {
+    async fn command<T: InvokeUiSession>(
+        &mut self,
+        peer: &mut Stream,
+        command: Data,
+        windows: bool,
+        remote: &mut Remote<T>,
+    ) -> ResultType<()> {
+        match command {
+            Data::Message(message) if message.file_action().has_read_dir() => {
+                let read = message.file_action().read_dir();
+                let root = files::virtual_root(windows);
+                if !read.path.is_empty() && read.path != root {
+                    remote
+                        .handler
+                        .job_error(0, "请选择 DeskRealm 交换目录".into(), 0);
+                } else if !self.listing_pending {
+                    self.listing_pending = true;
+                    files::send(peer, &self.permit, &files::message(0, Union::List(true))).await?;
+                }
+            }
+            Data::SendFiles((id, kind, path, to, file_num, _, download)) => {
+                let queue_has_id = self.queued.iter().any(|job| job.id == id);
+                let active_has_id = self.active.as_ref().is_some_and(|job| job.request.id == id);
+                if queue_has_id || active_has_id {
+                    return Ok(());
+                }
+                let name = files::virtual_name(if download { &path } else { &to }, windows);
+                match name {
+                    Ok(name)
+                        if id > 0
+                            && file_num == 0
+                            && self.queued.len() < MAX_QUEUED
+                            && matches!(kind, fs::JobType::Generic) =>
+                    {
+                        self.queued.push_back(Request {
+                            id,
+                            name,
+                            local: PathBuf::from(if download { to } else { path }),
+                            upload: !download,
+                        });
+                    }
+                    _ => {
+                        remote.handle_job_status(id, 0, Some("选择单个普通文件，或稍后重试".into()))
+                    }
+                }
+            }
+            Data::CancelJob(id) => {
+                if let Some(index) = self.queued.iter().position(|job| job.id == id) {
+                    self.queued.remove(index);
+                    remote.handle_job_status(id, 0, Some("文件传输已取消".into()));
+                } else if let Some(job) = self.active.as_mut().filter(|job| job.request.id == id) {
+                    job.phase = Phase::Cancelling;
+                    self.disk.end(FileResult::Cancelled).await?;
+                    files::send(peer, &self.permit, &files::message(id, Union::Cancel(true)))
+                        .await?;
+                }
+            }
+            Data::AddJob((id, ..))
+            | Data::ResumeJob((id, _))
+            | Data::RemoveDirAll((id, ..))
+            | Data::RemoveDir((id, ..))
+            | Data::RemoveFile((id, ..))
+            | Data::CreateDir((id, ..))
+            | Data::RenameFile((id, ..)) => {
+                remote.handle_job_status(id, 0, Some("受管交换目录仅支持上传和下载".into()));
+            }
+            _ => {}
+        }
+        Ok(())
+    }
+
+    async fn open<T: InvokeUiSession>(
+        &mut self,
+        peer: &mut Stream,
+        request: Request,
+        remote: &mut Remote<T>,
+    ) -> ResultType<()> {
+        let id = request.id;
+        let upload = request.upload;
+        let size = if upload {
+            let path = request.local.clone();
+            match self
+                .disk
+                .perform(&self.permit, move |slot, _| {
+                    let transfer = files::Transfer::source(&path)?;
+                    let size = transfer.size;
+                    *slot = Some(transfer);
+                    Ok(size)
+                })
+                .await
+            {
+                Ok(size) => size,
+                Err(_) => {
+                    remote.handle_job_status(id, 0, Some("无法打开本地源文件".into()));
+                    return Ok(());
+                }
+            }
+        } else {
+            0
+        };
+        let open = DeskRealmFileOpen {
+            upload,
+            name: request.name.clone(),
+            size,
+            ..Default::default()
+        };
+        self.active = Some(Job {
+            request,
+            size,
+            phase: Phase::Opening,
+        });
+        files::send(peer, &self.permit, &files::message(id, Union::Open(open))).await
+    }
+
+    async fn send_block<T: InvokeUiSession>(
+        &mut self,
+        peer: &mut Stream,
+        remote: &mut Remote<T>,
+    ) -> ResultType<()> {
+        let job = self
+            .active
+            .as_mut()
+            .ok_or_else(|| anyhow!("missing active file job"))?;
+        let id = job.request.id;
+        let data = self
+            .disk
+            .perform(&self.permit, |slot, _| {
+                let transfer = files::current(slot)?;
+                Ok((transfer.next()?, transfer.bytes))
+            })
+            .await;
+        match data {
+            Ok((body, bytes)) => {
+                if matches!(body, Union::Finish(true)) {
+                    job.phase = Phase::AwaitingResult;
+                }
+                report_progress(remote, id, bytes);
+                files::send(peer, &self.permit, &files::message(id, body)).await
+            }
+            Err(_) => {
+                self.complete(remote, id, FileResult::Failed).await?;
+                files::send(
+                    peer,
+                    &self.permit,
+                    &files::result(id, DeskRealmFileResult::Failed),
+                )
+                .await
+            }
+        }
+    }
+
+    async fn receive<T: InvokeUiSession>(
+        &mut self,
+        peer: &mut Stream,
+        frame: DeskRealmFile,
+        windows: bool,
+        remote: &mut Remote<T>,
+    ) -> ResultType<()> {
+        let id = frame.id;
+        if id == 0 && self.listing_pending {
+            self.listing_pending = false;
+            match frame.union {
+                Some(Union::Directory(directory))
+                    if files::valid_directory(&directory, windows) =>
+                {
+                    remote.handler.update_folder_files(
+                        0,
+                        &directory.entries,
+                        directory.path,
+                        false,
+                        false,
+                    );
+                }
+                _ => remote
+                    .handler
+                    .job_error(0, "无法读取 DeskRealm 交换目录".into(), 0),
+            }
+            return Ok(());
+        }
+        let Some(job) = self.active.as_mut().filter(|job| job.request.id == id) else {
+            return Ok(());
+        };
+        match frame.union {
+            Some(Union::AcceptedSize(size)) if job.phase == Phase::Opening => {
+                if job.request.upload {
+                    if size != job.size {
+                        bail!("invalid upload size acknowledgement");
+                    }
+                    job.phase = Phase::Sending;
+                } else {
+                    let path = job.request.local.clone();
+                    if self
+                        .disk
+                        .perform(&self.permit, move |slot, _| {
+                            *slot = Some(files::Transfer::sink(&path, size)?);
+                            Ok(())
+                        })
+                        .await
+                        .is_err()
+                    {
+                        return self.fail_download(peer, remote, id).await;
+                    }
+                    job.phase = Phase::Receiving;
+                }
+            }
+            Some(Union::Block(bytes)) if job.phase == Phase::Receiving => {
+                let bytes = self
+                    .disk
+                    .perform(&self.permit, move |slot, permit| {
+                        files::current(slot)?.write(&bytes, permit)
+                    })
+                    .await;
+                match bytes {
+                    Ok(bytes) => report_progress(remote, id, bytes),
+                    Err(_) => return self.fail_download(peer, remote, id).await,
+                }
+            }
+            Some(Union::Finish(true)) if job.phase == Phase::Receiving => {
+                if self
+                    .disk
+                    .perform(&self.permit, |slot, permit| {
+                        files::current(slot)?.commit(permit)
+                    })
+                    .await
+                    .is_err()
+                {
+                    return self.fail_download(peer, remote, id).await;
+                }
+                self.complete(remote, id, FileResult::Completed).await?;
+                files::send(
+                    peer,
+                    &self.permit,
+                    &files::result(id, DeskRealmFileResult::Completed),
+                )
+                .await?;
+            }
+            Some(Union::Result(result)) => {
+                let value = match result.enum_value() {
+                    Ok(DeskRealmFileResult::Completed)
+                        if job.request.upload
+                            && matches!(job.phase, Phase::AwaitingResult | Phase::Cancelling) =>
+                    {
+                        FileResult::Completed
+                    }
+                    Ok(DeskRealmFileResult::Cancelled) => FileResult::Cancelled,
+                    Ok(DeskRealmFileResult::Failed) => FileResult::Failed,
+                    _ => bail!("invalid managed file result"),
+                };
+                self.complete(remote, id, value).await?;
+            }
+            _ => {}
+        }
+        Ok(())
+    }
+
+    async fn fail_download<T: InvokeUiSession>(
+        &mut self,
+        peer: &mut Stream,
+        remote: &mut Remote<T>,
+        id: i32,
+    ) -> ResultType<()> {
+        self.complete(remote, id, FileResult::Failed).await?;
+        files::send(
+            peer,
+            &self.permit,
+            &files::result(id, DeskRealmFileResult::Failed),
+        )
+        .await
+    }
+
+    async fn complete<T: InvokeUiSession>(
+        &mut self,
+        remote: &mut Remote<T>,
+        id: i32,
+        result: FileResult,
+    ) -> ResultType<()> {
+        self.disk.end(result).await?;
+        self.active = None;
+        let error = match result {
+            FileResult::Completed => None,
+            FileResult::Cancelled => Some("文件传输已取消".into()),
+            FileResult::Failed => Some("文件传输失败，目标文件可能已存在".into()),
+        };
+        remote.handle_job_status(id, 0, error);
+        Ok(())
+    }
+}
+
+fn report_progress<T: InvokeUiSession>(remote: &Remote<T>, id: i32, bytes: u64) {
+    // Limit progress notifications under continuous 64 KiB blocks.
+    if bytes % (1024 * 1024) == 0 {
+        remote.handler.job_progress(id, 0, 0.0, bytes as f64);
+    }
+}
