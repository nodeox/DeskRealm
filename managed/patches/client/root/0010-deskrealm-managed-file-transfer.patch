+            Ok::<_, hbb_common::anyhow::Error>(())
+        };
+        let (reason, controller) = timeout(Duration::from_secs(10), async {
+            tokio::join!(worker, controller)
+        })
+        .await?;
+        controller?;
+        assert_eq!(reason?, StopReason::LocalEnd);
+        assert_eq!(fs::read_dir(root.path())?.count(), 2);
+        assert!(!root.path().join("revoked.txt").exists());
+        let mut reported = Vec::new();
+        while let Some(event) = events.recv().await {
+            reported.push(event);
+        }
+        assert_eq!(reported.len(), 5);
+        assert!(reported.iter().all(|event| event.sequence == 7));
+        assert!(matches!(reported[0].direction, FileDirection::Download));
+        assert!(matches!(reported[0].result, FileResult::Completed));
+        assert_eq!(reported[0].bytes, source.len() as u64);
+        assert!(matches!(reported[1].direction, FileDirection::Upload));
+        assert!(matches!(reported[1].result, FileResult::Completed));
+        assert_eq!(reported[1].bytes, 5);
+        assert!(matches!(reported[2].result, FileResult::Failed));
+        assert!(matches!(reported[3].result, FileResult::Cancelled));
+        assert!(matches!(reported[4].result, FileResult::Cancelled));
+        assert_eq!(reported[4].bytes, 4);
+        Ok(())
+    }
+}
