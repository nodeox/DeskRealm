index 0000000..a86230c
--- /dev/null
+++ b/src/server/managed_files.rs
@@ -0,0 +1,963 @@
+//! The managed file window exposes a flat exchange directory and one active job.
+
+use base::{
+    deskrealm_endpoint::{
+        FileDirection, FileEvent, FileResult, ManagedAction, SessionAccess, StopReason,
+    },
+    message_proto::{desk_realm_file::Union, *},
+};
+use hbb_common::{
+    anyhow::anyhow,
+    bail,
+    protobuf::Message as _,
+    tokio::{
+        self,
+        sync::mpsc,
+        time::{interval, sleep, timeout, MissedTickBehavior},
+    },
+    uuid::Uuid,
+    ResultType, Stream,
+};
+use std::{
+    fs::{self, File, Metadata, OpenOptions},
+    io::{Read, Write},
+    path::{Path, PathBuf},
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+use tempfile::NamedTempFile;
+
+const BLOCK: usize = 64 * 1024;
+const MAX_ENTRIES: usize = 1024;
+const TEMP_PREFIX: &str = ".deskrealm-part-";
+pub(crate) const MAX_WIRE: usize = 512 * 1024;
+pub(crate) const PUMP: Duration = Duration::from_millis(4);
+pub(crate) type Permit = Arc<dyn Fn() -> bool + Send + Sync>;
+type Scope = Arc<dyn Fn() -> Option<(u64, u64)> + Send + Sync>;
+
+pub(crate) fn message(id: i32, body: Union) -> Message {
+    let mut message = Message::new();
+    message.set_deskrealm_file(DeskRealmFile {
+        id,
+        union: Some(body),
+        ..Default::default()
+    });
+    message
+}
+
+pub(crate) fn result(id: i32, value: DeskRealmFileResult) -> Message {
+    message(id, Union::Result(value.into()))
+}
+
+pub(crate) fn virtual_root(windows: bool) -> &'static str {
+    if windows {
+        "C:\\DeskRealm"
+    } else {
+        "/DeskRealm"
+    }
+}
+
+pub(crate) fn valid_directory(directory: &FileDirectory, windows: bool) -> bool {
+    directory.id == 0
+        && directory.path == virtual_root(windows)
+        && directory.entries.len() <= MAX_ENTRIES
+        && directory.entries.iter().all(|entry| {
+            entry.entry_type.enum_value() == Ok(FileType::File) && check_name(&entry.name).is_ok()
+        })
+        && base::fs::download::validate_listing(&directory.entries, windows).is_ok()
+}
+
+pub(crate) fn virtual_name(path: &str, windows: bool) -> ResultType<String> {
+    let path = if windows {
+        path.replace('/', "\\")
+    } else {
+        path.to_owned()
+    };
+    let (parent, name) = path
+        .rsplit_once(if windows { '\\' } else { '/' })
+        .ok_or_else(|| anyhow!("Select a file in the DeskRealm exchange directory"))?;
+    let root = virtual_root(windows);
+    let in_root = if windows {
+        parent.eq_ignore_ascii_case(root)
+    } else {
+        parent == root
+    };
+    if !in_root {
+        bail!("Select a file in the DeskRealm exchange directory");
+    }
+    check_name(name)?;
+    Ok(name.to_owned())
+}
+
+fn check_name(name: &str) -> ResultType<()> {
+    let stem = name
+        .split('.')
+        .next()
+        .unwrap_or_default()
+        .trim()
+        .to_ascii_uppercase();
+    let reserved_port = ["COM", "LPT"].iter().any(|prefix| {
+        stem.strip_prefix(prefix).is_some_and(|value| {
+            value.len() == 1 && value.as_bytes()[0].is_ascii_digit()
+                || matches!(value, "¹" | "²" | "³")
+        })
+    });
+    if name.is_empty()
+        || name.len() > 255
+        || name == "."
+        || name == ".."
+        || name.ends_with(['.', ' '])
+        || name.to_ascii_lowercase().starts_with(TEMP_PREFIX)
+        || name.contains(['/', '\\', ':', '<', '>', '"', '|', '?', '*'])
+        || name.chars().any(char::is_control)
+        || matches!(
+            stem.as_str(),
+            "CON" | "PRN" | "AUX" | "NUL" | "CONIN$" | "CONOUT$"
+        )
+        || reserved_port
+    {
+        bail!("Invalid file name for a managed transfer");
+    }
+    Ok(())
+}
+
+fn is_link(meta: &Metadata) -> bool {
+    #[cfg(windows)]
+    {
+        use std::os::windows::fs::MetadataExt;
+        meta.file_attributes() & winapi::um::winnt::FILE_ATTRIBUTE_REPARSE_POINT != 0
+    }
+    #[cfg(not(windows))]
+    {
+        meta.file_type().is_symlink()
+    }
+}
+
+fn safe_dir(path: &Path) -> ResultType<PathBuf> {
+    let meta = fs::symlink_metadata(path)?;
+    if !meta.is_dir() || is_link(&meta) {
+        bail!("Managed transfer directory is unavailable");
+    }
+    Ok(path.canonicalize()?)
+}
+
+fn ordinary_file(meta: &Metadata) -> bool {
+    meta.is_file() && !is_link(meta)
+}
+
+fn open_source(path: &Path) -> ResultType<(File, u64)> {
+    if !ordinary_file(&fs::symlink_metadata(path)?) {
+        bail!("Managed transfers require a regular file");
+    }
+    let mut options = OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    {
+        use hbb_common::libc::{O_NOFOLLOW, O_NONBLOCK};
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(O_NOFOLLOW | O_NONBLOCK);
+    }
+    #[cfg(windows)]
+    {
+        use std::os::windows::fs::OpenOptionsExt;
+        use winapi::um::winbase::FILE_FLAG_OPEN_REPARSE_POINT;
+        options.custom_flags(FILE_FLAG_OPEN_REPARSE_POINT);
+    }
+    let file = options.open(path)?;
+    let metadata = file.metadata()?;
+    if !ordinary_file(&metadata) || metadata.len() > i64::MAX as u64 {
+        bail!("Managed transfer source is unavailable");
+    }
+    Ok((file, metadata.len()))
+}
+
+#[cfg(unix)]
+fn single_link(file: &File) -> ResultType<bool> {
+    use std::os::unix::fs::MetadataExt;
+    Ok(file.metadata()?.nlink() == 1)
+}
+
+#[cfg(windows)]
+fn single_link(file: &File) -> ResultType<bool> {
+    use std::{mem::MaybeUninit, os::windows::io::AsRawHandle};
+    use winapi::{
+        shared::minwindef::FALSE,
+        um::fileapi::{GetFileInformationByHandle, BY_HANDLE_FILE_INFORMATION},
+    };
+    let mut information = MaybeUninit::<BY_HANDLE_FILE_INFORMATION>::uninit();
+    if unsafe { GetFileInformationByHandle(file.as_raw_handle() as _, information.as_mut_ptr()) }
+        == FALSE
+    {
+        return Err(std::io::Error::last_os_error().into());
+    }
+    Ok(unsafe { information.assume_init() }.nNumberOfLinks == 1)
+}
+
+struct Destination {
+    path: PathBuf,
+    part: Option<NamedTempFile>,
+}
+
+impl Destination {
+    fn create(path: &Path) -> ResultType<Self> {
+        let parent = path
+            .parent()
+            .ok_or_else(|| anyhow!("No destination directory"))?;
+        let parent = safe_dir(parent)?;
+        let name = path
+            .file_name()
+            .and_then(|s| s.to_str())
+            .ok_or_else(|| anyhow!("Invalid destination file name"))?;
+        check_name(name)?;
+        let path = parent.join(name);
+        match fs::symlink_metadata(&path) {
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) => return Err(error.into()),
+            Ok(_) => bail!("The destination file already exists"),
+        }
+        let part = tempfile::Builder::new()
+            .prefix(TEMP_PREFIX)
+            .tempfile_in(parent)?;
+        Ok(Self {
+            path,
+            part: Some(part),
+        })
+    }
+
+    fn commit(&mut self, permit: &Permit) -> ResultType<()> {
+        let part = self
+            .part
+            .as_mut()
+            .ok_or_else(|| anyhow!("No pending file"))?;
+        part.as_file_mut().sync_all()?;
+        if !permit() {
+            bail!("File authorization ended before publication");
+        }
+        let part = self.part.take().unwrap();
+        if let Err(error) = part.persist_noclobber(&self.path) {
+            self.part = Some(error.file);
+            return Err(error.error.into());
+        }
+        Ok(())
+    }
+
+    fn cleanup(&mut self) -> ResultType<()> {
+        if let Some(part) = self.part.take() {
+            part.close()?;
+        }
+        Ok(())
+    }
+}
+
+struct Audit {
+    permit: mpsc::OwnedPermit<FileEvent>,
+    event: FileEvent,
+}
+
+impl Audit {
+    fn new(sender: &mpsc::Sender<FileEvent>, sequence: u64, upload: bool) -> Option<Self> {
+        Some(Self {
+            permit: sender.clone().try_reserve_owned().ok()?,
+            event: FileEvent {
+                id: Uuid::new_v4(),
+                sequence,
+                direction: if upload {
+                    FileDirection::Upload
+                } else {
+                    FileDirection::Download
+                },
+                result: FileResult::Cancelled,
+                bytes: 0,
+            },
+        })
+    }
+}
+
+struct PendingAudit(Option<Audit>);
+
+impl Drop for PendingAudit {
+    fn drop(&mut self) {
+        if let Some(audit) = self.0.take() {
+            audit.permit.send(audit.event);
+        }
+    }
+}
+
+enum FileSide {
+    Source(File),
+    Sink(Destination),
+}
+
+pub(crate) struct Transfer {
+    file: FileSide,
+    pub(crate) size: u64,
+    pub(crate) bytes: u64,
+    audit: PendingAudit,
+}
+
+impl Transfer {
+    pub(crate) fn source(path: &Path) -> ResultType<Self> {
+        let (file, size) = open_source(path)?;
+        Ok(Self {
+            file: FileSide::Source(file),
+            size,
+            bytes: 0,
+            audit: PendingAudit(None),
+        })
+    }
+
+    fn exchange_source(path: &Path) -> ResultType<Self> {
+        let transfer = Self::source(path)?;
+        let FileSide::Source(file) = &transfer.file else {
+            unreachable!()
+        };
+        if !single_link(file)? {
+            bail!("A linked file cannot be read from the exchange directory");
+        }
+        Ok(transfer)
+    }
+
+    pub(crate) fn sink(path: &Path, size: u64) -> ResultType<Self> {
+        if size > i64::MAX as u64 {
+            bail!("Invalid managed file size");
+        }
+        let destination = Destination::create(path)?;
+        Ok(Self {
+            file: FileSide::Sink(destination),
+            size,
+            bytes: 0,
+            audit: PendingAudit(None),
+        })
+    }
+
+    pub(crate) fn next(&mut self) -> ResultType<Union> {
+        let FileSide::Source(source) = &mut self.file else {
+            bail!("Wrong file direction");
+        };
+        let count = (self.size - self.bytes).min(BLOCK as u64) as usize;
+        if count == 0 {
+            return Ok(Union::Finish(true));
+        }
+        let mut data = vec![0; count];
+        source.read_exact(&mut data)?;
+        self.progress(count as u64);
+        Ok(Union::Block(data.into()))
+    }
+
+    pub(crate) fn write(&mut self, bytes: &[u8], permit: &Permit) -> ResultType<u64> {
+        let FileSide::Sink(destination) = &mut self.file else {
+            bail!("Wrong file direction");
+        };
+        if bytes.is_empty() || bytes.len() > BLOCK || bytes.len() as u64 > self.size - self.bytes {
+            bail!("Invalid managed file block");
+        }
+        // Count even short writes before a local disk error.
+        let file = destination
+            .part
+            .as_mut()
+            .ok_or_else(|| anyhow!("No pending file"))?;
+        let mut remaining = bytes;
+        while !remaining.is_empty() {
+            if !permit() {
+                bail!("Managed file authorization ended");
+            }
+            let written = match file.write(remaining) {
+                Ok(0) => bail!("Managed file write made no progress"),
+                Ok(written) => written,
+                Err(error) if error.kind() == std::io::ErrorKind::Interrupted => continue,
+                Err(error) => return Err(error.into()),
+            };
+            remaining = &remaining[written..];
+            self.bytes += written as u64;
+            if let Some(audit) = &mut self.audit.0 {
+                audit.event.bytes = self.bytes;
+            }
+        }
+        Ok(self.bytes)
+    }
+
+    fn progress(&mut self, count: u64) {
+        self.bytes += count;
+        if let Some(audit) = &mut self.audit.0 {
+            audit.event.bytes = self.bytes;
+        }
+    }
+
+    pub(crate) fn commit(&mut self, permit: &Permit) -> ResultType<()> {
+        let FileSide::Sink(destination) = &mut self.file else {
+            bail!("Wrong file direction");
+        };
+        if self.bytes != self.size {
+            bail!("Incomplete managed file");
+        }
+        destination.commit(permit)?;
+        // Publication is durable user-visible progress, even if the ACK is interrupted.
+        if let Some(audit) = &mut self.audit.0 {
+            audit.event.result = FileResult::Completed;
+        }
+        Ok(())
+    }
+
+    fn end(mut self, outcome: FileResult) -> ResultType<()> {
+        if let FileSide::Sink(destination) = &mut self.file {
+            destination.cleanup()?;
+        }
+        if let Some(audit) = &mut self.audit.0 {
+            if !matches!(audit.event.result, FileResult::Completed) {
+                audit.event.result = outcome;
+            }
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Default)]
+pub(crate) struct Disk(Arc<Mutex<Option<Transfer>>>);
+
+impl Disk {
+    pub(crate) async fn perform<T: Send + 'static>(
+        &self,
+        permit: &Permit,
+        operation: impl FnOnce(&mut Option<Transfer>, &Permit) -> ResultType<T> + Send + 'static,
+    ) -> ResultType<T> {
+        let disk = self.clone();
+        let permit = permit.clone();
+        tokio::task::spawn_blocking(move || {
+            let mut slot = disk.0.lock().unwrap();
+            if !permit() {
+                bail!("Managed file authorization is inactive");
+            }
+            operation(&mut slot, &permit)
+        })
+        .await?
+    }
+
+    pub(crate) async fn end(&self, outcome: FileResult) -> ResultType<()> {
+        let disk = self.clone();
+        // The mutex serializes cleanup with any operation whose awaiting future was cancelled.
+        // Late blocking tasks must recheck the now-invalid lease before performing any I/O.
+        tokio::task::spawn_blocking(move || {
+            let mut slot = disk.0.lock().unwrap();
+            slot.take().map_or(Ok(()), |job| job.end(outcome))
+        })
+        .await?
+    }
+}
+
+pub(crate) fn current(slot: &mut Option<Transfer>) -> ResultType<&mut Transfer> {
+    slot.as_mut()
+        .ok_or_else(|| anyhow!("No active managed file transfer"))
+}
+
+fn listing(path: &Path, permitted: &Permit) -> ResultType<FileDirectory> {
+    let mut entries = Vec::new();
+    // Keep both the listing and the work on an oversized shared directory bounded.
+    for entry in fs::read_dir(path)?.take(MAX_ENTRIES * 2) {
+        if !permitted() {
+            bail!("Managed file authorization ended");
+        }
+        let entry = entry?;
+        let Some(name) = entry.file_name().into_string().ok() else {
+            continue;
+        };
+        if name.starts_with('.') || check_name(&name).is_err() {
+            continue;
+        }
+        let metadata = fs::symlink_metadata(entry.path())?;
+        if !ordinary_file(&metadata) {
+            continue;
+        }
+        let modified_time = metadata
+            .modified()
+            .ok()
+            .and_then(|time| time.duration_since(std::time::UNIX_EPOCH).ok())
+            .map_or(0, |elapsed| elapsed.as_secs());
+        entries.push(FileEntry {
+            name,
+            size: metadata.len(),
+            modified_time,
+            entry_type: FileType::File.into(),
+            ..Default::default()
+        });
+        if entries.len() == MAX_ENTRIES {
+            break;
+        }
+    }
+    entries.sort_by(|a, b| a.name.cmp(&b.name));
+    Ok(FileDirectory {
+        path: virtual_root(cfg!(windows)).to_owned(),
+        entries,
+        ..Default::default()
+    })
+}
+
+#[derive(Clone, Copy)]
+struct Active {
+    id: i32,
+    upload: bool,
+    waiting_for_ack: bool,
+}
+
+pub(crate) async fn run_target(
+    mut stream: Stream,
+    access: SessionAccess,
+    root: PathBuf,
+    disk: Disk,
+    audits: mpsc::Sender<FileEvent>,
+) -> StopReason {
+    let scope: Scope = {
+        let access = access.clone();
+        Arc::new(move || access.scope(ManagedAction::FileTransfer))
+    };
+    let status = target_loop(&mut stream, scope, root, disk, audits).await;
+    if !access.permits(ManagedAction::FileTransfer) {
+        drop(stream);
+        // End the file data plane immediately. Let the supervisor report the actual
+        // lease failure, or close locally after a suspended lease has been revalidated.
+        while !access.permits(ManagedAction::FileTransfer) {
+            sleep(Duration::from_millis(25)).await;
+        }
+        return StopReason::LocalEnd;
+    }
+    match status {
+        Ok(reason) => reason,
+        Err(error) => {
+            // The managed audit endpoint receives metadata only.
+            hbb_common::log::debug!("managed file session ended: {error}");
+            StopReason::ConnectionLost
+        }
+    }
+}
+
+async fn target_loop(
+    stream: &mut Stream,
+    scope: Scope,
+    root: PathBuf,
+    disk: Disk,
+    audits: mpsc::Sender<FileEvent>,
+) -> ResultType<StopReason> {
+    let generation = timeout(Duration::from_secs(5), async {
+        loop {
+            if let Some((generation, _)) = scope() {
+                break generation;
+            }
+            sleep(Duration::from_millis(25)).await;
+        }
+    })
+    .await?;
+    let permit: Permit = {
+        let scope = scope.clone();
+        Arc::new(move || scope().is_some_and(|(current, _)| current == generation))
+    };
+    let root = disk.perform(&permit, move |_, _| safe_dir(&root)).await?;
+    let mut login = Message::new();
+    login.mut_login_response().set_peer_info(PeerInfo {
+        username: "DeskRealm".to_owned(),
+        hostname: crate::whoami_hostname(),
+        platform: hbb_common::whoami::platform().to_string(),
+        version: crate::VERSION.to_owned(),
+        ..Default::default()
+    });
+    send(stream, &permit, &login).await?;
+
+    let mut active: Option<Active> = None;
+    let mut tick = interval(PUMP);
+    tick.set_missed_tick_behavior(MissedTickBehavior::Skip);
+    let mut check = interval(Duration::from_millis(25));
+    let mut keepalive = interval(Duration::from_secs(5));
+    loop {
+        tokio::select! {
+            _ = check.tick() => {
+                if !permit() {
+                    return Ok(StopReason::LocalEnd);
+                }
+            }
+            _ = keepalive.tick() => {
+                let mut ping = Message::new();
+                ping.set_test_delay(TestDelay::new());
+                send(stream, &permit, &ping).await?;
+            }
+            packet = stream.next() => {
+                let Some(Ok(packet)) = packet else { return Ok(StopReason::ConnectionLost) };
+                let message = Message::parse_from_bytes(&packet)?;
+                if message.misc().has_close_reason() {
+                    return Ok(StopReason::LocalEnd);
+                }
+                let Some(message::Union::DeskrealmFile(frame)) = message.union else { continue };
+                if let Some(reply) = target_request(&disk, &permit, &scope, &root, &audits, &mut active, frame).await? {
+                    send(stream, &permit, &reply).await?;
+                }
+            }
+            _ = tick.tick(), if active.is_some_and(|job| !job.upload && !job.waiting_for_ack) => {
+                let job = active.as_mut().unwrap();
+                let id = job.id;
+                match disk.perform(&permit, |slot, _| current(slot)?.next()).await {
+                    Ok(body) => {
+                        job.waiting_for_ack = matches!(body, Union::Finish(true));
+                        send(stream, &permit, &message(id, body)).await?;
+                    }
+                    Err(_) => {
+                        if !permit() {
+                            return Ok(StopReason::LocalEnd);
+                        }
+                        disk.end(FileResult::Failed).await?;
+                        active = None;
+                        send(stream, &permit, &result(id, DeskRealmFileResult::Failed)).await?;
+                    }
+                }
+            }
+        }
+    }
+}
+
+async fn target_request(
+    disk: &Disk,
+    permit: &Permit,
+    scope: &Scope,
+    root: &Path,
+    audits: &mpsc::Sender<FileEvent>,
+    active: &mut Option<Active>,
+    frame: DeskRealmFile,
+) -> ResultType<Option<Message>> {
+    let id = frame.id;
+    let reply = match frame.union {
+        Some(Union::List(true)) if id == 0 => {
+            let root = root.to_owned();
+            match disk
+                .perform(permit, move |_, permit| listing(&root, permit))
+                .await
+            {
+                Ok(directory) => message(0, Union::Directory(directory)),
+                Err(_) => result(0, DeskRealmFileResult::Failed),
+            }
+        }
+        Some(Union::Open(open)) if id > 0 && active.is_none() => {
+            let Some((_, sequence)) = scope() else {
+                return Ok(None);
+            };
+            let Some(audit) = Audit::new(audits, sequence, open.upload) else {
+                return Ok(Some(result(id, DeskRealmFileResult::Failed)));
+            };
+            let audit = PendingAudit(Some(audit));
+            let upload = open.upload;
+            let root = root.to_owned();
+            match disk
+                .perform(permit, move |slot, _| {
+                    let mut audit = audit;
+                    let opened = (|| {
+                        check_name(&open.name)?;
+                        let path = root.join(open.name);
+                        if upload {
+                            Transfer::sink(&path, open.size)
+                        } else {
+                            Transfer::exchange_source(&path)
+                        }
+                    })();
+                    match opened {
+                        Ok(mut transfer) => {
+                            let size = transfer.size;
+                            transfer.audit = audit;
+                            *slot = Some(transfer);
+                            Ok(size)
+                        }
+                        Err(error) => {
+                            audit.0.as_mut().unwrap().event.result = FileResult::Failed;
+                            Err(error)
+                        }
+                    }
+                })
+                .await
+            {
+                Ok(size) => {
+                    *active = Some(Active {
+                        id,
+                        upload,
+                        waiting_for_ack: false,
+                    });
+                    message(id, Union::AcceptedSize(size))
+                }
+                Err(_) => result(id, DeskRealmFileResult::Failed),
+            }
+        }
+        Some(Union::Open(_)) if id > 0 && !active.is_some_and(|job| job.id == id) => {
+            result(id, DeskRealmFileResult::Failed)
+        }
+        Some(Union::Block(bytes)) if active.is_some_and(|job| job.id == id && job.upload) => {
+            if disk
+                .perform(permit, move |slot, permit| {
+                    current(slot)?.write(&bytes, permit)
+                })
+                .await
+                .is_ok()
+            {
+                return Ok(None);
+            }
+            if !permit() {
+                bail!("Managed file authorization ended");
+            }
+            disk.end(FileResult::Failed).await?;
+            *active = None;
+            result(id, DeskRealmFileResult::Failed)
+        }
+        Some(Union::Finish(true)) if active.is_some_and(|job| job.id == id && job.upload) => {
+            let committed = disk
+                .perform(permit, |slot, permit| current(slot)?.commit(permit))
+                .await
+                .is_ok();
+            if !committed && !permit() {
+                bail!("Managed file authorization ended");
+            }
+            *active = None;
+            let (outcome, wire) = if committed {
+                (FileResult::Completed, DeskRealmFileResult::Completed)
+            } else {
+                (FileResult::Failed, DeskRealmFileResult::Failed)
+            };
+            disk.end(outcome).await?;
+            result(id, wire)
+        }
+        Some(Union::Result(report)) if active.is_some_and(|job| job.id == id) => {
+            let outcome = match report.enum_value() {
+                Ok(DeskRealmFileResult::Completed)
+                    if active.is_some_and(|job| !job.upload && job.waiting_for_ack) =>
+                {
+                    FileResult::Completed
+                }
+                Ok(DeskRealmFileResult::Failed) => FileResult::Failed,
+                Ok(DeskRealmFileResult::Cancelled) => FileResult::Cancelled,
+                _ => return Ok(None),
+            };
+            disk.end(outcome).await?;
+            *active = None;
+            return Ok(None);
+        }
+        Some(Union::Cancel(true)) if active.is_some_and(|job| job.id == id) => {
+            disk.end(FileResult::Cancelled).await?;
+            *active = None;
+            result(id, DeskRealmFileResult::Cancelled)
+        }
+        _ => return Ok(None),
+    };
+    Ok(Some(reply))
+}
+
+pub(crate) async fn send(
+    stream: &mut Stream,
+    permit: &Permit,
+    message: &Message,
+) -> ResultType<()> {
+    if !permit() {
+        bail!("Managed file authorization is inactive");
+    }
+    super::managed_view::send_authorized(stream, message, || permit()).await
+}
