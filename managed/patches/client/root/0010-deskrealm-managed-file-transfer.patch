+#[derive(Clone, Copy)]
+pub enum FileDirection {
+    Upload,
+    Download,
+}
+
+#[derive(Clone, Copy)]
+pub enum FileResult {
+    Completed,
+    Failed,
+    Cancelled,
+}
+
+pub struct FileEvent {
+    pub id: hbb_common::uuid::Uuid,
+    pub sequence: u64,
+    pub direction: FileDirection,
+    pub result: FileResult,
+    pub bytes: u64,
+}
+
+pub struct SessionFileReceipts {
+    connection_id: hbb_common::uuid::Uuid,
+    session_id: hbb_common::uuid::Uuid,
+    credential: String,
+}
+
+impl SessionFileReceipts {
+    pub fn for_lease(lease: &Lease) -> Option<Self> {
+        lease.permits(ManagedAction::FileTransfer).then(|| Self {
+            connection_id: lease.connection_id,
+            session_id: lease.session_id,
+            credential: lease.credential().to_owned(),
+        })
+    }
+
+    pub async fn report(&self, authority: &Authority, event: &FileEvent) -> ResultType<()> {
+        let endpoint = format!("/v1/sessions/{}/file-events", self.session_id);
+        let direction = match event.direction {
+            FileDirection::Upload => "upload",
+            FileDirection::Download => "download",
+        };
+        let result = match event.result {
+            FileResult::Completed => "completed",
+            FileResult::Failed => "failed",
+            FileResult::Cancelled => "cancelled",
+        };
+        let body = serde_json::json!({
+            "connection_id": self.connection_id.to_string(),
+            "lease_sequence": event.sequence,
+            "event_id": event.id.to_string(),
+            "direction": direction,
+            "result": result,
+            "size_bytes": event.bytes,
+        });
+        for delay in [0, 250, 500] {
+            tokio::time::sleep(Duration::from_millis(delay)).await;
+            if authority.post(&endpoint, &self.credential, body.clone(), &[204]).await.is_ok() {
+                return Ok(());
+            }
+        }
+        bail!("managed file receipt did not reach the center")
+    }
+}
