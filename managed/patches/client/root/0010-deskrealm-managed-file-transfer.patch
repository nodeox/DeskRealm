+            assert!(Transfer::exchange_source(&alias).is_err());
+        }
+        let disk = Disk::default();
+        permitted.store(false, Ordering::Release);
+        assert!(disk
+            .perform::<()>(&gate, |_, _| panic!("unauthorized disk access"))
+            .await
+            .is_err());
+        Ok(())
+    }
