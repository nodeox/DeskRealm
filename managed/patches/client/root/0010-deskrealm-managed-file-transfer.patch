+    #[tokio::test]
+    async fn managed_file_paths_and_publication_fail_closed() -> ResultType<()> {
+        let root = tempfile::tempdir()?;
+        let final_path = root.path().join("result.txt");
+        let mut job = Transfer::sink(&final_path, 4)?;
+        let permitted = Arc::new(AtomicBool::new(true));
+        let check = permitted.clone();
+        let gate: Permit = Arc::new(move || check.load(Ordering::Acquire));
+
+        assert!(virtual_name("C:\\DeskRealm\\nested\\escape.txt", true).is_err());
+        assert!(virtual_name("/DeskRealm/../escape.txt", false).is_err());
