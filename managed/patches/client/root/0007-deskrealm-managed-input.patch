+++ b/src/server/managed_input.rs
@@ -0,0 +1,504 @@
+//! Session-scoped keyboard and mouse dispatch for the managed desktop.
+
+use crate::input::*;
+use base::{
+    deskrealm_endpoint::{ManagedAction, SessionAccess},
+    message_proto::{key_event, DisplayInfo, KeyEvent, KeyboardMode, MouseEvent},
+};
+use hbb_common::{anyhow::anyhow, log, ResultType};
+use rdev::{Button, EventType, Key, RawKey};
+use std::{
+    sync::mpsc::{self, Receiver, RecvTimeoutError, SyncSender},
+    thread::{self, JoinHandle},
+    time::Duration,
+};
+
+const CHECK_INTERVAL: Duration = Duration::from_millis(25);
+const QUEUE_DEPTH: usize = 32;
+const HELD_LIMIT: usize = 32;
+
+#[cfg(windows)]
+pub(crate) fn available() -> bool {
+    let Some(console) = crate::platform::deskrealm_unlocked_console() else {
+        return false;
+    };
+    crate::platform::get_current_process_session_id() == Some(console)
+        && !crate::platform::desktop_changed()
+}
+
+#[cfg(target_os = "linux")]
+pub(crate) fn available() -> bool {
+    scrap::is_x11() && std::env::var_os("DISPLAY").is_some()
+}
+
+#[cfg(not(any(windows, target_os = "linux")))]
+pub(crate) fn available() -> bool {
+    false
+}
+
+#[derive(Clone, Copy)]
+pub(super) struct Screen {
+    left: i32,
+    top: i32,
+    width: i32,
+    height: i32,
+}
+
+impl From<&DisplayInfo> for Screen {
+    fn from(info: &DisplayInfo) -> Self {
+        Self {
+            left: info.x,
+            top: info.y,
+            width: info.width,
+            height: info.height,
+        }
+    }
+}
+
+impl Screen {
+    fn contains(self, x: i32, y: i32) -> bool {
+        let x = i64::from(x) - i64::from(self.left);
+        let y = i64::from(y) - i64::from(self.top);
+        (0..i64::from(self.width)).contains(&x) && (0..i64::from(self.height)).contains(&y)
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Held {
+    Key(Key),
+    Mouse(Button),
+}
+
+impl Held {
+    fn event(self, down: bool) -> EventType {
+        match (self, down) {
+            (Self::Key(key), true) => EventType::KeyPress(key),
+            (Self::Key(key), false) => EventType::KeyRelease(key),
+            (Self::Mouse(button), true) => EventType::ButtonPress(button),
+            (Self::Mouse(button), false) => EventType::ButtonRelease(button),
+        }
+    }
+}
+
+#[derive(Clone, Copy)]
+pub(super) enum Input {
+    Down(Held),
+    Up(Held),
+    Press(Held),
+    Move(i32, i32),
+    Scroll(i64),
+}
+
+impl Input {
+    pub(super) fn key(event: &KeyEvent) -> Option<Self> {
+        if event.mode.enum_value() != Ok(KeyboardMode::Map) {
+            return None;
+        }
+        let Some(key_event::Union::Chr(code)) = event.union else {
+            return None;
+        };
+        let key = Held::Key(Key::RawKey(raw_key(code)?));
+        Some(if event.press {
+            Self::Press(key)
+        } else if event.down {
+            Self::Down(key)
+        } else {
+            Self::Up(key)
+        })
+    }
+
+    pub(super) fn mouse(event: &MouseEvent, screen: Screen) -> Option<Self> {
+        let variant = event.mask & MOUSE_TYPE_MASK;
+        let button = event.mask >> 3;
+        match variant {
+            MOUSE_TYPE_MOVE if (0..32).contains(&button) && screen.contains(event.x, event.y) => {
+                Some(Self::Move(event.x, event.y))
+            }
+            MOUSE_TYPE_DOWN | MOUSE_TYPE_UP => {
+                let button = match button {
+                    MOUSE_BUTTON_LEFT => Button::Left,
+                    MOUSE_BUTTON_RIGHT => Button::Right,
+                    MOUSE_BUTTON_WHEEL => Button::Middle,
+                    _ => return None,
+                };
+                let held = Held::Mouse(button);
+                Some(if variant == MOUSE_TYPE_DOWN {
+                    Self::Down(held)
+                } else {
+                    Self::Up(held)
+                })
+            }
+            // Use a single vertical notch per packet; the X11 backend uses the sign
+            // only and Windows applies the same native wheel unit.
+            MOUSE_TYPE_WHEEL if (0..32).contains(&button) && event.y != 0 => {
+                Some(Self::Scroll(i64::from(event.y.signum())))
+            }
+            _ => None,
+        }
+    }
+}
+
+#[cfg(windows)]
+fn raw_key(code: u32) -> Option<RawKey> {
+    // Nonzero set-1 scan code, optionally prefixed with E0 for an extended key.
+    let ordinary = (1..=0x7f).contains(&code);
+    let extended = (0xe001..=0xe07f).contains(&code);
+    (ordinary || extended).then_some(RawKey::ScanCode(code))
+}
+
+#[cfg(target_os = "linux")]
+fn raw_key(code: u32) -> Option<RawKey> {
+    (8..=255)
+        .contains(&code)
+        .then_some(RawKey::LinuxXorgKeycode(code))
+}
+
+#[cfg(not(any(windows, target_os = "linux")))]
+fn raw_key(_code: u32) -> Option<RawKey> {
+    None
+}
+
+fn simulate(event: EventType) -> ResultType<()> {
+    #[cfg(windows)]
+    if let EventType::MouseMove { x, y } = event {
+        if unsafe { winapi::um::winuser::SetCursorPos(x as i32, y as i32) } == 0 {
+            return Err(std::io::Error::last_os_error().into());
+        }
+        return Ok(());
+    }
+    rdev::simulate(&event)?;
+    Ok(())
+}
+
+struct Queued {
+    generation: u64,
+    input: Input,
+}
+
+pub(super) struct InputWorker {
+    sender: Option<SyncSender<Queued>>,
+    thread: Option<JoinHandle<ResultType<()>>>,
+    access: SessionAccess,
+}
+
+impl InputWorker {
+    pub(super) fn start(access: SessionAccess, screen: Screen) -> ResultType<Self> {
+        let (sender, receiver) = mpsc::sync_channel(QUEUE_DEPTH);
+        let gate = access.clone();
+        let thread = thread::Builder::new()
+            .name("managed-input".into())
+            .spawn(move || {
+                run(
+                    receiver,
+                    || {
+                        gate.generation(ManagedAction::Input)
+                            .filter(|_| available())
+                    },
+                    |input| {
+                        if matches!(input, Input::Down(Held::Mouse(_)) | Input::Scroll(_)) {
+                            return crate::platform::get_cursor_pos()
+                                .is_some_and(|(x, y)| screen.contains(x, y));
+                        }
+                        true
+                    },
+                    simulate,
+                )
+            })?;
+        Ok(Self {
+            sender: Some(sender),
+            thread: Some(thread),
+            access,
+        })
+    }
+
+    pub(super) fn enqueue(&self, input: Input) -> ResultType<()> {
+        if let Some(generation) = self.access.generation(ManagedAction::Input) {
+            self.sender
+                .as_ref()
+                .ok_or_else(|| anyhow!("managed input is closed"))?
+                .try_send(Queued { generation, input })
+                .map_err(|_| anyhow!("managed input queue is full or closed"))?;
+        }
+        Ok(())
+    }
+
+    pub(super) fn finished(&self) -> bool {
+        self.thread.as_ref().map_or(true, JoinHandle::is_finished)
+    }
+
+    pub(super) fn stop(&mut self) -> ResultType<()> {
+        self.sender.take();
+        if let Some(worker) = self.thread.take() {
+            worker
+                .join()
+                .map_err(|_| anyhow!("managed input worker panicked"))??;
+        }
+        Ok(())
+    }
+}
+
+impl Drop for InputWorker {
+    fn drop(&mut self) {
+        if let Err(err) = self.stop() {
+            log::error!("managed input shutdown failed: {err}");
+        }
+    }
+}
+
+fn run(
+    receiver: Receiver<Queued>,
+    permission: impl Fn() -> Option<u64>,
+    valid: impl Fn(Input) -> bool,
+    mut simulate: impl FnMut(EventType) -> ResultType<()>,
+) -> ResultType<()> {
+    let mut held: Vec<Held> = Vec::new();
+    let mut previous = None;
+    let result = (|| -> ResultType<()> {
+        loop {
+            let entry = match receiver.recv_timeout(CHECK_INTERVAL) {
+                Ok(entry) => Some(entry),
+                Err(RecvTimeoutError::Timeout) => None,
+                Err(RecvTimeoutError::Disconnected) => break,
+            };
+            let active = permission();
+            if active != previous {
+                release(&mut held, &mut simulate)?;
+                previous = active;
+            }
+            if let Some(entry) = entry {
+                if active == Some(entry.generation) && valid(entry.input) && permission() == active
+                {
+                    dispatch(entry.input, &mut held, &mut simulate)?;
+                }
+            }
+        }
+        Ok(())
+    })();
+    // Releases are permitted during cancellation. No new downs can be issued.
+    if let Err(err) = result {
+        log::debug!("managed input dispatch stopped: {err}");
+    }
+    release(&mut held, &mut simulate)
+}
+
+fn dispatch(
+    input: Input,
+    held: &mut Vec<Held>,
+    simulate: &mut impl FnMut(EventType) -> ResultType<()>,
+) -> ResultType<()> {
+    match input {
+        Input::Down(control) | Input::Press(control) => {
+            let fresh = !held.contains(&control);
+            if fresh {
+                if held.len() >= HELD_LIMIT {
+                    return Err(anyhow!("too many held managed inputs"));
+                }
+                // Track before emitting the press so cleanup attempts release even
+                // when a backend reports failure after partially applying an event.
+                held.push(control);
+                simulate(control.event(true))?;
+            } else if matches!(control, Held::Key(_)) && matches!(input, Input::Down(_)) {
+                simulate(control.event(true))?;
+            }
+            if fresh && matches!(input, Input::Press(_)) {
+                simulate(control.event(false))?;
+                held.pop();
+            }
+        }
+        Input::Up(control) => {
+            if let Some(index) = held.iter().position(|item| *item == control) {
+                simulate(control.event(false))?;
+                held.remove(index);
+            }
+        }
+        Input::Move(x, y) => simulate(EventType::MouseMove {
+            x: x.into(),
+            y: y.into(),
+        })?,
+        Input::Scroll(delta_y) => simulate(EventType::Wheel {
+            delta_x: 0,
+            delta_y,
+        })?,
+    }
+    Ok(())
+}
+
+fn release(
+    held: &mut Vec<Held>,
+    simulate: &mut impl FnMut(EventType) -> ResultType<()>,
+) -> ResultType<()> {
+    let mut error = None;
+    for index in (0..held.len()).rev() {
+        match simulate(held[index].event(false)) {
+            Ok(()) => {
+                held.remove(index);
+            }
+            Err(err) => error = Some(err),
+        }
+    }
+    error.map_or(Ok(()), Err)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{
+        sync::{
+            atomic::{AtomicU64, Ordering},
+            Arc,
+        },
+        time::Instant,
+    };
+
+    fn queue(sender: &SyncSender<Queued>, generation: u64, input: Input) {
+        sender.send(Queued { generation, input }).unwrap();
+    }
+
+    #[test]
+    fn managed_input_discards_stale_queued_events_and_releases_held_buttons() {
+        let (tx, rx) = mpsc::sync_channel(QUEUE_DEPTH);
+        let (events, seen) = mpsc::channel();
+        let generation = Arc::new(AtomicU64::new(1));
+        let gate = generation.clone();
+        let left = Held::Mouse(Button::Left);
+        let right = Held::Mouse(Button::Right);
+        let worker = thread::spawn(move || {
+            run(
+                rx,
+                || match gate.load(Ordering::SeqCst) {
+                    0 => None,
+                    epoch => Some(epoch),
+                },
+                |_| true,
+                |event| {
+                    events.send(event)?;
+                    Ok(())
+                },
+            )
+        });
+        // A release for an unowned button must not become a local mouse-up.
+        queue(&tx, 1, Input::Up(right));
+        queue(&tx, 1, Input::Down(left));
+        let recv = || seen.recv_timeout(Duration::from_secs(2)).unwrap();
+        assert_eq!(recv(), left.event(true));
+        generation.store(2, Ordering::SeqCst);
+        queue(&tx, 1, Input::Down(right));
+        queue(&tx, 2, Input::Down(right));
+        assert_eq!(recv(), left.event(false));
+        assert_eq!(recv(), right.event(true));
+        generation.store(0, Ordering::SeqCst);
+        queue(&tx, 2, Input::Down(left));
+        assert_eq!(recv(), right.event(false));
+        drop(tx);
+        worker.join().unwrap().unwrap();
+        assert!(seen.try_recv().is_err());
+    }
+
+    #[cfg(target_os = "linux")]
+    fn x11_state(code: u8) -> (bool, bool, (i32, i32)) {
+        use std::ffi::c_void;
+        use std::os::raw::{c_char, c_int, c_uint, c_ulong};
+        #[link(name = "X11")]
+        extern "C" {
+            fn XOpenDisplay(name: *const c_char) -> *mut c_void;
+            fn XCloseDisplay(display: *mut c_void) -> c_int;
+            fn XDefaultRootWindow(display: *mut c_void) -> c_ulong;
+            fn XQueryKeymap(display: *mut c_void, keys: *mut c_char) -> c_int;
+            fn XQueryPointer(
+                display: *mut c_void,
+                window: c_ulong,
+                root: *mut c_ulong,
+                child: *mut c_ulong,
+                x: *mut c_int,
+                y: *mut c_int,
+                wx: *mut c_int,
+                wy: *mut c_int,
+                mask: *mut c_uint,
+            ) -> c_int;
+        }
+        unsafe {
+            let display = XOpenDisplay(std::ptr::null());
+            assert!(!display.is_null(), "X11 display required");
+            let mut keys = [0 as c_char; 32];
+            let (mut root, mut child, mut x, mut y, mut wx, mut wy, mut mask) =
+                (0, 0, 0, 0, 0, 0, 0);
+            XQueryKeymap(display, keys.as_mut_ptr());
+            assert_ne!(
+                XQueryPointer(
+                    display,
+                    XDefaultRootWindow(display),
+                    &mut root,
+                    &mut child,
+                    &mut x,
+                    &mut y,
+                    &mut wx,
+                    &mut wy,
+                    &mut mask,
+                ),
+                0
+            );
+            XCloseDisplay(display);
+            let down = keys[usize::from(code / 8)] as u8 & (1 << (code % 8)) != 0;
+            (down, mask & (1 << 8) != 0, (x, y))
+        }
+    }
+
+    #[cfg(target_os = "linux")]
+    #[test]
+    #[ignore = "injects local events, run inside isolated Xvfb"]
+    fn managed_input_x11_injects_and_cleans_up_after_permission_loss() {
+        let code = 38;
+        let map_key = |down| {
+            let mut key = KeyEvent {
+                mode: KeyboardMode::Map.into(),
+                down,
+                ..Default::default()
+            };
+            key.set_chr(code.into());
+            key
+        };
+        let button_down = MouseEvent {
+            mask: MOUSE_TYPE_DOWN | (MOUSE_BUTTON_LEFT << 3),
+            ..Default::default()
+        };
+        let screen = Screen {
+            left: 0,
+            top: 0,
+            width: 640,
+            height: 480,
+        };
+        let (tx, rx) = mpsc::sync_channel(QUEUE_DEPTH);
+        let generation = Arc::new(AtomicU64::new(1));
+        let gate = generation.clone();
+        let worker = thread::spawn(move || {
+            run(
+                rx,
+                || (gate.load(Ordering::SeqCst) == 1).then_some(1),
+                |_| true,
+                simulate,
+            )
+        });
+        queue(&tx, 1, Input::Move(55, 80));
+        queue(&tx, 1, Input::key(&map_key(true)).unwrap());
+        queue(&tx, 1, Input::mouse(&button_down, screen).unwrap());
+        let wait = |expected| {
+            let deadline = Instant::now() + Duration::from_secs(3);
+            loop {
+                if x11_state(code) == expected {
+                    break;
+                }
+                assert!(
+                    Instant::now() < deadline,
+                    "X11 state did not reach {expected:?}"
+                );
+                thread::sleep(Duration::from_millis(20));
+            }
+        };
+        wait((true, true, (55, 80)));
+        generation.store(0, Ordering::SeqCst);
+        queue(&tx, 1, Input::Move(100, 110));
+        wait((false, false, (55, 80)));
+        drop(tx);
+        worker.join().unwrap().unwrap();
+    }
+}
