diff --git a/src/server/managed_clipboard.rs b/src/server/managed_clipboard.rs
new file mode 100644
index 0000000..b772ff8
--- /dev/null
+++ b/src/server/managed_clipboard.rs
@@ -0,0 +1,325 @@
+//! Session-scoped plain-text clipboard for both managed endpoints.
+
+use crate::clipboard::{ClipboardContext, ClipboardSide};
+use base::{
+    deskrealm_endpoint::{ManagedAction, SessionAccess},
+    message_proto::{desk_realm_clipboard, DeskRealmClipboard, Message},
+};
+use hbb_common::{tokio::sync::mpsc, ResultType};
+use std::{
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        mpsc as sync, Arc,
+    },
+    thread::{self, JoinHandle},
+    time::{Duration, Instant},
+};
+
+pub(crate) const POLL_INTERVAL: Duration = Duration::from_millis(120);
+const MAX_TEXT_BYTES: usize = 64 * 1024;
+pub(crate) const MAX_WIRE_BYTES: usize = MAX_TEXT_BYTES + 256;
+const MAX_PACKET_AGE: Duration = Duration::from_secs(1);
+const QUEUE_DEPTH: usize = 2;
+
+pub(crate) fn available() -> bool {
+    super::managed_input::available()
+}
+
+pub(crate) fn target_epoch(access: &SessionAccess) -> u64 {
+    access
+        .generation(ManagedAction::Clipboard)
+        .filter(|_| available())
+        .map_or(0, |generation| generation + 1)
+}
+
+fn valid_text(text: &str) -> bool {
+    !text.is_empty() && text.len() <= MAX_TEXT_BYTES && !text.contains('\0')
+}
+
+pub(crate) fn state_message(epoch: u64) -> Message {
+    let mut message = Message::new();
+    let state = message.mut_deskrealm_clipboard();
+    state.epoch = epoch;
+    state.set_state(epoch != 0);
+    message
+}
+
+#[derive(Default)]
+pub(crate) struct RemoteEpoch {
+    pub(crate) current: u64,
+    newest: u64,
+}
+
+impl RemoteEpoch {
+    pub(crate) fn update(&mut self, frame: &DeskRealmClipboard) {
+        match frame.union {
+            Some(desk_realm_clipboard::Union::State(false)) if frame.epoch == 0 => self.current = 0,
+            Some(desk_realm_clipboard::Union::State(true)) if frame.epoch > self.newest => {
+                self.newest = frame.epoch;
+                self.current = frame.epoch;
+            }
+            _ => {}
+        }
+    }
+}
+
+pub(crate) struct Packet {
+    epoch: u64,
+    text: String,
+    queued_at: Instant,
+}
+
+impl Packet {
+    fn new(epoch: u64, text: String) -> Self {
+        Self {
+            epoch,
+            text,
+            queued_at: Instant::now(),
+        }
+    }
+
+    pub(crate) fn from_wire(frame: &DeskRealmClipboard, epoch: u64) -> Option<Self> {
+        if epoch == 0
+            || frame.epoch != epoch
+            || !frame.has_text()
+            || frame.text().len() > MAX_TEXT_BYTES
+        {
+            return None;
+        }
+        let text = std::str::from_utf8(frame.text()).ok()?;
+        valid_text(text).then(|| Self::new(epoch, text.to_owned()))
+    }
+
+    pub(crate) fn is_current(&self, epoch: u64) -> bool {
+        epoch != 0 && self.epoch == epoch && self.queued_at.elapsed() < MAX_PACKET_AGE
+    }
+
+    pub(crate) fn into_message(self) -> Message {
+        let mut message = Message::new();
+        let frame = message.mut_deskrealm_clipboard();
+        frame.epoch = self.epoch;
+        frame.set_text(self.text.into_bytes().into());
+        message
+    }
+
+    pub(crate) fn epoch(&self) -> u64 {
+        self.epoch
+    }
+}
+
+pub(crate) struct Worker {
+    input: sync::SyncSender<Packet>,
+    stopped: Arc<AtomicBool>,
+    thread: Option<JoinHandle<()>>,
+}
+
+impl Worker {
+    pub(crate) fn start(
+        side: ClipboardSide,
+        active_epoch: impl Fn() -> u64 + Send + 'static,
+        output: mpsc::Sender<Packet>,
+    ) -> ResultType<Self> {
+        let (input, queue) = sync::sync_channel(QUEUE_DEPTH);
+        let stopped = Arc::new(AtomicBool::new(false));
+        let cancelled = stopped.clone();
+        let thread = thread::Builder::new()
+            .name("managed-clipboard".into())
+            .spawn(move || run(side, queue, output, &cancelled, active_epoch))?;
+        Ok(Self {
+            input,
+            stopped,
+            thread: Some(thread),
+        })
+    }
+
+    pub(crate) fn apply(&self, packet: Packet) {
+        let _ = self.input.try_send(packet);
+    }
+
+    pub(crate) fn stop(mut self) -> ResultType<()> {
+        self.stopped.store(true, Ordering::Release);
+        if let Some(thread) = self.thread.take() {
+            thread
+                .join()
+                .map_err(|_| hbb_common::anyhow::anyhow!("managed clipboard worker panicked"))?;
+        }
+        Ok(())
+    }
+}
+
+impl Drop for Worker {
+    fn drop(&mut self) {
+        self.stopped.store(true, Ordering::Release);
+    }
+}
+
+fn run(
+    side: ClipboardSide,
+    input: sync::Receiver<Packet>,
+    output: mpsc::Sender<Packet>,
+    stopped: &AtomicBool,
+    active_epoch: impl Fn() -> u64,
+) {
+    let mut context = None;
+    let mut last: Option<(u64, Option<String>)> = None;
+    let mut next_poll = Instant::now();
+    loop {
+        if stopped.load(Ordering::Acquire) || output.is_closed() {
+            return;
+        }
+        let pending = match input.recv_timeout(next_poll.saturating_duration_since(Instant::now())) {
+            Ok(packet) => Some(packet),
+            Err(sync::RecvTimeoutError::Timeout) => None,
+            Err(sync::RecvTimeoutError::Disconnected) => return,
+        };
+        let poll = Instant::now() >= next_poll;
+        if poll {
+            next_poll = Instant::now() + POLL_INTERVAL;
+        }
+        let epoch = active_epoch();
+        if epoch == 0 {
+            last = None;
+            continue;
+        }
+        let pending = pending.filter(|packet| packet.is_current(epoch));
+        if !poll && pending.is_none() {
+            continue;
+        }
+        if context.is_none() {
+            context = ClipboardContext::new().ok();
+        }
+        let Some(context) = context.as_mut() else {
+            continue;
+        };
+        let permitted = || active_epoch() == epoch && !stopped.load(Ordering::Acquire);
+        if let Some(packet) = pending {
+            let queued_at = packet.queued_at;
+            let _ = context.set_managed_text(packet.text, side, || {
+                permitted() && queued_at.elapsed() < MAX_PACKET_AGE
+            });
+        }
+        if !poll {
+            continue;
+        }
+        let Ok(text) = context.get_managed_text(side, permitted) else {
+            continue;
+        };
+        if !permitted() {
+            last = None;
+            continue;
+        }
+        let text = text.filter(|text| valid_text(text));
+        // Existing clipboard contents become the baseline at each newly authorized epoch.
+        let changed = last
+            .as_ref()
+            .is_some_and(|(previous, value)| *previous == epoch && value != &text);
+        if let Some(text) = text.as_ref().filter(|_| changed) {
+            if output.try_send(Packet::new(epoch, text.clone())).is_err() {
+                continue;
+            }
+        }
+        last = Some((epoch, text));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn managed_clipboard_validates_text_and_discards_stale_epochs() {
+        let mut state = RemoteEpoch::default();
+        state.update(state_message(1).deskrealm_clipboard());
+        assert_eq!(state.current, 1);
+        state.update(state_message(0).deskrealm_clipboard());
+        state.update(state_message(1).deskrealm_clipboard());
+        assert_eq!(state.current, 0);
+        state.update(state_message(3).deskrealm_clipboard());
+        state.update(state_message(2).deskrealm_clipboard());
+        assert_eq!(state.current, 3);
+
+        let mut packet = Packet::new(3, "受管剪贴板".to_owned());
+        assert!(packet.is_current(3));
+        assert!(!packet.is_current(0));
+        assert!(!packet.is_current(1));
+        packet.queued_at = Instant::now() - MAX_PACKET_AGE;
+        assert!(!packet.is_current(3));
+
+        let mut frame = packet.into_message();
+        assert!(Packet::from_wire(frame.deskrealm_clipboard(), 1).is_none());
+        assert!(Packet::from_wire(frame.deskrealm_clipboard(), 3).is_some());
+        for invalid in [vec![], vec![0], vec![0xff], vec![b'x'; MAX_TEXT_BYTES + 1]] {
+            frame.mut_deskrealm_clipboard().set_text(invalid.into());
+            assert!(Packet::from_wire(frame.deskrealm_clipboard(), 3).is_none());
+        }
+        frame.mut_deskrealm_clipboard().set_text(vec![b'x'; MAX_TEXT_BYTES].into());
+        assert!(Packet::from_wire(frame.deskrealm_clipboard(), 3).is_some());
+        assert!(Packet::from_wire(state_message(3).deskrealm_clipboard(), 3).is_none());
+    }
+
+    #[cfg(target_os = "linux")]
+    #[tokio::test]
+    #[ignore = "requires Xvfb or a real X11 display"]
+    async fn managed_clipboard_x11_applies_text_only_under_current_permission() -> ResultType<()> {
+        use hbb_common::tokio::time::{sleep, timeout};
+        use std::sync::atomic::{AtomicU64, AtomicUsize};
+
+        let mut native = arboard::Clipboard::new()?;
+        native.set_text("initial local text".to_owned())?;
+        let epoch = Arc::new(AtomicU64::new(0));
+        let calls = Arc::new(AtomicUsize::new(0));
+        let (output, mut packets) = mpsc::channel(QUEUE_DEPTH);
+        let worker = Worker::start(ClipboardSide::Host, {
+            let epoch = epoch.clone();
+            let calls = calls.clone();
+            move || {
+                let epoch = epoch.load(Ordering::Acquire);
+                if epoch != 0 {
+                    calls.fetch_add(1, Ordering::Release);
+                }
+                epoch
+            }
+        }, output)?;
+
+        worker.apply(Packet::new(1, "denied".to_owned()));
+        assert!(timeout(POLL_INTERVAL * 2, packets.recv()).await.is_err());
+        assert_eq!(native.get_text()?, "initial local text");
+        assert_eq!(calls.load(Ordering::Acquire), 0);
+        epoch.store(1, Ordering::Release);
+        timeout(Duration::from_secs(5), async {
+            while calls.load(Ordering::Acquire) < 3 {
+                sleep(Duration::from_millis(10)).await;
+            }
+        }).await?;
+        assert!(packets.try_recv().is_err());
+        native.set_text("从本端复制".to_owned())?;
+        let packet = timeout(Duration::from_secs(5), packets.recv()).await?.unwrap();
+        assert!(packet.is_current(1));
+        assert_eq!(packet.text, "从本端复制");
+
+        worker.apply(Packet::new(1, "来自另一端".to_owned()));
+        timeout(Duration::from_secs(5), async {
+            while native.get_text().ok().as_deref() != Some("来自另一端") {
+                sleep(Duration::from_millis(10)).await;
+            }
+        }).await?;
+        assert!(timeout(POLL_INTERVAL * 2, packets.recv()).await.is_err());
+
+        epoch.store(0, Ordering::Release);
+        native.set_text("copied while paused".to_owned())?;
+        worker.apply(Packet::new(1, "must not overwrite".to_owned()));
+        assert!(timeout(POLL_INTERVAL * 2, packets.recv()).await.is_err());
+        assert_eq!(native.get_text()?, "copied while paused");
+        epoch.store(3, Ordering::Release);
+        worker.apply(Packet::new(1, "still stale".to_owned()));
+        assert!(timeout(POLL_INTERVAL * 2, packets.recv()).await.is_err());
+        assert_eq!(native.get_text()?, "copied while paused");
+        native.set_text("copied after resume".to_owned())?;
+        let packet = timeout(Duration::from_secs(5), packets.recv()).await?.unwrap();
+        assert!(packet.is_current(3));
+        assert_eq!(packet.text, "copied after resume");
+        worker.stop()?;
+        assert!(packets.recv().await.is_none());
+        Ok(())
+    }
+}
