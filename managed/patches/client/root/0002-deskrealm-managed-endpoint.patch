diff --git a/libs/base/tests/deskrealm_interop.rs b/libs/base/tests/deskrealm_interop.rs
new file mode 100644
index 0000000..9a0ef49
--- /dev/null
+++ b/libs/base/tests/deskrealm_interop.rs
@@ -0,0 +1,173 @@
+use base::{
+    deskrealm_endpoint::{AppliedPolicy, Authority, DeviceIdentity, TargetSession},
+    deskrealm_transport::{Network, RelayNode},
+};
+use hbb_common::{
+    base64::{engine::general_purpose::URL_SAFE_NO_PAD, Engine as _},
+    bytes::Bytes,
+    deskrealm_protocol::Path,
+    rendezvous_proto::{rendezvous_message, RegisterPk, RendezvousMessage},
+    sodiumoxide::crypto::sign,
+    uuid::Uuid,
+    ResultType,
+};
+use protobuf::Message as _;
+use std::{env, net::SocketAddr, time::Duration};
+use tokio::{net::UdpSocket, time::timeout};
+
+const DEVICE_RUSTDESK_ID: &str = "10700002";
+const WAIT: Duration = Duration::from_secs(30);
+
+fn bearer(prefix: &str, byte: u8) -> String {
+    format!("{prefix}{}", URL_SAFE_NO_PAD.encode([byte; 32]))
+}
+
+async fn register(rendezvous: SocketAddr, target: &DeviceIdentity) -> ResultType<UdpSocket> {
+    let socket = UdpSocket::bind("127.0.0.1:0").await?;
+    socket.connect(rendezvous).await?;
+    let mut message = RendezvousMessage::new();
+    message.set_register_pk(RegisterPk {
+        id: DEVICE_RUSTDESK_ID.to_owned(),
+        uuid: Bytes::copy_from_slice(target.id.as_bytes()),
+        pk: Bytes::copy_from_slice(target.public_key.as_ref()),
+        ..Default::default()
+    });
+    socket.send(&message.write_to_bytes()?).await?;
+    let mut bytes = [0; 4096];
+    let n = timeout(WAIT, socket.recv(&mut bytes)).await??;
+    assert!(RendezvousMessage::parse_from_bytes(&bytes[..n])?.has_register_pk_response());
+    Ok(socket)
+}
