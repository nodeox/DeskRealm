+#[tokio::test]
+async fn managed_endpoint_admission_on_direct_and_relay() -> ResultType<()> {
+    let center = env::var("DESKREALM_FIXTURE_CENTER")
+        .expect("launch this test with the managed TLS fixture");
+    let ca = std::fs::read(env::var("DESKREALM_FIXTURE_CA")?)?;
+    let rendezvous = env::var("DESKREALM_FIXTURE_HBBS")?.parse()?;
+    let relay_authority = env::var("DESKREALM_FIXTURE_HBBR")?;
+    let controller = DeviceIdentity::from_seed(
+        env::var("DESKREALM_FIXTURE_CONTROLLER")?.parse()?,
+        &sign::Seed([2; 32]),
+    )?;
+    let target = DeviceIdentity::from_seed(
+        env::var("DESKREALM_FIXTURE_TARGET")?.parse()?,
+        &sign::Seed([3; 32]),
+    )?;
+    let (center_key, _) = sign::keypair_from_seed(&sign::Seed([1; 32]));
+    let authority = Authority::new(&center, "fixture-center".to_owned(), center_key, Some(&ca))?;
+    let network = Network {
+        rendezvous,
+        relay: Some(RelayNode {
+            authority: &relay_authority,
+            address: relay_authority.parse()?,
+        }),
+    };
+    assert!(authority
+        .issue(
+            &controller,
+            &bearer("dru_", 11),
+            DEVICE_RUSTDESK_ID,
+            Uuid::new_v4(),
+            "expired",
+            3,
+            true
+        )
+        .await
+        .is_err());
+    let target_udp = register(rendezvous, &target).await?;
+    for (path, purpose, selection, success) in [
+        (Path::Direct, "direct-admit", Some(1), true),
+        (Path::Relay, "relay-admit", Some(1), true),
+        (Path::Direct, "decline", None, false),
+        (Path::Direct, "path-mismatch", Some(1), false),
+        (Path::Direct, "policy-mismatch", Some(1), false),
+        (Path::Relay, "deny-redeem", Some(1), false),
+    ] {
+        let controller_run = async {
+            let route = authority
+                .issue(
+                    &controller,
+                    &bearer("dru_", 11),
+                    DEVICE_RUSTDESK_ID,
+                    Uuid::new_v4(),
+                    purpose,
+                    3,
+                    true,
+                )
+                .await?;
+            let mut stream = network
+                .connect_controller(&authority, &controller, &route, path)
+                .await?;
+            let claimed_path = if purpose == "path-mismatch" {
+                Path::Relay
+            } else {
+                path
+            };
+            authority
+                .connect_controller(&mut stream, &route, &controller, claimed_path)
+                .await
+        };
+        let target_run = async {
+            let mut buf = [0; 4096];
+            let size = timeout(WAIT, target_udp.recv(&mut buf)).await??;
+            let message = RendezvousMessage::parse_from_bytes(&buf[..size])?;
+            let Some(rendezvous_message::Union::DeskrealmSignal(signal)) = message.union else {
+                hbb_common::bail!("managed offer expected");
+            };
+            let (mut stream, route, actual_path) = network
+                .accept_target(&authority, &target, DEVICE_RUSTDESK_ID, signal)
+                .await?;
+            assert!(path == actual_path);
+            let relay_id = if path == Path::Relay {
+                "fixture-relay"
+            } else {
+                ""
+            };
+            let drd = bearer("drd_", 12);
+            authority
+                .connect_target(
+                    &mut stream,
+                    TargetSession {
+                        route: &route,
+                        device: &target,
+                        device_credential: &drd,
+                        path: actual_path,
+                        relay_id,
+                        policy: AppliedPolicy {
+                            version: if purpose == "policy-mismatch" { 2 } else { 1 },
+                            allowed_mask: 3,
+                            unattended_purposes: &[],
+                        },
+                    },
+                    |request| async move {
+                        assert_eq!(request.purpose, purpose);
+                        assert_eq!(request.allowed_mask, 3);
+                        selection
+                    },
+                )
+                .await
+        };
+        let (client, host) =
+            timeout(WAIT, async { tokio::join!(controller_run, target_run) }).await?;
+        if success {
+            if let Err(error) = &host {
+                eprintln!("{purpose} target: {error:#}");
+            }
+            if let Err(error) = &client {
+                eprintln!("{purpose} controller: {error:#}");
+            }
+            let client = client?;
+            let host = host?;
+            assert_eq!(client.allowed_mask, 1);
+            assert_eq!(host.allowed_mask, 1);
+            assert_eq!(client.lease_sequence, host.sequence);
+            assert_eq!(client.lease_until_ms, host.until_ms);
+            assert_eq!(host.credential(), bearer("drc_", 13));
+        } else {
+            assert!(client.is_err(), "client opened a denied session");
+            assert!(host.is_err(), "host opened a denied session");
+        }
+    }
+    Ok(())
+}
