diff --git a/libs/base/src/deskrealm_endpoint/relay_selection.rs b/libs/base/src/deskrealm_endpoint/relay_selection.rs
new file mode 100644
index 0000000..422772c
--- /dev/null
+++ b/libs/base/src/deskrealm_endpoint/relay_selection.rs
@@ -0,0 +1,287 @@
+use super::{now_ms, uuid_bytes, Authority, DeviceIdentity};
+use hbb_common::{
+    anyhow::{anyhow, bail},
+    base64::{engine::general_purpose::URL_SAFE_NO_PAD, Engine as _},
+    deskrealm_protocol::{
+        encode, PeerRole, RelayCredential, VerifiedGrant, RELAY_SELECTION, RELAY_TICKET_PROOF,
+        SESSION_TICKET_FRAME_SIZE, SESSION_TICKET_PREFIX,
+    },
+    rendezvous_proto::DeskRealmRoute,
+    sodiumoxide::crypto::{hash::sha256, sign},
+    uuid::Uuid,
+    ResultType, Stream,
+};
+use serde_derive::Deserialize;
+use tokio::{
+    io::{AsyncReadExt, AsyncWriteExt},
+    net::TcpStream,
+    time::{sleep, timeout, Duration},
+};
+
+const PAIR_WINDOW: Duration = Duration::from_secs(13);
+const ATTEMPT_TIMEOUT: Duration = Duration::from_secs(3);
+
+#[derive(Deserialize)]
+struct Selection {
+    state: String,
+    round_id: String,
+    connection_id: String,
+    selected: Option<Candidate>,
+    #[serde(default)]
+    options: Vec<Candidate>,
+    ticket: Option<Ticket>,
+}
+
+#[derive(Deserialize)]
+struct Candidate {
+    relay_id: String,
+    endpoint: String,
+    config_version: u64,
+}
+
+#[derive(Deserialize)]
+struct Ticket {
+    frame: String,
+    signature: String,
+    public_key: String,
+}
+
+struct RelaySession<'a> {
+    authority: &'a Authority,
+    device: &'a DeviceIdentity,
+    bearer: &'a str,
+    grant: VerifiedGrant<'a>,
+    session: Uuid,
+    connection: Uuid,
+    role: PeerRole,
+}
+
+impl Authority {
+    pub(crate) async fn connect_regional_relay(
+        &self,
+        route: &DeskRealmRoute,
+        device: &DeviceIdentity,
+        bearer: &str,
+        role: PeerRole,
+    ) -> ResultType<(Stream, String)> {
+        let grant = self.verify(route, device, role)?;
+        let session = RelaySession {
+            authority: self,
+            device,
+            bearer,
+            session: Uuid::from_slice(grant.session_id())?,
+            connection: Uuid::from_slice(&route.connection_uuid)?,
+            grant,
+            role,
+        };
+        // Measured samples inform the choice. Missing reports use the center's
+        // fallback policy, which still requires a signed ticket.
+        let _ = self.collect_relay_probes(route, device, bearer, role).await;
+        timeout(PAIR_WINDOW, session.connect()).await?
+    }
+}
+
+impl RelaySession<'_> {
+    async fn connect(&self) -> ResultType<(Stream, String)> {
+        let endpoint = format!("/v1/sessions/{}/relay-selection", self.session);
+        let url = self.authority.center.join(&endpoint)?;
+        let mut failed = None;
+        loop {
+            sleep(Duration::from_millis(80)).await;
+            let request = self
+                .authority
+                .client
+                .get(url.clone())
+                .query(&[("connection_id", self.connection.to_string())]);
+            let Some(mut state) = self.read_selection(request).await? else {
+                continue;
+            };
+            let round = uuid_bytes(&state.round_id)?;
+            if self.role == PeerRole::Controller {
+                match state.state.as_str() {
+                    "ready" => {
+                        let candidate = state
+                            .options
+                            .first()
+                            .ok_or_else(|| anyhow!("invalid center relay options"))?;
+                        let relay = uuid_bytes(&candidate.relay_id)?;
+                        let Some(confirmed) = self.change(&url, round, relay, "select", 1).await?
+                        else {
+                            continue;
+                        };
+                        if uuid_bytes(&confirmed.round_id)? != round {
+                            bail!("center changed regional relay round");
+                        }
+                        state = confirmed;
+                    }
+                    "exhausted" => bail!("no eligible regional relay"),
+                    "unavailable" => {
+                        let selected = state
+                            .selected
+                            .as_ref()
+                            .ok_or_else(|| anyhow!("invalid center relay selection"))?;
+                        let relay = uuid_bytes(&selected.relay_id)?;
+                        self.change(&url, round, relay, "fail", 2).await?;
+                        continue;
+                    }
+                    _ => {}
+                }
+            }
+            if state.state != "confirmed" {
+                continue;
+            }
+            let (Some(candidate), Some(ticket)) = (state.selected, state.ticket) else {
+                bail!("center omitted a confirmed relay ticket");
+            };
+            let relay = uuid_bytes(&candidate.relay_id)?;
+            if failed == Some(relay) {
+                if self.role == PeerRole::Controller {
+                    self.change(&url, round, relay, "fail", 2).await?;
+                }
+                continue;
+            }
+            match timeout(ATTEMPT_TIMEOUT, self.join(round, relay, &candidate, ticket)).await {
+                Ok(Ok((stream, signature))) => {
+                    if self.role == PeerRole::Target {
+                        let endpoint = format!("/v1/sessions/{}/relay-pairing", self.session);
+                        self.authority
+                            .post(
+                                &endpoint,
+                                self.bearer,
+                                serde_json::json!({
+                                    "connection_id": self.connection.to_string(),
+                                    "round_id": round.to_string(),
+                                    "relay_id": candidate.relay_id,
+                                    "signature": URL_SAFE_NO_PAD.encode(signature),
+                                }),
+                                &[204],
+                            )
+                            .await?;
+                    }
+                    return Ok((stream, candidate.relay_id));
+                }
+                _ => {
+                    failed = Some(relay);
+                    if self.role == PeerRole::Controller {
+                        self.change(&url, round, relay, "fail", 2).await?;
+                    }
+                }
+            }
+        }
+    }
+
+    async fn read_selection(
+        &self,
+        request: reqwest::RequestBuilder,
+    ) -> ResultType<Option<Selection>> {
+        let response = request
+            .bearer_auth(self.bearer)
+            .send()
+            .await
+            .map_err(|_| anyhow!("center relay selection unavailable"))?;
+        if response.status() == reqwest::StatusCode::CONFLICT {
+            // The center closes the probe window and commits selections using
+            // its own clock. A concurrent health change also returns conflict.
+            return Ok(None);
+        }
+        if response.status() != reqwest::StatusCode::OK {
+            bail!("center denied relay selection");
+        }
+        let state: Selection =
+            serde_json::from_slice(&Authority::read_response_body(response, 128 * 1024).await?)?;
+        if uuid_bytes(&state.connection_id)? != self.connection {
+            bail!("center returned another relay connection");
+        }
+        Ok(Some(state))
+    }
+
+    async fn change(
+        &self,
+        url: &reqwest::Url,
+        round: Uuid,
+        relay: Uuid,
+        action: &str,
+        code: u8,
+    ) -> ResultType<Option<Selection>> {
+        let frame = encode(
+            RELAY_SELECTION,
+            &[
+                &[code],
+                self.grant.session_id(),
+                self.grant.grant_id(),
+                self.connection.as_bytes(),
+                round.as_bytes(),
+                relay.as_bytes(),
+            ],
+        )
+        .ok_or_else(|| anyhow!("invalid relay selection frame"))?;
+        self.read_selection(
+            self.authority
+                .client
+                .post(url.clone())
+                .json(&serde_json::json!({
+                    "connection_id": self.connection.to_string(),
+                    "round_id": round.to_string(),
+                    "relay_id": relay.to_string(),
+                    "action": action,
+                    "signature": URL_SAFE_NO_PAD.encode(self.device.sign(&frame)),
+                })),
+        )
+        .await
+    }
+
+    async fn join(
+        &self,
+        round: Uuid,
+        relay: Uuid,
+        candidate: &Candidate,
+        ticket: Ticket,
+    ) -> ResultType<(Stream, [u8; sign::SIGNATUREBYTES])> {
+        let frame = URL_SAFE_NO_PAD.decode(ticket.frame)?;
+        let signature = URL_SAFE_NO_PAD.decode(ticket.signature)?;
+        let key = sign::PublicKey::from_slice(&URL_SAFE_NO_PAD.decode(ticket.public_key)?)
+            .ok_or_else(|| anyhow!("invalid regional relay key"))?;
+        let signed = RelayCredential::verify_ticket(&frame, &signature, &self.authority.center_key)
+            .ok_or_else(|| anyhow!("invalid center relay ticket"))?;
+        if frame.len() != SESSION_TICKET_FRAME_SIZE
+            || signed.session != self.grant.session_id()
+            || signed.grant != self.grant.grant_id()
+            || signed.connection != self.connection.as_bytes()
+            || signed.round != round.as_bytes()
+            || signed.node != *relay.as_bytes()
+            || signed.version != candidate.config_version
+            || signed.endpoint != sha256::hash(candidate.endpoint.as_bytes())
+            || signed.role != self.role as u8
+            || signed.holder != self.device.public_key
+            || !signed.active(now_ms()?)
+        {
+            bail!("relay ticket does not match this endpoint's session");
+        }
+        let mut socket = TcpStream::connect(&candidate.endpoint).await?;
+        socket.set_nodelay(true)?;
+        socket.write_all(SESSION_TICKET_PREFIX).await?;
+        socket.write_all(&frame).await?;
+        socket.write_all(&signature).await?;
+        let mut nonce = [0; 32];
+        socket.read_exact(&mut nonce).await?;
+        let digest = sha256::hash(&frame);
+        let proof = encode(RELAY_TICKET_PROOF, &[digest.as_ref(), &nonce])
+            .ok_or_else(|| anyhow!("invalid relay holder frame"))?;
+        socket.write_all(&self.device.sign(&proof)).await?;
+        let mut receipt = [0; sign::SIGNATUREBYTES];
+        socket.read_exact(&mut receipt).await?;
+        let Ok(signature) = sign::Signature::from_bytes(&receipt) else {
+            bail!("invalid regional relay pairing signature");
+        };
+        let paired = signed
+            .pair_receipt_frame()
+            .ok_or_else(|| anyhow!("invalid regional relay pairing frame"))?;
+        if !sign::verify_detached(&signature, &paired, &key) || !signed.active(now_ms()?) {
+            bail!("invalid regional relay pairing receipt");
+        }
+        let addr = socket.local_addr()?;
+        let mut stream = Stream::from(socket, addr);
+        stream.set_max_packet_length(4096);
+        Ok((stream, receipt))
+    }
+}
