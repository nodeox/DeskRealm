+    socket.connect(network.rendezvous).await?;
+    let mut registration = RendezvousMessage::new();
+    registration.set_register_pk(RegisterPk {
+        id: TARGET.to_owned(),
+        uuid: Bytes::copy_from_slice(target.id.as_bytes()),
+        pk: Bytes::copy_from_slice(target.public_key.as_ref()),
+        ..Default::default()
+    });
+    socket.send(&registration.write_to_bytes()?).await?;
+    let mut packet = [0; 4096];
+    let size = timeout(WAIT, socket.recv(&mut packet)).await??;
+    let reply = RendezvousMessage::parse_from_bytes(&packet[..size])?;
+    ensure!(
+        reply.has_register_pk_response()
+            && reply.register_pk_response().result.enum_value()
+                == Ok(register_pk_response::Result::OK),
+        "target did not register with native hbbs"
+    );
+
+    // RegisterPk acknowledges an unchanged key without refreshing the UDP endpoint.
+    registration.set_register_peer(RegisterPeer { id: TARGET.to_owned(), ..Default::default() });
+    socket.send(&registration.write_to_bytes()?).await?;
+    let size = timeout(WAIT, socket.recv(&mut packet)).await??;
+    let reply = RendezvousMessage::parse_from_bytes(&packet[..size])?;
+    ensure!(reply.has_register_peer_response() && !reply.register_peer_response().request_pk);
+
+    let route = authority
+        .issue(
