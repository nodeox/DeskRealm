+    left.send_raw(payload.to_vec()).await?;
+    let forwarded = timeout(WAIT, right.next())
+        .await?
+        .ok_or_else(|| anyhow!("regional relay disconnected"))??;
+    ensure!(
+        forwarded.as_ref() == payload.as_ref(),
