+            &input.controller.credential,
+            SessionTarget::RustDeskId(TARGET),
+            Uuid::new_v4(),
+            "helpdesk",
+            1,
+            true,
+        )
+        .await?;
+    let (left, right) = timeout(WAIT, async {
+        tokio::join!(
+            async {
+                let mut stream = network
+                    .connect_controller_with_selection(
