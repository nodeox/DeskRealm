diff --git a/src/server/managed_audio.rs b/src/server/managed_audio.rs
new file mode 100644
index 0000000..7a29273
--- /dev/null
+++ b/src/server/managed_audio.rs
@@ -0,0 +1,217 @@
+//! System-output audio after a managed session has been redeemed.
+
+#[cfg(windows)]
+use base::deskrealm_endpoint::ManagedAction;
+#[cfg(any(windows, test))]
+use base::message_proto::message;
+use base::{
+    deskrealm_endpoint::SessionAccess,
+    message_proto::{misc, AudioFormat, Message},
+};
+use hbb_common::{tokio::sync::mpsc, ResultType};
+use std::{sync::Arc, time::Instant};
+
+const MAX_OPUS_BYTES: usize = 4096;
+
+pub(crate) fn valid_format(format: &AudioFormat) -> bool {
+    matches!(format.channels, 1 | 2)
+        && matches!(format.sample_rate, 8000 | 12000 | 16000 | 24000 | 48000)
+}
+
+pub(crate) fn valid_frame(data: &[u8]) -> bool {
+    !data.is_empty() && data.len() <= MAX_OPUS_BYTES
+}
+
+#[cfg(windows)]
+pub(crate) fn available() -> bool {
+    super::managed_input::available()
+}
+
+#[cfg(not(windows))]
+pub(crate) fn available() -> bool {
+    false
+}
+
+pub(super) struct Packet {
+    pub generation: u64,
+    pub queued_at: Instant,
+    pub format: Arc<Message>,
+    pub frame: Arc<Message>,
+}
+
+#[cfg(windows)]
+pub(super) struct Feed {
+    generation: u64,
+    format: Arc<Message>,
+    sender: mpsc::Sender<Packet>,
+    access: SessionAccess,
+}
+
+#[cfg(windows)]
+impl Feed {
+    pub(super) fn new(
+        generation: u64,
+        format: Arc<Message>,
+        sender: mpsc::Sender<Packet>,
+        access: SessionAccess,
+    ) -> Self {
+        Self {
+            generation,
+            format,
+            sender,
+            access,
+        }
+    }
+
+    pub(super) fn send(&self, frame: Arc<Message>) {
+        if self.access.generation(ManagedAction::Audio) == Some(self.generation) {
+            push(&self.sender, self.generation, &self.format, frame);
+        }
+    }
+}
+
+#[cfg(any(windows, test))]
+fn push(
+    sender: &mpsc::Sender<Packet>,
+    generation: u64,
+    format: &Arc<Message>,
+    frame: Arc<Message>,
+) {
+    if matches!(&frame.union, Some(message::Union::AudioFrame(audio)) if valid_frame(&audio.data)) {
+        let _ = sender.try_send(Packet {
+            generation,
+            queued_at: Instant::now(),
+            format: format.clone(),
+            frame,
+        });
+    }
+}
+
+pub(super) fn is_current(packet: &Packet, generation: Option<u64>) -> bool {
+    generation == Some(packet.generation) && packet.queued_at.elapsed().as_millis() < 150
+}
+
+pub(crate) fn format(message: &Message) -> Option<&AudioFormat> {
+    if let Some(misc::Union::AudioFormat(format)) = message.misc().union.as_ref() {
+        return valid_format(format).then_some(format);
+    }
+    None
+}
+
+pub(super) struct Capture {
+    #[cfg(windows)]
+    stop: Option<std::sync::mpsc::Sender<()>>,
+    #[cfg(windows)]
+    worker: Option<std::thread::JoinHandle<()>>,
+}
+
+impl Capture {
+    #[cfg(windows)]
+    pub(super) fn start(
+        id: i32,
+        access: SessionAccess,
+        sender: mpsc::Sender<Packet>,
+    ) -> ResultType<Self> {
+        use hbb_common::anyhow::anyhow;
+        if !access.permits(ManagedAction::Audio) || !available() {
+            return Err(anyhow!("managed system audio is not authorized"));
+        }
+        let (stop, stopped) = std::sync::mpsc::channel();
+        let worker = std::thread::Builder::new()
+            .name("managed-audio-capture".into())
+            .spawn(move || {
+                if let Err(error) =
+                    super::audio_service::capture_managed_output(id, access, sender, stopped)
+                {
+                    hbb_common::log::debug!("managed audio capture stopped: {error}");
+                }
+            })?;
+        Ok(Self {
+            stop: Some(stop),
+            worker: Some(worker),
+        })
+    }
+
+    #[cfg(not(windows))]
+    pub(super) fn start(
+        _id: i32,
+        _access: SessionAccess,
+        _sender: mpsc::Sender<Packet>,
+    ) -> ResultType<Self> {
+        hbb_common::bail!("managed system audio requires Windows");
+    }
+
+    pub(super) fn stop(&mut self) -> ResultType<()> {
+        #[cfg(windows)]
+        {
+            self.stop.take();
+            if let Some(worker) = self.worker.take() {
+                worker
+                    .join()
+                    .map_err(|_| hbb_common::anyhow::anyhow!("managed audio capture panicked"))?;
+            }
+        }
+        Ok(())
+    }
+}
+
+impl Drop for Capture {
+    fn drop(&mut self) {
+        if let Err(error) = self.stop() {
+            hbb_common::log::error!("managed audio cleanup: {error}");
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use base::message_proto::{AudioFrame, Misc};
+    use magnum_opus::{Application, Channels, Decoder, Encoder};
+    use std::time::Duration;
+
+    #[test]
+    fn managed_audio_keeps_format_with_each_bounded_packet_and_drops_stale_audio() -> ResultType<()>
+    {
+        let mut header = Message::new();
+        let mut control = Misc::new();
+        control.set_audio_format(AudioFormat {
+            sample_rate: 48000,
+            channels: 2,
+            ..Default::default()
+        });
+        header.set_misc(control);
+        let header = Arc::new(header);
+        let mut encoder = Encoder::new(48000, Channels::Stereo, Application::LowDelay)?;
+        let pcm: Vec<f32> = (0..960).map(|n| (n as f32 / 13.0).sin() * 0.5).collect();
+        let opus = encoder.encode_vec_float(&pcm, MAX_OPUS_BYTES)?;
+        let mut frame = Message::new();
+        frame.set_audio_frame(AudioFrame {
+            data: opus.into(),
+            ..Default::default()
+        });
+        let (sender, mut receiver) = mpsc::channel(1);
+
+        push(&sender, 4, &header, Arc::new(Message::new()));
+        assert!(receiver.try_recv().is_err());
+        push(&sender, 4, &header, Arc::new(frame.clone()));
+        push(&sender, 4, &header, Arc::new(frame));
+        let mut packet = receiver.try_recv()?;
+        assert!(receiver.try_recv().is_err());
+        assert!(!is_current(&packet, None));
+        assert!(!is_current(&packet, Some(5)));
+        assert_eq!(format(&packet.format).unwrap().sample_rate, 48000);
+        assert!(is_current(&packet, Some(4)));
+
+        let mut decoder = Decoder::new(48000, Channels::Stereo)?;
+        let mut decoded = [0.0; 960];
+        assert_eq!(
+            decoder.decode_float(&packet.frame.audio_frame().data, &mut decoded, false)?,
+            480
+        );
+        assert!(decoded.iter().any(|sample| sample.abs() > 0.01));
+        packet.queued_at = Instant::now() - Duration::from_millis(200);
+        assert!(!is_current(&packet, Some(4)));
+        Ok(())
+    }
+}
