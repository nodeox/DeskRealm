+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+struct ManagedPlayback {
+    sender: mpsc::SyncSender<(AudioFormat, AudioFrame)>,
+    stopped: Arc<std::sync::atomic::AtomicBool>,
+}
+
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+impl ManagedPlayback {
+    fn start() -> ResultType<Self> {
+        use std::sync::atomic::{AtomicBool, Ordering};
+
+        let stopped = Arc::new(AtomicBool::new(false));
+        let cancelled = stopped.clone();
+        let (sender, receiver) = mpsc::sync_channel(8);
+        std::thread::Builder::new()
+            .name("managed-audio-playback".into())
+            .spawn(move || {
+                let mut output = AudioHandler::default();
+                let mut installed = false;
+                while let Ok((format, frame)) = receiver.recv() {
+                    if cancelled.load(Ordering::Acquire) {
+                        break;
+                    }
+                    if !installed {
+                        output.handle_format(format);
+                        installed = true;
+                    }
+                    if !cancelled.load(Ordering::Acquire) {
+                        output.handle_frame(frame);
+                    }
+                }
+            })?;
+        Ok(Self { sender, stopped })
+    }
+
+    fn enqueue(&self, format: &AudioFormat, frame: AudioFrame) {
+        let _ = self.sender.try_send((format.clone(), frame));
+    }
+}
+
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+impl Drop for ManagedPlayback {
+    fn drop(&mut self) {
+        self.stopped.store(true, std::sync::atomic::Ordering::Release);
+    }
+}
