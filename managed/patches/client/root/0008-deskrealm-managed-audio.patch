+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+#[derive(Default)]
+struct ManagedAudio {
+    enabled: bool,
+    playback: Option<super::ManagedPlayback>,
+    format: Option<AudioFormat>,
+}
+
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+impl ManagedAudio {
+    // Returns true for audio media, which must bypass the legacy playback queue.
+    fn handle(&mut self, message: &mut Message, admitted: bool, connected: bool, muted: bool) -> bool {
+        use crate::server::managed_audio;
+
+        if let Some(misc::Union::PermissionInfo(permission)) = message.misc().union.as_ref() {
+            if permission.permission.enum_value() == Ok(Permission::Audio) {
+                self.enabled = admitted && permission.enabled;
+                if !self.enabled {
+                    self.playback.take();
+                    self.format.take();
+                }
+            }
+        }
+
+        if muted {
+            self.playback.take();
+        }
+        if message.misc().has_audio_format() {
+            if self.enabled && connected {
+                self.format = managed_audio::format(message).cloned();
+                // Drop queued data and decoded PCM from the previous capture generation.
+                self.playback.take();
+            }
+            return true;
+        }
+        if !message.has_audio_frame() {
+            return false;
+        }
+        if self.enabled && connected && !muted && managed_audio::valid_frame(&message.audio_frame().data) {
+            if let Some(format) = self.format.as_ref() {
+                if self.playback.is_none() {
+                    self.playback = super::ManagedPlayback::start().ok();
+                }
+                if let Some(playback) = &self.playback {
+                    playback.enqueue(format, message.take_audio_frame());
+                }
+            }
+        }
+        true
+    }
+}
+
+#[cfg(all(test, not(any(target_os = "android", target_os = "ios"))))]
+#[test]
+fn managed_audio_requires_independent_permission_and_valid_format() {
+    use base::deskrealm_endpoint::ManagedAction;
+    let mut audio = ManagedAudio::default();
+    let mut message = Message::new();
+    message.mut_misc().set_permission_info(PermissionInfo {
+        permission: Permission::Audio.into(), enabled: true, ..Default::default()
+    });
+    assert!(!managed_view_response(&message, false, ManagedAction::Input as u8));
+    assert!(managed_view_response(&message, false, ManagedAction::Audio as u8));
+    assert!(!audio.handle(&mut message, false, true, false));
+    assert!(!audio.enabled);
+    assert!(!audio.handle(&mut message, true, true, false));
+    assert!(audio.enabled);
+    message.mut_misc().set_audio_format(AudioFormat {
+        sample_rate: 48000, channels: 2, ..Default::default()
+    });
+    assert!(audio.handle(&mut message, true, true, true));
+    assert!(audio.format.is_some());
+    message.mut_misc().mut_audio_format().channels = 16;
+    assert!(audio.handle(&mut message, true, true, false));
+    assert!(audio.format.is_none());
+    message.set_audio_frame(AudioFrame { data: vec![1; 5000].into(), ..Default::default() });
+    assert!(audio.handle(&mut message, true, true, false));
+    assert!(audio.playback.is_none());
+    message.mut_misc().set_audio_format(AudioFormat {
+        sample_rate: 48000,
+        channels: 2,
+        ..Default::default()
+    });
+    assert!(audio.handle(&mut message, true, true, false));
+    assert!(audio.format.is_some());
+    message.mut_misc().set_permission_info(PermissionInfo {
+        permission: Permission::Audio.into(),
+        enabled: false,
+        ..Default::default()
+    });
+    assert!(!audio.handle(&mut message, true, true, false));
+    assert!(!audio.enabled);
+    assert!(audio.format.is_none());
 }
 
