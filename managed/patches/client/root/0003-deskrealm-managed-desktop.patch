+// The RustDesk service may run in Session 0. Send the prompt to the
+// unlocked physical console, and accept only an explicit Yes from that seat.
+pub(crate) fn confirm_deskrealm_consent(message: &str) -> bool {
+    use windows::{
+        core::PCWSTR,
+        Win32::{
+            System::RemoteDesktop::{WTSGetActiveConsoleSessionId, WTSSendMessageW},
+            UI::WindowsAndMessaging::{
+                IDYES, MB_DEFBUTTON2, MB_ICONWARNING, MB_YESNO, MESSAGEBOX_RESULT,
+            },
+        },
+    };
+
+    let session = unsafe { WTSGetActiveConsoleSessionId() };
+    let available = || {
+        session != 0 && session != u32::MAX
+            && (unsafe { WTSGetActiveConsoleSessionId() }) == session
+            && is_session_prelogin(session) == Some(false)
+            && is_session_locked_flag(session) == Some(false)
+    };
+    if !available() {
+        return false;
+    }
+    let title: Vec<u16> = "DeskRealm 远程访问确认".encode_utf16().chain([0]).collect();
+    let body: Vec<u16> = message.encode_utf16().chain([0]).collect();
+    let title_bytes = ((title.len() - 1) * std::mem::size_of::<u16>()) as u32;
+    let body_bytes = ((body.len() - 1) * std::mem::size_of::<u16>()) as u32;
+    let mut response = MESSAGEBOX_RESULT::default();
+    let displayed = unsafe {
+        WTSSendMessageW(
+            None,
+            session,
+            PCWSTR(title.as_ptr()),
+            title_bytes,
+            PCWSTR(body.as_ptr()),
+            body_bytes,
+            MB_YESNO | MB_DEFBUTTON2 | MB_ICONWARNING,
+            25,
+            &mut response,
+            true,
+        )
+    };
+    displayed.is_ok() && response == IDYES && available()
+}
