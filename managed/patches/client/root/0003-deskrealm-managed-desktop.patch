diff --git a/src/deskrealm_desktop.rs b/src/deskrealm_desktop.rs
new file mode 100644
index 0000000..cb3c426
--- /dev/null
+++ b/src/deskrealm_desktop.rs
@@ -0,0 +1,436 @@
+//! Wires the desktop process to managed admission without legacy transport fallback.
+
+use base::{
+    deskrealm_endpoint::{
+        AppliedPolicy, Authority, DeviceCredential, DeviceIdentity, InstalledPolicy, LocalConsent,
+        TargetSession,
+    },
+    deskrealm_transport::{Network, RelayNode},
+};
+use hbb_common::{
+    anyhow::{anyhow, bail},
+    base64::{engine::general_purpose::URL_SAFE_NO_PAD, Engine as _},
+    bytes::Bytes,
+    config::{option2bool, Config},
+    deskrealm_protocol::{valid_rustdesk_id, Path, PeerRole},
+    protobuf::Message as _,
+    rendezvous_proto::{rendezvous_message, DeskRealmSignal, RegisterPk, RendezvousMessage},
+    sodiumoxide::crypto::sign,
+    tokio::{
+        self,
+        net::{lookup_host, UdpSocket},
+        sync::Semaphore,
+        time::{interval, timeout, MissedTickBehavior},
+    },
+    uuid::Uuid,
+    ResultType,
+};
+use std::{
+    env, fs::File, io::Read, net::SocketAddr, path::Path as FilePath, sync::Arc, time::Duration,
+};
+
+const SETTINGS: &[&str] = &[
+    "DESKREALM_MANAGED_MODE",
+    "DESKREALM_MANAGED_CENTER",
+    "DESKREALM_MANAGED_CENTER_KID",
+    "DESKREALM_MANAGED_CENTER_PUBLIC_KEY",
+    "DESKREALM_MANAGED_CA_FILE",
+    "DESKREALM_MANAGED_DEVICE_ID",
+    "DESKREALM_MANAGED_ORGANIZATION_ID",
+    "DESKREALM_MANAGED_DEVICE_SEED_FILE",
+    "DESKREALM_MANAGED_RUSTDESK_ID",
+    "DESKREALM_MANAGED_RENDEZVOUS_ADDRESS",
+    "DESKREALM_MANAGED_RELAY_ADDRESS",
+    "DESKREALM_MANAGED_RELAY_ID",
+    "DESKREALM_MANAGED_CONTROLLER_CREDENTIAL_FILE",
+    "DESKREALM_MANAGED_PURPOSE",
+];
+const ONLINE_INTERVAL: Duration = Duration::from_secs(12);
+const REGISTRATION_INTERVAL: Duration = Duration::from_secs(8);
+const REFRESH_MARGIN: Duration = Duration::from_secs(120);
+const LOOKUP_TIMEOUT: Duration = Duration::from_secs(5);
+
+pub(crate) fn enabled() -> bool {
+    cfg!(feature = "deskrealm-managed") || SETTINGS.iter().any(|var| env::var_os(var).is_some())
+}
+
+fn required(name: &'static str) -> ResultType<String> {
+    optional(name)?.ok_or_else(|| anyhow!("missing managed configuration: {}", name))
+}
+
+fn optional(name: &'static str) -> ResultType<Option<String>> {
+    match env::var(name) {
+        Ok(value) if !value.is_empty() => Ok(Some(value)),
+        Ok(_) | Err(env::VarError::NotPresent) => Ok(None),
+        Err(_) => bail!("invalid managed configuration: {}", name),
+    }
+}
+
+fn read_limited(path: &str, limit: u64) -> ResultType<Vec<u8>> {
+    let mut buffer = Vec::new();
+    File::open(FilePath::new(path))
+        .and_then(|file| file.take(limit + 1).read_to_end(&mut buffer))
+        .map_err(|_| anyhow!("managed configuration file is unavailable"))?;
+    if buffer.is_empty() || buffer.len() as u64 > limit {
+        bail!("invalid managed configuration file");
+    }
+    Ok(buffer)
+}
+
+fn decode_key(input: &str) -> ResultType<[u8; 32]> {
+    let decoded = URL_SAFE_NO_PAD
+        .decode(input)
+        .map_err(|_| anyhow!("invalid managed key"))?;
+    decoded
+        .try_into()
+        .map_err(|_| anyhow!("invalid managed key"))
+}
+
+async fn resolve(authority: &str) -> ResultType<SocketAddr> {
+    let mut addresses = timeout(LOOKUP_TIMEOUT, lookup_host(authority))
+        .await
+        .map_err(|_| anyhow!("managed server lookup timed out"))?
+        .map_err(|_| anyhow!("invalid managed server address"))?;
+    addresses
+        .find(|addr| addr.port() != 0 && !addr.ip().is_unspecified() && !addr.ip().is_multicast())
+        .ok_or_else(|| anyhow!("managed server address is unavailable"))
+}
+
+struct Relay {
+    id: String,
+    authority: String,
+    address: SocketAddr,
+}
+
+pub(crate) struct Desktop {
+    authority: Authority,
+    device: DeviceIdentity,
+    organization: Uuid,
+    rustdesk_id: String,
+    rendezvous: SocketAddr,
+    relay: Option<Relay>,
+}
+
+impl Desktop {
+    async fn configured() -> ResultType<Self> {
+        if optional("DESKREALM_MANAGED_MODE")?.as_deref() != Some("1") {
+            bail!("managed desktop configuration is incomplete");
+        }
+        let device = required("DESKREALM_MANAGED_DEVICE_ID")?.parse()?;
+        let organization = required("DESKREALM_MANAGED_ORGANIZATION_ID")?.parse()?;
+        let seed = read_limited(&required("DESKREALM_MANAGED_DEVICE_SEED_FILE")?, 128)?;
+        let device = DeviceIdentity::from_seed(
+            device,
+            &sign::Seed(decode_key(std::str::from_utf8(&seed)?.trim())?),
+        )?;
+        let rustdesk_id = required("DESKREALM_MANAGED_RUSTDESK_ID")?;
+        if !valid_rustdesk_id(&rustdesk_id) {
+            bail!("invalid managed RustDesk ID");
+        }
+        let key = sign::PublicKey(decode_key(&required(
+            "DESKREALM_MANAGED_CENTER_PUBLIC_KEY",
+        )?)?);
+        let ca = optional("DESKREALM_MANAGED_CA_FILE")?
+            .map(|path| read_limited(&path, 128 * 1024))
+            .transpose()?;
+        let authority = Authority::new(
+            &required("DESKREALM_MANAGED_CENTER")?,
+            required("DESKREALM_MANAGED_CENTER_KID")?,
+            key,
+            ca.as_deref(),
+        )?;
+        let rendezvous = resolve(&required("DESKREALM_MANAGED_RENDEZVOUS_ADDRESS")?).await?;
+        let relay = match (
+            optional("DESKREALM_MANAGED_RELAY_ID")?,
+            optional("DESKREALM_MANAGED_RELAY_ADDRESS")?,
+        ) {
+            (None, None) => None,
+            (Some(id), Some(authority)) => Some(Relay {
+                id,
+                address: resolve(&authority).await?,
+                authority,
+            }),
+            _ => bail!("managed relay configuration is incomplete"),
+        };
+        Ok(Self {
+            authority,
+            device,
+            organization,
+            rustdesk_id,
+            rendezvous,
+            relay,
+        })
+    }
+
+    fn network(&self) -> Network<'_> {
+        Network {
+            rendezvous: self.rendezvous,
+            relay: self.relay.as_ref().map(|relay| RelayNode {
+                authority: &relay.authority,
+                address: relay.address,
+            }),
+        }
+    }
+
+    async fn refresh(&self, previous: Option<Arc<Runtime>>) -> ResultType<Runtime> {
+        let credential = match previous {
+            Some(previous) if !previous.credential.expires_within(REFRESH_MARGIN) => {
+                previous.credential.clone()
+            }
+            _ => Arc::new(
+                self.authority
+                    .authenticate_device(&self.device, self.organization)
+                    .await?,
+            ),
+        };
+        self.authority
+            .heartbeat(&credential, crate::VERSION)
+            .await?;
+        let policy = self
+            .authority
+            .install_policy(&self.device, &credential)
+            .await?;
+        Ok(Runtime { credential, policy })
+    }
+}
+
+pub(crate) async fn connect(peer: &str, force_relay: bool) -> ResultType<()> {
+    if hbb_common::config::is_incoming_only() {
+        bail!("managed controller is unavailable in incoming-only mode");
+    }
+    let desktop = Desktop::configured().await?;
+    let credential = desktop
+        .authority
+        .authenticate_device(&desktop.device, desktop.organization)
+        .await?;
+    desktop
+        .authority
+        .heartbeat(&credential, crate::VERSION)
+        .await?;
+    let bearer = read_limited(
+        &required("DESKREALM_MANAGED_CONTROLLER_CREDENTIAL_FILE")?,
+        128,
+    )?;
+    let purpose = optional("DESKREALM_MANAGED_PURPOSE")?.unwrap_or_else(|| "helpdesk".to_owned());
+    let path = if force_relay {
+        Path::Relay
+    } else {
+        Path::Direct
+    };
+    let route = desktop
+        .authority
+        .issue(
+            &desktop.device,
+            std::str::from_utf8(&bearer)?.trim(),
+            peer,
+            Uuid::new_v4(),
+            &purpose,
+            3,
+            true,
+        )
+        .await?;
+    let grant = desktop
+        .authority
+        .verify(&route, &desktop.device, PeerRole::Controller)?;
+    if grant.organization_id() != desktop.organization.as_bytes() {
+        bail!("managed grant belongs to a different organization");
+    }
+    let mut stream = desktop
+        .network()
+        .connect_controller(&desktop.authority, &desktop.device, &route, path)
+        .await?;
+    desktop
+        .authority
+        .connect_controller(&mut stream, &route, &desktop.device, path)
+        .await?;
+    // Managed admission intentionally does not return a stream to the legacy
+    // session dispatcher. Operation and lease enforcement will own this handoff.
+    Ok(())
+}
+
+pub(crate) struct Runtime {
+    credential: Arc<DeviceCredential>,
+    policy: Option<InstalledPolicy>,
+}
+
+pub(crate) async fn serve() -> ResultType<()> {
+    let desktop = Arc::new(Desktop::configured().await?);
+    let address = if desktop.rendezvous.is_ipv4() {
+        "0.0.0.0:0"
+    } else {
+        "[::]:0"
+    };
+    let socket = UdpSocket::bind(address).await?;
+    socket.connect(desktop.rendezvous).await?;
+    let mut registration = RendezvousMessage::new();
+    registration.set_register_pk(RegisterPk {
+        id: desktop.rustdesk_id.clone(),
+        uuid: Bytes::copy_from_slice(desktop.device.id.as_bytes()),
+        pk: Bytes::copy_from_slice(desktop.device.public_key.as_ref()),
+        ..Default::default()
+    });
+    let registration = registration.write_to_bytes()?;
+    let mut registration_timer = interval(REGISTRATION_INTERVAL);
+    registration_timer.set_missed_tick_behavior(MissedTickBehavior::Skip);
+    let mut center_timer = interval(ONLINE_INTERVAL);
+    center_timer.set_missed_tick_behavior(MissedTickBehavior::Skip);
+    let pending = Arc::new(Semaphore::new(8));
+    let prompts = Arc::new(Semaphore::new(1));
+    let mut runtime = None;
+    let mut bytes = [0u8; 4096];
+    loop {
+        tokio::select! {
+            _ = registration_timer.tick() => {
+                if !stopped() {
+                    socket.send(&registration).await?;
+                }
+            }
+            _ = center_timer.tick() => {
+                runtime = if stopped() {
+                    None
+                } else {
+                    match desktop.refresh(runtime.take()).await {
+                        Ok(state) => Some(Arc::new(state)),
+                        Err(_) => {
+                            hbb_common::log::warn!("managed device or policy refresh failed");
+                            None
+                        }
+                    }
+                };
+            }
+            size = socket.recv(&mut bytes) => {
+                let size = size?;
+                let Some(state) = runtime.as_ref().filter(|state| state.policy.is_some()) else { continue };
+                if stopped() || size == bytes.len() { continue; }
+                let Ok(message) = RendezvousMessage::parse_from_bytes(&bytes[..size]) else { continue };
+                let Some(rendezvous_message::Union::DeskrealmSignal(signal)) = message.union else { continue };
+                let Ok(permit) = pending.clone().try_acquire_owned() else { continue };
+                let desktop = desktop.clone();
+                let state = state.clone();
+                let prompts = prompts.clone();
+                tokio::spawn(async move {
+                    let _permit = permit;
+                    if let Err(error) = crate::server::create_managed_tcp_connection(desktop, state, signal, prompts).await {
+                        hbb_common::log::debug!("managed connection closed: {}", error);
+                    }
+                });
+            }
+        }
+    }
+}
+
+fn stopped() -> bool {
+    option2bool("stop-service", &Config::get_option("stop-service"))
+        || crate::platform::installing_service()
+}
+
+pub(crate) async fn authorize_target(
+    desktop: &Desktop,
+    state: &Runtime,
+    signal: DeskRealmSignal,
+    prompts: Arc<Semaphore>,
+) -> ResultType<()> {
+    let route = signal
+        .route
+        .as_ref()
+        .ok_or_else(|| anyhow!("managed route is missing"))?;
+    let grant = desktop
+        .authority
+        .verify(route, &desktop.device, PeerRole::Target)?;
+    if grant.organization_id() != desktop.organization.as_bytes()
+        || stopped()
+        || state.credential.expires_within(Duration::ZERO)
+    {
+        bail!("managed target is unavailable");
+    }
+    let policy = state
+        .policy
+        .as_ref()
+        .ok_or_else(|| anyhow!("no managed policy applied"))?;
+    if grant.policy_version() != policy.version()
+        || grant.allowed_mask() & !policy.allowed_mask() != 0
+    {
+        bail!("managed grant does not match locally applied policy");
+    }
+    let (mut stream, route, path) = desktop
+        .network()
+        .accept_target(
+            &desktop.authority,
+            &desktop.device,
+            &desktop.rustdesk_id,
+            signal,
+        )
+        .await?;
+    let unattended = policy
+        .unattended_purposes()
+        .iter()
+        .map(String::as_str)
+        .collect::<Vec<_>>();
+    let relay_id = if path == Path::Relay {
+        &desktop
+            .relay
+            .as_ref()
+            .ok_or_else(|| anyhow!("managed relay is not configured"))?
+            .id
+    } else {
+        ""
+    };
+    let lease = desktop
+        .authority
+        .connect_target(
+            &mut stream,
+            TargetSession {
+                route: &route,
+                device: &desktop.device,
+                device_credential: state.credential.bearer(),
+                path,
+                relay_id,
+                policy: AppliedPolicy {
+                    version: policy.version(),
+                    allowed_mask: policy.allowed_mask(),
+                    unattended_purposes: &unattended,
+                },
+            },
+            |request| async move { ask_local_user(request, prompts).await },
+        )
+        .await?;
+    // Keep the data channel out of the legacy input and media dispatcher until
+    // managed operations and the local lease deadline are enforced there.
+    drop(stream);
+    desktop.authority.report_local_end(&lease).await
+}
+
+async fn ask_local_user(request: LocalConsent, prompts: Arc<Semaphore>) -> Option<u8> {
+    if stopped() {
+        return None;
+    }
+    let permit = prompts.try_acquire_owned().ok()?;
+    tokio::task::spawn_blocking(move || {
+        // Keep the permit until the native dialog has closed, even if the
+        // networking task is cancelled while waiting for it.
+        let _permit = permit;
+        #[cfg(target_os = "windows")]
+        {
+            let names = ["查看画面", "键鼠控制", "音频", "剪贴板", "文件传输"];
+            let operations = names
+                .iter()
+                .enumerate()
+                .filter_map(|(bit, name)| (request.allowed_mask & (1 << bit) != 0).then_some(*name))
+                .collect::<Vec<_>>()
+                .join("、");
+            let text = format!(
+                "是否允许本次受管会话？\n\n主控用户 {}\n主控设备 {}\n用途 {}\n操作 {}",
+                request.user_id, request.controller_device_id, request.purpose, operations
+            );
+            if crate::platform::confirm_deskrealm_consent(&text) && !stopped() {
+                return Some(request.allowed_mask);
+            }
+        }
+        #[cfg(not(target_os = "windows"))]
+        let _ = request;
+        None
+    })
+    .await
+    .ok()
+    .flatten()
+}
