diff --git a/libs/base/src/deskrealm_endpoint/runtime.rs b/libs/base/src/deskrealm_endpoint/runtime.rs
new file mode 100644
index 0000000..2478d8e
--- /dev/null
+++ b/libs/base/src/deskrealm_endpoint/runtime.rs
@@ -0,0 +1,288 @@
+use super::{
+    check_credential, decode_hex_32, encode, now_ms, policy_mask, uuid_bytes, valid_identifier,
+    Authority, DeviceIdentity, Lease, URL_SAFE_NO_PAD,
+};
+use hbb_common::{
+    anyhow::{anyhow, bail},
+    base64::Engine as _,
+    chrono::{DateTime, Utc},
+    deskrealm_protocol::{DEVICE_CHALLENGE, POLICY_RECEIPT},
+    sodiumoxide::crypto::hash::sha256,
+    uuid::Uuid,
+    ResultType,
+};
+use serde_derive::Deserialize;
+use std::time::Duration;
+use tokio::time::Instant;
+
+pub struct DeviceCredential {
+    value: String,
+    organization: Uuid,
+    device: Uuid,
+    key_epoch: u64,
+    deadline: Instant,
+}
+
+impl DeviceCredential {
+    pub fn bearer(&self) -> &str {
+        &self.value
+    }
+
+    pub fn expires_within(&self, margin: Duration) -> bool {
+        Instant::now() + margin >= self.deadline
+    }
+}
+
+pub struct InstalledPolicy {
+    version: u64,
+    allowed_mask: u8,
+    unattended_purposes: Vec<String>,
+}
+
+impl InstalledPolicy {
+    pub fn version(&self) -> u64 {
+        self.version
+    }
+
+    pub fn allowed_mask(&self) -> u8 {
+        self.allowed_mask
+    }
+
+    pub fn unattended_purposes(&self) -> &[String] {
+        &self.unattended_purposes
+    }
+}
+
+#[derive(Deserialize)]
+struct DeviceChallenge {
+    device_id: String,
+    organization_id: String,
+    challenge_id: String,
+    nonce: String,
+    expires_ms: u64,
+    key_epoch: u64,
+    protocol_version: u16,
+}
+
+#[derive(Deserialize)]
+struct CredentialResponse {
+    credential: String,
+    expires_at: String,
+}
+
+#[derive(Deserialize)]
+struct Delivery {
+    device_id: String,
+    organization_id: String,
+    delivery_id: String,
+    policy_version: u64,
+    key_epoch: u64,
+    schema_version: u16,
+    payload_sha256: String,
+    allowed_actions: Vec<String>,
+    unattended_purposes: Vec<String>,
+}
+
+#[derive(Deserialize)]
+struct PolicyResponse {
+    policy: Option<Delivery>,
+}
+
+impl Authority {
+    pub async fn authenticate_device(
+        &self,
+        device: &DeviceIdentity,
+        organization: Uuid,
+    ) -> ResultType<DeviceCredential> {
+        let body = self
+            .post(
+                "/v1/managed/devices/challenge",
+                "",
+                serde_json::json!({
+                    "device_id": device.id.to_string(), "protocol_version": 1,
+                }),
+                &[200],
+            )
+            .await?;
+        let challenge: DeviceChallenge =
+            serde_json::from_slice(&body).map_err(|_| anyhow!("invalid device challenge"))?;
+        let id = uuid_bytes(&challenge.challenge_id)?;
+        let expires = challenge.expires_ms.saturating_sub(now_ms()?);
+        if uuid_bytes(&challenge.device_id)? != device.id
+            || uuid_bytes(&challenge.organization_id)? != organization
+            || challenge.protocol_version != 1
+            || !(1..=60_000).contains(&expires)
+        {
+            bail!("device challenge does not match this identity");
+        }
+        let nonce = URL_SAFE_NO_PAD.decode(challenge.nonce)?;
+        let proof = encode(
+            DEVICE_CHALLENGE,
+            &[
+                organization.as_bytes(),
+                device.id.as_bytes(),
+                id.as_bytes(),
+                &nonce,
+                &challenge.key_epoch.to_be_bytes(),
+                &challenge.expires_ms.to_be_bytes(),
+                &challenge.protocol_version.to_be_bytes(),
+            ],
+        )
+        .ok_or_else(|| anyhow!("malformed device challenge"))?;
+        let started = Instant::now();
+        let body = self
+            .post(
+                "/v1/managed/devices/complete",
+                "",
+                serde_json::json!({
+                    "device_id": device.id.to_string(), "challenge_id": id.to_string(),
+                    "signature": URL_SAFE_NO_PAD.encode(device.sign(&proof)),
+                }),
+                &[201],
+            )
+            .await?;
+        let result: CredentialResponse = serde_json::from_slice(&body)
+            .map_err(|_| anyhow!("invalid device credential response"))?;
+        check_credential(&result.credential, "drd_")?;
+        let expiry = DateTime::parse_from_rfc3339(&result.expires_at)?;
+        let lifetime = expiry
+            .signed_duration_since(Utc::now())
+            .to_std()
+            .map_err(|_| anyhow!("expired device credential"))?;
+        let deadline = started + lifetime.min(Duration::from_secs(15 * 60));
+        if deadline <= Instant::now() {
+            bail!("expired device credential");
+        }
+        Ok(DeviceCredential {
+            value: result.credential,
+            organization,
+            device: device.id,
+            key_epoch: challenge.key_epoch,
+            deadline,
+        })
+    }
+
+    pub async fn heartbeat(&self, credential: &DeviceCredential, build: &str) -> ResultType<()> {
+        self.post(
+            "/v1/managed/devices/heartbeat",
+            credential.bearer(),
+            serde_json::json!({
+                "device_id": credential.device.to_string(), "reported_build": build,
+            }),
+            &[204],
+        )
+        .await?;
+        Ok(())
+    }
+
+    pub async fn install_policy(
+        &self,
+        device: &DeviceIdentity,
+        credential: &DeviceCredential,
+    ) -> ResultType<Option<InstalledPolicy>> {
+        if credential.device != device.id || credential.expires_within(Duration::ZERO) {
+            bail!("managed policy credential does not match the device");
+        }
+        let endpoint = format!("/v1/managed/devices/{}/policy", device.id);
+        let request = self
+            .client
+            .get(self.center.join(&endpoint)?)
+            .bearer_auth(credential.bearer());
+        let body = Self::read_response(request, &[200]).await?;
+        let response: PolicyResponse = serde_json::from_slice(&body)
+            .map_err(|_| anyhow!("invalid policy delivery response"))?;
+        let Some(delivery) = response.policy else {
+            return Ok(None);
+        };
+        let delivery_id = uuid_bytes(&delivery.delivery_id)?;
+        if uuid_bytes(&delivery.device_id)? != device.id
+            || uuid_bytes(&delivery.organization_id)? != credential.organization
+            || delivery.key_epoch != credential.key_epoch
+        {
+            bail!("policy delivery does not match the authenticated device");
+        }
+        let digest = decode_hex_32(&delivery.payload_sha256)?;
+        let (policy, failed_mask, failed_fields) = delivery.install(digest);
+        let verified = policy.is_some();
+        let proof = encode(
+            POLICY_RECEIPT,
+            &[
+                credential.organization.as_bytes(),
+                device.id.as_bytes(),
+                delivery_id.as_bytes(),
+                &delivery.policy_version.to_be_bytes(),
+                &digest,
+                &credential.key_epoch.to_be_bytes(),
+                &[if verified { 1 } else { 2 }],
+                &[failed_mask],
+            ],
+        )
+        .ok_or_else(|| anyhow!("malformed policy receipt"))?;
+        self.post("/v1/managed/devices/policy-receipts", credential.bearer(), serde_json::json!({
+            "device_id": device.id.to_string(), "delivery_id": delivery_id.to_string(),
+            "policy_version": delivery.policy_version, "payload_sha256": delivery.payload_sha256,
+            "result": if verified { "applied" } else { "failed" }, "failed_fields": failed_fields,
+            "signature": URL_SAFE_NO_PAD.encode(device.sign(&proof)),
+        }), &[204]).await?;
+        Ok(policy)
+    }
+
+    /// After the desktop has closed a connection, reconcile its center state.
+    pub async fn report_local_end(&self, lease: &Lease) -> ResultType<()> {
+        let endpoint = format!("/v1/sessions/{}/stopped", lease.session_id);
+        self.post(&endpoint, lease.credential(), serde_json::json!({
+            "connection_id": lease.connection_id.to_string(), "lease_sequence": lease.sequence, "reason": "local_end",
+        }), &[204]).await?;
+        Ok(())
+    }
+}
+
+impl Delivery {
+    fn install(&self, digest: [u8; 32]) -> (Option<InstalledPolicy>, u8, Vec<&'static str>) {
+        let mut fields = Vec::new();
+        if self.schema_version != 1 {
+            return (None, 4, vec!["schema_version"]);
+        }
+        let mut failure = 0;
+        let actions = match policy_mask(&self.allowed_actions) {
+            Ok(actions) => actions,
+            Err(_) => {
+                fields.push("allowed_actions");
+                failure |= 1;
+                0
+            }
+        };
+        let mut purposes = self.unattended_purposes.clone();
+        purposes.sort_unstable();
+        if purposes.len() > 32
+            || purposes.iter().any(|v| !valid_identifier(v, 64))
+            || purposes.windows(2).any(|pair| pair[0] == pair[1])
+            || (actions == 0 && !purposes.is_empty() && failure == 0)
+        {
+            fields.push("unattended_purposes");
+            failure |= 2;
+        }
+        if failure != 0 {
+            return (None, failure, fields);
+        }
+        let mut hash = sha256::State::new();
+        hash.update(b"DR-M2-policy-v1\0");
+        hash.update(&[actions]);
+        for purpose in &purposes {
+            hash.update(purpose.as_bytes());
+            hash.update(&[0]);
+        }
+        if hash.finalize().0 != digest {
+            return (None, 3, vec!["allowed_actions", "unattended_purposes"]);
+        }
+        (
+            Some(InstalledPolicy {
+                version: self.policy_version,
+                allowed_mask: actions,
+                unattended_purposes: purposes,
+            }),
+            0,
+            fields,
+        )
+    }
+}
