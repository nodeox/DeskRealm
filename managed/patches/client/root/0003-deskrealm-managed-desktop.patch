+#[tokio::test]
+async fn managed_device_policy_api_roundtrip() -> ResultType<()> {
+    let device = DeviceIdentity::from_seed(
+        env::var("DESKREALM_FIXTURE_TARGET")?.parse()?,
+        &sign::Seed([3; 32]),
+    )?;
+    let organization = env::var("DESKREALM_FIXTURE_ORGANIZATION")?.parse()?;
+    let ca = std::fs::read(env::var("DESKREALM_FIXTURE_CA")?)?;
+    let (center_key, _) = sign::keypair_from_seed(&sign::Seed([1; 32]));
+    let authority = Authority::new(
+        &env::var("DESKREALM_FIXTURE_CENTER")?,
+        "fixture-center".to_owned(),
+        center_key,
+        Some(&ca),
+    )?;
+    let credential = authority.authenticate_device(&device, organization).await?;
+    assert!(!credential.expires_within(Duration::from_secs(60)));
+    authority
+        .heartbeat(&credential, "native-runtime-fixture")
+        .await?;
+    let first = authority
+        .install_policy(&device, &credential)
+        .await?
+        .expect("fixture policy");
+    assert_eq!(first.version(), 1);
+    assert_eq!(first.allowed_mask(), 3);
+    assert_eq!(first.unattended_purposes(), &["helpdesk", "support"]);
+    assert!(
+        authority
+            .install_policy(&device, &credential)
+            .await?
+            .is_none(),
+        "unsupported schema applied"
+    );
+    assert!(
+        authority
+            .install_policy(&device, &credential)
+            .await
+            .is_err(),
+        "wrong organization accepted"
+    );
+    assert!(
+        authority
+            .install_policy(&device, &credential)
+            .await?
+            .is_none(),
+        "missing policy applied"
+    );
+    let deny_all = authority
+        .install_policy(&device, &credential)
+        .await?
+        .expect("deny-all fixture");
+    assert_eq!(deny_all.version(), 5);
+    assert_eq!(deny_all.allowed_mask(), 0);
+    Ok(())
+}
