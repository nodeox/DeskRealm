+fn validate_challenge_expiry(expires_ms: u64, now_ms: u64) -> ResultType<()> {
+    const CHALLENGE_TTL_MS: u64 = 60_000;
+    const CLOCK_SKEW_MARGIN_MS: u64 = 5_000;
+    let remaining_ms = expires_ms.saturating_sub(now_ms);
+    // The center still enforces the original expiry when consuming the challenge.
+    if !(1..=CHALLENGE_TTL_MS + CLOCK_SKEW_MARGIN_MS).contains(&remaining_ms) {
+        bail!("设备认证挑战已过期或与本机时钟不符");
+    }
+    Ok(())
+}
+
+#[test]
+fn identity_challenge_allows_small_clock_skew() {
+    let now = 1_800_000_000_000;
+    assert!(validate_challenge_expiry(now + 60_000, now).is_ok());
+    assert!(validate_challenge_expiry(now + 60_001, now).is_ok());
+    assert!(validate_challenge_expiry(now + 65_000, now).is_ok());
+    assert!(validate_challenge_expiry(now + 65_001, now).is_err());
+    assert!(validate_challenge_expiry(now, now).is_err());
+    assert!(validate_challenge_expiry(now - 1, now).is_err());
+}
