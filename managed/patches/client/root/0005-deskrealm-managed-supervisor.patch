@@ -0,0 +1,346 @@
+//! Drives the target's policy window independently of peer traffic.
+
+use super::{
+    Authority, Lease, LeaseClock, LeaseWindow, ManagedAction, Renewal, SessionStatus, StopReason,
+};
+use crate::message_proto::{message, misc, Message};
+use hbb_common::{anyhow::anyhow, ResultType, Stream};
+use protobuf::Message as _;
+use std::{
+    future::Future,
+    pin::Pin,
+    sync::{Arc, RwLock},
+    time::Duration,
+};
+use tokio::time::{interval, sleep, timeout, MissedTickBehavior};
+
+const CHECK_INTERVAL: Duration = Duration::from_millis(250);
+const STATUS_INTERVAL: Duration = Duration::from_secs(1);
+const STATUS_TIMEOUT: Duration = Duration::from_secs(2);
+const RENEW_INTERVAL: Duration = Duration::from_secs(10);
+const RETRY_INTERVAL: Duration = Duration::from_secs(1);
+const RESUME_GAP: Duration = Duration::from_secs(2);
+
+type Pending<T> = Pin<Box<dyn Future<Output = ResultType<T>> + Send>>;
+
+struct Snapshot {
+    allowed: u8,
+    window: LeaseWindow,
+    last_check: Duration,
+    ready: bool,
+}
+
+/// A target resource checks this immediately before dispatching a managed operation.
+/// The snapshot excludes session credentials and can be shared with resource workers.
+#[derive(Clone)]
+pub struct SessionAccess(Arc<RwLock<Option<Snapshot>>>);
+
+impl SessionAccess {
+    fn new() -> Self {
+        Self(Arc::new(RwLock::new(None)))
+    }
+
+    pub fn permits(&self, action: ManagedAction) -> bool {
+        LeaseClock::now().is_ok_and(|now| self.permits_at(action, now))
+    }
+
+    fn permits_at(&self, action: ManagedAction, now: LeaseClock) -> bool {
+        self.0.read().is_ok_and(|snapshot| {
+            snapshot.as_ref().is_some_and(|state| {
+                state.ready
+                    && state.allowed & action as u8 != 0
+                    && state.window.active_at(now)
+                    && !missed_check(state.last_check, now.boot)
+            })
+        })
+    }
+
+    fn publish(&self, lease: &Lease, now: LeaseClock, ready: bool) {
+        if let Ok(mut snapshot) = self.0.write() {
+            *snapshot = Some(Snapshot {
+                allowed: lease.allowed_mask,
+                window: lease.window,
+                last_check: now.boot,
+                ready,
+            });
+        }
+    }
+
+    fn stop(&self) {
+        if let Ok(mut snapshot) = self.0.write() {
+            *snapshot = None;
+        }
+    }
+}
+
+struct AccessGuard(SessionAccess);
+
+impl Drop for AccessGuard {
+    fn drop(&mut self) {
+        self.0.stop();
+    }
+}
+
+fn missed_check(previous: Duration, now: Duration) -> bool {
+    now.checked_sub(previous)
+        .map_or(true, |elapsed| elapsed >= RESUME_GAP)
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum End {
+    Stopped(StopReason),
+    AlreadyReported,
+}
+
+impl From<StopReason> for End {
+    fn from(reason: StopReason) -> Self {
+        Self::Stopped(reason)
+    }
+}
+
+impl Authority {
+    /// Holds the authenticated transport up to the application handoff, serving
+    /// only liveness probes and peer close. The stream is dropped before reporting.
+    pub async fn hold_target(
+        &self,
+        stream: Stream,
+        lease: Lease,
+        device_bearer: impl Fn() -> Option<String>,
+        stopped: impl Fn() -> bool,
+    ) -> ResultType<StopReason> {
+        self.run_target(
+            stream,
+            lease,
+            device_bearer,
+            stopped,
+            |mut stream, _| async move { wait_for_peer_close(&mut stream).await },
+        )
+        .await
+    }
+
+    /// Runs a target data-plane future for an already redeemed lease. The driver
+    /// owns its stream and uses the access handle at each execution boundary.
+    /// On cancellation its owned resources must be released before returning.
+    pub async fn run_target<F>(
+        &self,
+        stream: Stream,
+        mut lease: Lease,
+        device_bearer: impl Fn() -> Option<String>,
+        stopped: impl Fn() -> bool,
+        driver: impl FnOnce(Stream, SessionAccess) -> F,
+    ) -> ResultType<StopReason>
+    where
+        F: Future<Output = StopReason>,
+    {
+        let end = {
+            let access = SessionAccess::new();
+            let execution = driver(stream, access.clone());
+            tokio::pin!(execution);
+            let _stop_on_cancel = AccessGuard(access.clone());
+            let end = tokio::select! {
+                biased;
+                end = self.supervise(&mut lease, &access, device_bearer, stopped) => end,
+                reason = &mut execution => End::from(reason),
+            };
+            access.stop();
+            end
+        };
+
+        let End::Stopped(reason) = end else {
+            return Ok(StopReason::LocalEnd);
+        };
+        // A request can be applied even if its response was lost. Retries keep the
+        // same reason and last applied sequence and the center deduplicates them.
+        for delay in [Duration::ZERO, RETRY_INTERVAL, RETRY_INTERVAL * 2] {
+            sleep(delay).await;
+            if self.report_stop(&lease, reason).await.is_ok() {
+                return Ok(reason);
+            }
+        }
+        Err(anyhow!(
+            "managed session closed before its stop receipt reached the center"
+        ))
+    }
+
+    async fn supervise(
+        &self,
+        lease: &mut Lease,
+        access: &SessionAccess,
+        device_bearer: impl Fn() -> Option<String>,
+        stopped: impl Fn() -> bool,
+    ) -> End {
+        let Ok(initial) = LeaseClock::now() else {
+            return StopReason::LeaseExpired.into();
+        };
+        let mut last_check = initial.boot;
+        let mut require_status = true;
+        let mut ticks = interval(CHECK_INTERVAL);
+        ticks.set_missed_tick_behavior(MissedTickBehavior::Skip);
+        let mut status_at = initial.running;
+        let mut renew_at = initial.running + RENEW_INTERVAL;
+        let mut status: Option<Pending<SessionStatus>> = None;
+        let mut renewal: Option<Pending<(LeaseClock, Renewal)>> = None;
+
+        loop {
+            tokio::select! {
+                biased;
+                _ = ticks.tick() => {
+                    let Ok(now) = LeaseClock::now() else {
+                        return StopReason::LeaseExpired.into();
+                    };
+                    if !lease.window.active_at(now) {
+                        return StopReason::LeaseExpired.into();
+                    }
+                    if stopped() {
+                        return StopReason::LocalEnd.into();
+                    }
+                    if missed_check(last_check, now.boot) {
+                        require_status = true;
+                        status = None;
+                        renewal = None;
+                        status_at = now.running;
+                    }
+                    last_check = now.boot;
+                    access.publish(lease, now, !require_status);
+
+                    if status.is_none() && now.running >= status_at {
+                        status_at = now.running + STATUS_INTERVAL;
+                        if let Ok(request) = self.status_request(lease) {
+                            let (connection, sequence) = (lease.connection_id, lease.sequence);
+                            status = Some(Box::pin(Self::read_status(
+                                request.timeout(STATUS_TIMEOUT), connection, sequence,
+                            )));
+                        }
+                    }
+                    if !require_status && renewal.is_none() && now.running >= renew_at {
+                        renew_at = now.running + RETRY_INTERVAL;
+                        if let Some(bearer) = device_bearer() {
+                            if let Ok((started, request)) = self.renewal_request(lease, &bearer) {
+                                renewal = Some(Box::pin(async move {
+                                    Ok((started, Self::read_renewal(request).await?))
+                                }));
+                            }
+                        }
+                    }
+                }
+                result = async { status.as_mut().unwrap().await }, if status.is_some() => {
+                    status = None;
+                    match result {
+                        Ok(SessionStatus::RevocationRequested | SessionStatus::Revoked) => {
+                            return StopReason::Revoked.into();
+                        }
+                        Ok(SessionStatus::LeaseExpired) => return StopReason::LeaseExpired.into(),
+                        Ok(SessionStatus::Stopped) => return End::AlreadyReported,
+                        Ok(SessionStatus::Active) => {
+                            // Only the next tick republishes access after confirming the
+                            // current boot clock and the still-effective local deadline.
+                            require_status = false;
+                        }
+                        Err(_) => {}
+                    }
+                }
+                result = async { renewal.as_mut().unwrap().await }, if renewal.is_some() => {
+                    renewal = None;
+                    if let (Ok((started, reply)), Ok(now)) = (result, LeaseClock::now()) {
+                        if !missed_check(last_check, now.boot)
+                            && !require_status && lease.apply_renewal(reply, started, now).is_ok()
+                        {
+                            renew_at = started.running + RENEW_INTERVAL;
+                            access.publish(lease, now, true);
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+async fn wait_for_peer_close(stream: &mut Stream) -> StopReason {
+    loop {
+        let Some(Ok(frame)) = stream.next().await else {
+            return StopReason::ConnectionLost;
+        };
+        let Ok(message) = Message::parse_from_bytes(&frame) else {
+            return StopReason::ConnectionLost;
+        };
+        match &message.union {
+            Some(message::Union::TestDelay(probe))
+                if probe.from_client
+                    && probe.time > 0
+                    && probe.last_delay == 0
+                    && probe.target_bitrate == 0 =>
+            {
+                // A relay can otherwise time out an idle admitted TCP flow before
+                // a renewed lease expires. This probe has no application payload.
+                if !matches!(
+                    timeout(STATUS_TIMEOUT, stream.send(&message)).await,
+                    Ok(Ok(()))
+                ) {
+                    return StopReason::ConnectionLost;
+                }
+                tokio::task::yield_now().await;
+            }
+            Some(message::Union::Misc(control))
+                if matches!(control.union, Some(misc::Union::CloseReason(_))) =>
+            {
+                return StopReason::LocalEnd;
+            }
+            _ => return StopReason::ConnectionLost,
+        }
+    }
+}
+
+/// Lets the desktop controller finish admission while the application dispatcher
+/// is unavailable. A bounded write avoids holding an admitted session on a stalled link.
+pub async fn send_controller_end(stream: &mut Stream) {
+    let mut control = crate::message_proto::Misc::new();
+    control.set_close_reason(String::new());
+    let mut message = Message::new();
+    message.set_misc(control);
+    let _ = timeout(STATUS_TIMEOUT, stream.send(&message)).await;
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use hbb_common::{deskrealm_protocol::Path, uuid::Uuid};
+    use tokio::time::Instant;
+
+    #[test]
+    fn resume_requires_revalidation_before_any_access() {
+        let now = Instant::now();
+        let clock = |running, boot| LeaseClock {
+            running: now + Duration::from_millis(running),
+            boot: Duration::from_millis(boot),
+            wall_ms: 1_000 + boot,
+        };
+        let start = clock(0, 0);
+        let lease = Lease {
+            session_id: Uuid::new_v4(),
+            connection_id: Uuid::new_v4(),
+            path: Path::Direct,
+            allowed_mask: ManagedAction::View as u8,
+            sequence: 1,
+            until_ms: 31_000,
+            window: LeaseWindow::new(start, 31_000, start).unwrap(),
+            renewal_started: None,
+            credential: String::new(),
+        };
+        let access = SessionAccess::new();
+        access.publish(&lease, start, true);
+        assert!(access.permits_at(ManagedAction::View, clock(500, 500)));
+        assert!(!access.permits_at(ManagedAction::Input, clock(500, 500)));
+
+        let resumed = clock(500, 5_000);
+        assert!(!access.permits_at(ManagedAction::View, resumed));
+        access.publish(&lease, resumed, false);
+        assert!(!access.permits_at(ManagedAction::View, resumed));
+        access.publish(&lease, resumed, true);
+        assert!(access.permits_at(ManagedAction::View, resumed));
+        assert!(!access.permits_at(ManagedAction::View, clock(500, 30_000)));
+
+        let worker = access.clone();
+        drop(AccessGuard(access));
+        assert!(!worker.permits_at(ManagedAction::View, resumed));
+    }
+}
