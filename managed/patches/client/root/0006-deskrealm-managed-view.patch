+//! Read-only monitor sessions after a DeskRealm redemption.
+
+use super::{
+    display_service,
+    service::{GenericService, Service},
+    video_service, ConnInner,
+};
+use base::{
+    deskrealm_endpoint::{ManagedAction, SessionAccess, StopReason},
+    message_proto::{
+        message, misc, permission_info::Permission, LoginResponse, Message, Misc, PeerInfo,
+        PermissionInfo,
+    },
+};
+use hbb_common::tokio::{
+    self,
+    sync::{mpsc, OwnedSemaphorePermit},
+    time::{interval, sleep, timeout, MissedTickBehavior},
+};
+use hbb_common::{get_time, log, protobuf::Message as _, rand, ResultType, Stream};
+use scrap::codec::{Encoder, EncodingUpdate};
+use std::{
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+
+const WRITE_LIMIT: Duration = Duration::from_secs(2);
+const FIRST_STATUS_LIMIT: Duration = Duration::from_secs(5);
+
+#[derive(Clone)]
+pub(crate) struct Capture(Arc<CaptureState>);
+
+struct CaptureState {
+    active: Mutex<Option<Monitor>>,
+    _exclusive: OwnedSemaphorePermit,
+}
+
+struct Monitor {
+    service: GenericService,
+    display: usize,
+    id: i32,
+}
+
+impl Drop for Monitor {
+    fn drop(&mut self) {
+        self.service.on_unsubscribe(self.id);
+        video_service::notify_video_frame_fetched(self.display, self.id, None);
+        self.service.join();
+        Encoder::update(EncodingUpdate::Remove(self.id));
+    }
+}
+
+impl Capture {
+    pub(crate) fn new(exclusive: OwnedSemaphorePermit) -> Self {
+        Self(Arc::new(CaptureState {
+            active: Mutex::new(None),
+            _exclusive: exclusive,
+        }))
+    }
+
+    pub(crate) async fn stop(self) -> ResultType<()> {
+        // Keep the exclusive permit until the capture worker is joined, even if
+        // the session task is cancelled while waiting for this blocking job.
+        tokio::task::spawn_blocking(move || {
+            let monitor = self.0.active.lock().unwrap().take();
+            drop(monitor);
+        })
+        .await?;
+        Ok(())
+    }
+
+    pub(crate) async fn run(self, mut stream: Stream, access: SessionAccess) -> StopReason {
+        match self.view(&mut stream, &access).await {
+            Ok(reason) => reason,
+            Err(err) => {
+                log::debug!("managed view ended: {err}");
+                StopReason::ConnectionLost
+            }
+        }
+    }
+
+    async fn view(&self, stream: &mut Stream, access: &SessionAccess) -> ResultType<StopReason> {
+        timeout(FIRST_STATUS_LIMIT, async {
+            while !access.permits(ManagedAction::View) {
+                sleep(Duration::from_millis(25)).await;
+            }
+        })
+        .await?;
+
+        let (primary, mut displays) = {
+            let native = scrap::Display::all()?;
+            (
+                display_service::get_primary_2(&native),
+                display_service::update_sync_displays(&native),
+            )
+        };
+        if primary >= displays.len() || !displays[primary].online {
+            let mut response = LoginResponse::new();
+            response.set_error("No active display".to_owned());
+            let mut message = Message::new();
+            message.set_login_response(response);
+            send(stream, &message).await?;
+            return Ok(StopReason::LocalEnd);
+        }
+        let display = displays.swap_remove(primary);
+        for permission in [
+            Permission::Keyboard,
+            Permission::Audio,
+            Permission::Clipboard,
+            Permission::File,
+            Permission::Restart,
+            Permission::Recording,
+            Permission::BlockInput,
+            Permission::PrivacyMode,
+        ] {
+            let mut control = Misc::new();
+            control.set_permission_info(PermissionInfo {
+                permission: permission.into(),
+                ..Default::default()
+            });
+            let mut message = Message::new();
+            message.set_misc(control);
+            send(stream, &message).await?;
+        }
+        let mut response = LoginResponse::new();
+        response.set_peer_info(PeerInfo {
+            hostname: crate::whoami_hostname(),
+            platform: hbb_common::whoami::platform().to_string(),
+            version: crate::VERSION.to_owned(),
+            displays: vec![display],
+            ..Default::default()
+        });
+        let mut message = Message::new();
+        message.set_login_response(response);
+        if !access.permits(ManagedAction::View) {
+            return Ok(StopReason::LocalEnd);
+        }
+        send(stream, &message).await?;
+        if !access.permits(ManagedAction::View) {
+            return Ok(StopReason::LocalEnd);
+        }
+
+        let id = rand::random::<i32>() & i32::MAX;
+        let (tx, mut rx) = mpsc::channel(4);
+        Encoder::update(EncodingUpdate::NewOnlyVP9(id));
+        let service = video_service::new_managed_view(primary);
+        service.on_subscribe(ConnInner::managed_view(id, access.clone(), tx));
+        *self.0.active.lock().unwrap() = Some(Monitor {
+            service: service.clone(),
+            display: primary,
+            id,
+        });
+
+        let mut probe = interval(Duration::from_secs(5));
+        probe.set_missed_tick_behavior(MissedTickBehavior::Skip);
+        loop {
+            tokio::select! {
+                packet = stream.next() => {
+                    let Some(Ok(packet)) = packet else { return Ok(StopReason::ConnectionLost) };
+                    let message = Message::parse_from_bytes(&packet)?;
+                    match request(&message) {
+                        ViewRequest::Close => return Ok(StopReason::LocalEnd),
+                        ViewRequest::Refresh if access.permits(ManagedAction::View) => {
+                            service.set_option_bool(video_service::OPTION_REFRESH, true);
+                        }
+                        _ => {}
+                    }
+                }
+                packet = rx.recv() => {
+                    let Some((queued_at, message)) = packet else { return Ok(StopReason::ConnectionLost) };
+                    video_service::notify_video_frame_fetched(primary, id, Some(queued_at.into()));
+                    if !access.permits(ManagedAction::View) || queued_at.elapsed() >= Duration::from_secs(1) {
+                        continue;
+                    }
+                    // The wire exposes a single display at index zero.
+                    let mut frame = message.video_frame().clone();
+                    frame.display = 0;
+                    let mut message = Message::new();
+                    message.set_video_frame(frame);
+                    send_video(stream, access, &message).await?;
+                }
+                _ = probe.tick() => {
+                    let mut message = Message::new();
+                    message.mut_test_delay().time = get_time();
+                    send(stream, &message).await?;
+                }
+            }
+            // Yield even when peer traffic and the queue are continuously ready.
+            tokio::task::yield_now().await;
+        }
+    }
+}
+
+async fn send(stream: &mut Stream, message: &Message) -> ResultType<()> {
+    timeout(WRITE_LIMIT, stream.send(message)).await??;
+    Ok(())
+}
+
+async fn send_video(
+    stream: &mut Stream,
+    access: &SessionAccess,
+    message: &Message,
+) -> ResultType<()> {
+    let permit_lost = async {
+        while access.permits(ManagedAction::View) {
+            sleep(Duration::from_millis(25)).await;
+        }
+    };
+    tokio::select! {
+        biased;
+        _ = permit_lost => hbb_common::bail!("managed display authorization changed"),
+        result = send(stream, message) => result,
+    }
+}
+
+pub(super) fn is_video_packet(message: &Message) -> bool {
+    matches!(message.union, Some(message::Union::VideoFrame(_)))
+}
+
+#[derive(Debug, PartialEq, Eq)]
+enum ViewRequest {
+    Close,
+    Refresh,
+    Ignore,
+}
+
+fn request(message: &Message) -> ViewRequest {
+    match message.union.as_ref() {
+        Some(message::Union::Misc(misc)) => match misc.union.as_ref() {
+            Some(misc::Union::CloseReason(_)) => ViewRequest::Close,
+            Some(misc::Union::RefreshVideo(true) | misc::Union::RefreshVideoDisplay(0)) => {
+                ViewRequest::Refresh
+            }
+            _ => ViewRequest::Ignore,
+        },
+        _ => ViewRequest::Ignore,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn managed_view_requests_only_dispatch_refresh_and_close() {
+        let mut message = Message::new();
+        message.set_mouse_event(Default::default());
+        assert_eq!(request(&message), ViewRequest::Ignore);
+        message.set_key_event(Default::default());
+        assert_eq!(request(&message), ViewRequest::Ignore);
+        message.set_audio_frame(Default::default());
+        assert_eq!(request(&message), ViewRequest::Ignore);
+        message.set_clipboard(Default::default());
+        assert_eq!(request(&message), ViewRequest::Ignore);
+        message.set_file_action(Default::default());
+        assert_eq!(request(&message), ViewRequest::Ignore);
+        message.set_login_request(Default::default());
+        assert_eq!(request(&message), ViewRequest::Ignore);
+        message.set_misc(Misc::new());
+        message.mut_misc().set_refresh_video_display(1);
+        assert_eq!(request(&message), ViewRequest::Ignore);
+        message.mut_misc().set_refresh_video_display(0);
+        assert_eq!(request(&message), ViewRequest::Refresh);
+        message.mut_misc().set_close_reason(String::new());
+        assert_eq!(request(&message), ViewRequest::Close);
+    }
+    #[cfg(target_os = "linux")]
+    #[tokio::test]
+    #[ignore = "requires Xvfb or a real X11 display"]
+    async fn managed_view_captures_and_releases_monitor() -> ResultType<()> {
+        let id = i32::MAX;
+        let (tx, mut frames) = mpsc::unbounded_channel();
+        Encoder::update(EncodingUpdate::NewOnlyVP9(id));
+        let service = video_service::new_managed_view(0);
+        let monitor = Monitor {
+            service: service.clone(),
+            display: 0,
+            id,
+        };
+        service.on_subscribe(ConnInner::new(id, None, Some(tx)));
+        let frame = timeout(Duration::from_secs(10), async {
+            while let Some((queued_at, message)) = frames.recv().await {
+                if is_video_packet(&message) {
+                    video_service::notify_video_frame_fetched(0, id, Some(queued_at.into()));
+                    return Some(message);
+                }
+            }
+            None
+        })
+        .await?;
+        let frame = frame.expect("monitor service did not produce a frame");
+        assert!(!frame.video_frame().vp9s().frames.is_empty());
+
+        tokio::task::spawn_blocking(move || drop(monitor)).await?;
+        assert!(!service.active());
+        assert!(!service.is_subed(id));
+        while frames.try_recv().is_ok() {}
+        assert!(frames.recv().await.is_none());
+        Ok(())
+    }
+}
