+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+fn managed_view_refresh(message: &Message) -> bool {
+    matches!(
+        message.misc().union.as_ref(),
+        Some(misc::Union::RefreshVideo(true) | misc::Union::RefreshVideoDisplay(0))
+    )
+}
+
+fn managed_view_response(message: &Message, connected: bool) -> bool {
+    match message.union.as_ref() {
+        Some(message::Union::VideoFrame(frame)) => connected && frame.display == 0,
+        Some(message::Union::LoginResponse(response)) => !connected
+            && match response.union.as_ref() {
+                Some(login_response::Union::PeerInfo(info)) => info.displays.len() == 1
+                    && info.current_display == 0 && !info.sas_enabled
+                    && info.windows_sessions.is_none() && info.features.is_none()
+                    && info.platform_additions.is_empty(),
+                Some(login_response::Union::Error(_)) => true,
+                _ => false,
+            },
+        Some(message::Union::Misc(misc)) => match misc.union.as_ref() {
+            Some(misc::Union::CloseReason(_)) => true,
+            Some(misc::Union::PermissionInfo(permission)) => !permission.enabled,
+            _ => false,
+        },
+        _ => false,
+    }
+}
+
+#[cfg(test)]
+#[test]
+fn managed_view_does_not_dispatch_legacy_or_other_capabilities() {
+    let mut message = Message::new();
+    message.set_hash(Default::default());
+    assert!(!managed_view_response(&message, false));
+    message.set_clipboard(Default::default());
+    assert!(!managed_view_response(&message, true));
+    message.set_file_action(Default::default());
+    assert!(!managed_view_response(&message, true));
+    message.set_audio_frame(Default::default());
+    assert!(!managed_view_response(&message, true));
+    message.set_video_frame(Default::default());
+    assert!(!managed_view_response(&message, false));
+    assert!(managed_view_response(&message, true));
+    message.mut_video_frame().display = 1;
+    assert!(!managed_view_response(&message, true));
+}
