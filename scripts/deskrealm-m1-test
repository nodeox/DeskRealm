#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
mode="${1:-}"
bootstrap=(TestBootstrapPostgres TestBrowserSessionPostgres)
user_status=(TestUserStatusPostgres TestAccountRevocationPostgres)
identity=("${user_status[@]}" TestIdentityLifecyclePostgres)
federation=(TestTOTPReplayPostgres TestOIDCBindingPostgres)
authorization=(TestManagementScopesPostgres TestAPITokenScopesPostgres TestPlatformAdminTransferPostgres TestControlRolesPostgres)
enrollment=(TestDeviceEnrollmentPostgres TestDeviceApprovalPostgres)
lifecycle=(TestDeviceLifecyclePostgres TestDeviceStateIsolationPostgres)
addressbooks=(TestAddressBookScopesPostgres)
audit=(TestAuditScopePostgres TestAuditReceiptsPostgres)
tasks=(TestTaskRetryPostgres TestTaskLeaseAndReceiptsPostgres TestTaskMigrationPostgres)
overview=(TestOverviewScopesPostgres)
case "$mode" in
  bootstrap-api) tests=("${bootstrap[@]}") ;;
  user-status) tests=("${user_status[@]}") ;;
  identity-lifecycle) tests=("${identity[@]}") ;;
  identity-federation) tests=("${federation[@]}") ;;
  management-scopes) tests=(TestManagementScopesPostgres) ;;
  authorization) tests=("${authorization[@]}") ;;
  enrollment) tests=("${enrollment[@]}") ;;
  device-lifecycle) tests=("${lifecycle[@]}") ;;
  addressbooks) tests=("${addressbooks[@]}") ;;
  audit) tests=("${audit[@]}") ;;
  tasks) tests=("${tasks[@]}") ;;
  overview) tests=("${overview[@]}") ;;
  managed-identity) tests=(TestManagedDeviceIdentityPostgres TestManagedControllerBindingPostgres TestManagedSigningKeyConfig) ;;
  connection-rules) tests=(TestConnectionRuleEvaluationPostgres TestConnectionRuleRevisionsPostgres) ;;
  managed-policies) tests=(TestManagedPolicyAssignmentPostgres TestManagedPolicyReceiptsPostgres) ;;
  managed-sessions) tests=(TestSessionGrantPostgres TestSessionRedemptionPostgres) ;;
  session-leases) tests=(TestSessionLeasesPostgres TestSessionInvalidationPostgres) ;;
  all) tests=("${bootstrap[@]}" "${identity[@]}" "${federation[@]}" "${authorization[@]}" "${enrollment[@]}" "${lifecycle[@]}" "${addressbooks[@]}" "${audit[@]}" "${tasks[@]}" "${overview[@]}") ;;
  bootstrap-browser) browser_suite=bootstrap; browser_test='首次管理员初始化、成员停用、刷新和退出' ;;
  resources-browser) browser_suite=resources; browser_test='共享通讯录、审计和任务中心按实际授权与结果运行' ;;
  roles-browser) browser_suite=roles; browser_test='四类角色的概览、入口和操作遵守真实授权' ;;
  managed-browser) browser_suite=managed; browser_test='策略、设备回执和会话按实际授权与状态运行' ;;
  *) echo "usage: $0 all|bootstrap-api|user-status|identity-lifecycle|identity-federation|management-scopes|authorization|enrollment|device-lifecycle|addressbooks|audit|tasks|overview|managed-identity|connection-rules|managed-policies|managed-sessions|session-leases|bootstrap-browser|resources-browser|roles-browser|managed-browser" >&2; exit 2 ;;
esac

scratch=$(mktemp -d "${TMPDIR:-/tmp}/deskrealm-m1.XXXXXX")
container="deskrealm-test-$(basename "$scratch")"
server=
started=
cleanup() {
  if [[ -n "$server" ]]; then
    kill "$server" >/dev/null 2>&1 || true
    wait "$server" 2>/dev/null || true
  fi
  if [[ -n "$started" ]]; then
    docker rm -fv "$container" >/dev/null 2>&1 || true
  fi
  rm -rf "$scratch"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

image=docker.io/library/postgres:18.7-bookworm@sha256:194e55feb2597b1465dbee81cc9fd8d204566cd2eb42c8d22fd6c931a38781b1
test_password=$(openssl rand -hex 24)
POSTGRES_PASSWORD="$test_password" docker run --detach --rm --name "$container" \
  --publish 127.0.0.1::5432 --env POSTGRES_PASSWORD --env POSTGRES_DB=deskrealm "$image" >/dev/null
started=1

ready=
for ((i=0; i<50; i++)); do
  if docker exec "$container" pg_isready --host 127.0.0.1 --dbname deskrealm --username postgres >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 0.4
done
if [[ -z "$ready" ]]; then
  echo "temporary PostgreSQL did not start" >&2
  exit 1
fi
mapping=$(docker port "$container" 5432/tcp)
port="${mapping##*:}"
export DESKREALM_TEST_DATABASE_URL="postgres://postgres:$test_password@127.0.0.1:$port/deskrealm?sslmode=disable"

if [[ "$mode" != *-browser ]]; then
  export DESKREALM_REQUIRE_DB_TESTS=1
  if [[ "$mode" == all ]]; then
    go mod verify
    go vet ./...
    go_args=(-race ./...)
  else
    pattern=$(IFS='|'; echo "${tests[*]}")
    go_args=(./internal/m1 -run "^($pattern)$")
  fi
  if ! go test -json -count=1 "${go_args[@]}" >"$scratch/results.json"; then
    cat "$scratch/results.json" >&2
    exit 1
  fi
  python3 - "$scratch/results.json" "${tests[@]}" <<'PY'
import json
import sys

with open(sys.argv[1]) as log:
    events = [json.loads(line) for line in log]
required = set(sys.argv[2:])
actual = {event.get("Test") for event in events if event.get("Action") == "pass"}
skipped = {e["Test"] for e in events if e.get("Test") and e.get("Action") == "skip"}
if required - actual or skipped:
    sys.exit(f"missing or skipped regressions: {sorted((required - actual) | skipped)}")
print("PostgreSQL regressions passed:", ", ".join(sorted(required)))
PY
  if [[ "$mode" == all ]]; then
    mkdir -p "$scratch/bin"
    go build -o "$scratch/bin/" ./cmd/...
    npm --prefix web ls --all >/dev/null
    npm --prefix web run typecheck
    for suite in bootstrap-browser resources-browser roles-browser; do
      bash scripts/deskrealm-m1-test "$suite"
    done
  fi
  exit 0
fi

export DESKREALM_DATABASE_URL="$DESKREALM_TEST_DATABASE_URL"
export DESKREALM_MIGRATION_DATABASE_URL="$DESKREALM_TEST_DATABASE_URL"
unset DESKREALM_OIDC_ISSUER DESKREALM_OIDC_CLIENT_ID DESKREALM_OIDC_CLIENT_SECRET
unset DESKREALM_SESSION_SIGNING_KEY_FILE DESKREALM_SESSION_SIGNING_KID
unset DESKREALM_MANAGED_RENDEZVOUS_TOKEN DESKREALM_MANAGED_RELAY_ID DESKREALM_MANAGED_RELAY_TOKEN
export DESKREALM_DEV_HTTP=1
export DESKREALM_TOTP_KEY
DESKREALM_TOTP_KEY=$(openssl rand -base64 32)
export DESKREALM_WEB_DIR="$PWD/web/dist"
server_port=$(python3 - <<'PY'
import socket
with socket.socket() as listener:
    listener.bind(("127.0.0.1", 0))
    print(listener.getsockname()[1])
PY
)
export DESKREALM_HTTP_ADDR="127.0.0.1:$server_port"
export DESKREALM_PUBLIC_ORIGIN="http://$DESKREALM_HTTP_ADDR"
export DESKREALM_BROWSER_BASE="$DESKREALM_PUBLIC_ORIGIN"

npm --prefix web run build
go build -o "$scratch/deskrealm" ./cmd/deskrealm
"$scratch/deskrealm" migrate
if [[ "$mode" == managed-browser ]]; then
  export DESKREALM_BROWSER_DB_CONTAINER="$container"
fi
if [[ "$mode" == resources-browser || "$mode" == roles-browser ]]; then
  docker exec -i "$container" psql -X --set ON_ERROR_STOP=1 --dbname deskrealm --username postgres >/dev/null <<'SQL'
CREATE SEQUENCE browser_import_attempt;
CREATE FUNCTION fail_first_browser_import() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
    IF NEW.username = 'browser-retry-account' AND nextval('browser_import_attempt') = 1 THEN
        RAISE check_violation USING MESSAGE = 'browser fixture: fail first account import';
    END IF;
    RETURN NEW;
END
$$;
CREATE TRIGGER browser_import_fixture BEFORE INSERT ON users
FOR EACH ROW EXECUTE FUNCTION fail_first_browser_import();
SQL
fi
export DESKREALM_BROWSER_TICKET
DESKREALM_BROWSER_TICKET=$("$scratch/deskrealm" bootstrap-ticket)
"$scratch/deskrealm" serve >"$scratch/server.log" 2>&1 &
server=$!
ready=
for ((i=0; i<50; i++)); do
  if curl --fail --silent --noproxy '*' "$DESKREALM_PUBLIC_ORIGIN/v1/bootstrap/status" >/dev/null; then
    ready=1
    break
  fi
  sleep 0.2
done
if [[ -z "$ready" ]]; then
  cat "$scratch/server.log" >&2
  exit 1
fi
export DESKREALM_BROWSER_OUTPUT="$scratch/playwright"
export DESKREALM_BROWSER_REPORT="$scratch/browser.json"
npm --prefix web run "test:$browser_suite"
python3 - "$DESKREALM_BROWSER_REPORT" "$browser_suite.spec.ts" "$browser_test" <<'PY'
import json
import sys

with open(sys.argv[1]) as log:
    report = json.load(log)

def specs(suites):
    for suite in suites:
        yield from suite.get("specs", [])
        yield from specs(suite.get("suites", []))

found = []
for spec in specs(report["suites"]):
    if not spec["tests"] or any(
        test["expectedStatus"] != "passed" or not test["results"]
        or any(run["status"] != "passed" for run in test["results"])
        for test in spec["tests"]
    ):
        sys.exit(f"browser regression did not pass: {spec['title']}")
    if spec["file"] == sys.argv[2] and spec["title"] == sys.argv[3]:
        found.append(spec)
if len(found) != 1:
    sys.exit(f"required browser regression missing or duplicated: {sys.argv[3]}")
PY
