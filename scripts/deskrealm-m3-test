#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
case "${1:-}" in
  center-restore)
    DESKREALM_TEST_CENTER_BACKUP=1 go test -race -count=1 -v ./internal/m3/install -run '^(TestCenterBackupRestoresOriginalCluster|TestRecoveryRejectsDifferentManifestDigest|TestRecoveryRejectsArchiveChanges)$'
    exit
    ;;
  windows-installer)
    go test -race ./internal/windowssetup
    exec env DESKREALM_REQUIRE_OSSLSIGNCODE=1 python3 -B -m unittest discover -v -s managed/tests -p windows_installer_test.py
    ;;
  managed-release)
    exec env GOFLAGS="${GOFLAGS:-} -race" bash scripts/deskrealm-m1-test windows-release
    ;;
  signed-build)
    python3 -B -m unittest discover -v -s managed/tests -p windows_build_test.py
    python3 -B -m unittest discover -v -s managed/tests -p windows_package_test.py
    exec env GOFLAGS="${GOFLAGS:-} -race" bash scripts/deskrealm-m1-test windows-delivery
    ;;
  multi-relay)
    bash scripts/deskrealm-m3-test relay-selection
    exec python3 -B managed/tests/relay_enrollment.py --multi-relay
    ;;
  relay-selection)
    GOFLAGS="${GOFLAGS:-} -race" bash scripts/deskrealm-m1-test relay-selection
    exec bash scripts/deskrealm-m2-test vectors
    ;;
  relay-probes)
    go test -race -count=1 ./internal/m3/install -run '^TestRenderComposeForRelayIngress$'
    GOFLAGS="${GOFLAGS:-} -race" bash scripts/deskrealm-m1-test relay-probes
    bash scripts/deskrealm-m2-test vectors
    exec python3 -B managed/tests/relay_enrollment.py --client-probes
    ;;
  relay-lifecycle)
    npm --prefix web run build
    exec env DESKREALM_RELAY_BROWSER=1 GOFLAGS="${GOFLAGS:-} -race" bash scripts/deskrealm-m1-test relay-lifecycle
    ;;
  relay-enrollment)
    exec python3 -B managed/tests/relay_enrollment.py
    ;;
  relay-host)
    scratch=$(mktemp -d "${TMPDIR:-/tmp}/deskrealm-relay.XXXXXX")
    trap 'rm -rf "$scratch"' EXIT
    go build -o "$scratch/deskrealm-relay" ./cmd/deskrealm-relay
    DESKREALM_RELAY_TEST_BINARY="$scratch/deskrealm-relay" GOFLAGS="${GOFLAGS:-} -race" bash scripts/deskrealm-m1-test relay-host
    exit
    ;;
  relay-identity)
    exec env GOFLAGS="${GOFLAGS:-} -race" bash scripts/deskrealm-m1-test relay-identity
    ;;
  delivery-tasks)
    npm --prefix web run build
    DESKREALM_DELIVERY_BROWSER=1 GOFLAGS="${GOFLAGS:-} -race" bash scripts/deskrealm-m1-test delivery-tasks
    exit
    ;;
  install-task)
    GOFLAGS="${GOFLAGS:-} -race" bash scripts/deskrealm-m1-test install-task
    exec python3 -B managed/tests/center_install.py --install-task
    ;;
  install-bootstrap)
    exec python3 -B managed/tests/center_install.py "${@:2}"
    ;;
  install-preflight)
    required=(
      TestInstallConfigDefaultsAndCanonicalOrigins
      TestInstallConfigRejectsUnsafeValues
      TestInstallConfigFileRejectsUnknownAndExtraInput
      TestInstallPreflightChecksTLSFiles
      TestInstallPreflightRejectsRemoteDockerAndOccupiedPorts
    )
    ;;
  install-prepare)
    required=(
      TestPrepareDeploymentKeepsPrivateMaterialAndStableIdentity
      TestPrepareDeploymentRefusesIncompleteOrChangedState
      TestPrepareDeploymentConcurrent
      TestRenderComposeForProvidedTLS
    )
    ;;
  install-offline)
    required=(
      TestOfflineManifestBindsSignatureReferencesAndArchivePath
      TestOfflineImportVerifiesBytesAndLoadedImageIdentity
    )
    ;;
  install-resume)
    required=(
      TestRuntimePlanPinsSupportedHosts
      TestInstallRecordResumesWithStableTaskAndRedactedOutcome
      TestInstallRecordAdoptsLegacyAndRejectsLostRecord
    )
    ;;
  install-relay)
    required=(
      TestDefaultRelayPersistsPublicConfigurationAndPrivateCredential
      TestDefaultRelayChecksRunningConfigurationAndEndpoint
    )
    ;;
  *)
    echo "usage: $0 install-preflight|install-prepare|install-bootstrap|install-offline|install-resume|install-relay|install-task|delivery-tasks|relay-identity|relay-host|relay-enrollment|relay-lifecycle|relay-probes|relay-selection|multi-relay|signed-build|managed-release|windows-installer|center-restore" >&2
    exit 2
    ;;
esac

scratch=$(mktemp -d "${TMPDIR:-/tmp}/deskrealm-m3.XXXXXX")
trap 'rm -rf "$scratch"' EXIT
results="$scratch/results.json"
pattern=$(IFS='|'; echo "${required[*]}")
if ! go test -json -race -count=1 ./internal/m3/install -run "^($pattern)$" >"$results"; then
  cat "$results" >&2
  exit 1
fi
python3 - "$results" "${required[@]}" <<'PY'
import json
import sys

with open(sys.argv[1]) as log:
    events = [json.loads(line) for line in log]
required = set(sys.argv[2:])
passed = {entry.get("Test") for entry in events if entry.get("Action") == "pass"}
skipped = {entry["Test"] for entry in events if entry.get("Action") == "skip" and "Test" in entry}
if required - passed or skipped:
    sys.exit(f"missing or skipped installation regressions: {sorted((required - passed) | skipped)}")
print("Required installation regressions passed:", ", ".join(sorted(required)))
PY

go build -o "$scratch/deskrealm-install" ./cmd/deskrealm-install
"$scratch/deskrealm-install" --help
if [[ "$1" == install-offline ]]; then
  python3 -B managed/tests/center_install.py --offline
elif [[ "$1" == install-resume ]]; then
  python3 -B managed/tests/center_install.py
elif [[ "$1" == install-relay ]]; then
  python3 -B managed/tests/center_install.py --default-relay
fi
